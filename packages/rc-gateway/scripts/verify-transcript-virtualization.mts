  PAGE_SCENARIOS.push({
    name: 'P122 a rename the daemon answered with no name does not read as titled',
    waitView: false,
    run: async ({ page, viewer }) => {
      await page.route(/\/session\/[^/]+\/metadata$/, async (route) => {
        await route.fulfill({
          status: 200,
