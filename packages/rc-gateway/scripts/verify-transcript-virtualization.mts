interface PageRun {
  viewer: Viewer;
  page: Page;
  consoleErrors: string[];
}
type PageScenario =
  | {
      name: string;
      /** Stub frames (default READY); the stream is held open. */
      frames?: () => Frame[];
      /** Stub behaviour: a slow turn, one it refuses, or the page it stores. */
      stub?: {
        promptStatus?: number;
        promptDelayMs?: number;
        transcriptPage?: unknown;
        /**
         * Status the stub answers a permission vote with, so a scenario can
         * drive a vote the daemon refuses.
         */
        permissionStatus?: number;
        /**
         * Body for GET /session/:id/status. A card scenario lists its request
         * here, because the stub's default reports nothing pending and the
         * page's 5s sweep would retire the card before the scenario votes.
         */
        sessionStatus?: unknown;
        /**
         * Daemon feature tags the stub advertises. The page hides a whole
         * panel behind some of these tags, so a scenario that drives such a
         * panel has to advertise the tag it depends on, or it is asserting
         * against markup that never becomes visible.
         */
        capabilitiesFeatures?: string[];
        /**
         * Status the stub answers GET /session/:id/export with, so a scenario
         * can drive the refusal note the page writes from the response body.
         */
        exportStatusCode?: number;
        /**
         * Status the stub answers POST /session/:id/attachments with, so a
         * scenario can drive the attach note the page writes from the response
         * body. Pair it with `attachmentUploadErrorBody`: the stub's own
         * default says `stub error`, which no real daemon ever sends.
         */
        attachmentUploadStatus?: number;
        /** Body the stub answers a refused upload with. */
        attachmentUploadErrorBody?: unknown;
        /** Body the stub answers the stored-attachment list with. */
        attachmentListResult?: unknown;
        /** Status the stub answers the stored-attachment list with. */
        attachmentListStatus?: number;
        /**
         * Status the stub answers GET /session/:id/stats with, so a scenario
         * can drive the failure row. Pair it with `statsResult` when the point
         * is the reason code, since the stub's own default body says
         * `stub error`, which no real daemon ever sends.
         */
        statsStatusCode?: number;
        /**
         * Body the stub answers GET /session/:id/stats with. A scenario that
         * asserts a printed number, or asserts that an absent optional block
         * draws nothing, has to supply the payload it expects, or it is
         * checking a roll-up the stub invented.
         */
        statsResult?: unknown;
        /**
         * Body the stub answers GET /session/:id/resources with. A scenario
         * that asserts a drawn row, or that an unknown skill level or MCP
         * status still reaches the page under the daemon's own word, has to
         * supply its own payload, or it is checking the two names the stub
         * invented.
         */
        resourcesResult?: unknown;
        /** Status the stub answers GET /session/:id/resources with. */
        resourcesStatusCode?: number;
        /**
         * Body the stub answers GET /workspace/permissions with. A scenario that
         * asserts a drawn rule chip has to supply its own settings object, or it
         * is checking the rules this file invented. The shape matters as much as
         * the contents: the page reads `permRules[scope].rules[type]`, so a
         * payload that carries flat arrays instead of the daemon's
         * { path, rules } objects makes the panel throw and the scenario then
         * asserts against a box no reader can see.
         */
        workspacePermissionsResult?: unknown;
        /** Status the stub answers GET /workspace/permissions with. */
        workspacePermissionsStatus?: number;
        /**
         * Body the stub answers GET /workspace/env with. A scenario that
         * asserts a drawn environment cell has to name that cell itself: left
         * unset the stub serves its own default fixture, and the assertion would
         * be checking this file's invention rather than the page's reading.
         */
        workspaceEnvResult?: unknown;
        /** Status the stub answers GET /workspace/env with. */
        workspaceEnvStatus?: number;
        /** Body the stub answers GET /workspace/preflight with. */
        workspacePreflightResult?: unknown;
        /** Status the stub answers GET /workspace/preflight with. */
        workspacePreflightStatus?: number;
        /** Body the stub answers GET /workspace/skills with. */
        workspaceSkillsResult?: unknown;
        /** Status the stub answers GET /workspace/skills with. */
        workspaceSkillsStatus?: number;
        /** Body the stub answers GET /workspace/providers with. */
        workspaceProvidersResult?: unknown;
        /** Status the stub answers GET /workspace/providers with. */
        workspaceProvidersStatus?: number;
        /** Body the stub answers GET /workspace/hooks with. */
        workspaceHooksResult?: unknown;
        /** Status the stub answers GET /workspace/hooks with. */
        workspaceHooksStatus?: number;
        /** Body the stub answers GET /workspace/memory with. */
        workspaceMemoryResult?: unknown;
        /** Status the stub answers GET /workspace/memory with. */
        workspaceMemoryStatus?: number;
        /** Body the stub answers GET /workspace/agents with. */
        workspaceAgentsResult?: unknown;
        /** Status the stub answers GET /workspace/agents with. */
        workspaceAgentsStatus?: number;
        /**
         * Body the stub answers GET /session/:id/artifacts with. A scenario
