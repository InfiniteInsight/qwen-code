  // @@NEXT-P-SCENARIO@@
}

// #199. A prompt that fails ends in turn_error, which the daemon sends INSTEAD
// of turn_complete, and the page had no case for it: the thinking row, the
// timer and Stop stayed on a turn that had stopped. The frame is the shape the
// fork's fixture captured (two-client-turn.fixture.ts, turnError()).
{
  const TURN_ERROR = {
    type: 'turn_error',
    id: 900,
    data: {
      sessionId: 'stub',
      message: 'terminated',
      errorKind: 'model_stream_interrupted',
      promptId: 'prompt-199',
    },
    originatorClientId: 'someone-else',
  };
  const ERROR_TEXT =
    'The reply stopped: the connection to the model was lost (terminated).';
  const turnState = (page: Page) =>
    page.evaluate(() => {
      const items = transcriptModel.items as Array<{ kind: string; text?: string; err?: boolean }>;
      const stop = document.getElementById('cancel-turn') as HTMLElement;
      const send = document.getElementById('send') as HTMLElement;
      return {
        processing: items.filter((i) => i.kind === 'processing').length,
        errors: items.filter((i) => i.kind === 'system' && i.err).map((i) => i.text),
        asst: items.filter((i) => i.kind === 'asst').map((i) => i.text),
        running: turnOpen,
        clock: runClock !== null,
        stopShown: !stop.hidden && stop.getClientRects().length > 0,
        sendShown: !send.hidden && send.getClientRects().length > 0,
        sendDisabled: (document.getElementById('send') as HTMLButtonElement).disabled,
        state: document.getElementById('h1-status')?.getAttribute('data-state') ?? '',
        word: document.getElementById('h1-state')?.textContent ?? '',
        domErrors: Array.from(document.querySelectorAll('#transcript .system.err')).map((e) => e.textContent),
      };
    });
  PAGE_SCENARIOS.push({
    name: 'P210 a turn this window only watches that ends in turn_error keeps its reply, adds one error row saying why, and drops the thinking row, the timer and Stop for Send',
    noConsoleErrors: true,
    frames: () =>
      new Frames()
        .user('write me a long story')
        .thought('planning the story. ')
        .asst('Once upon a time there was').list,
    run: async ({ page, viewer }) => {
      await watch(page, viewer.sessionId);
      await waitForFrame(page, 3, 30_000);
      const beat = await page.evaluate(() => PROCESSING_QUIET_MS);
      // The turn is running and quiet: the thinking row is back and Stop has
      // taken Send's place. That is the state the missing case left behind.
      await page.waitForFunction(
        () => (transcriptModel.items as Array<{ kind: string }>).some((i) => i.kind === 'processing'),
        null,
        { timeout: beat + 5_000 },
      );
      const before = await turnState(page);
      expect(
        before.processing === 1 && before.running && before.clock && before.stopShown && !before.sendShown && before.state === 'run',
        `the watched turn is not in the running state this scenario starts from: ${JSON.stringify(before)}`,
      );

      await page.evaluate((f) => renderFrame(f), TURN_ERROR);
      await settlePage(page);
      // Past one quiet beat, so a thinking row that came back would be seen.
      await page.waitForTimeout(beat + 600);
      const after = await turnState(page);
      expect(after.processing === 0, `${after.processing} thinking rows after the turn failed`);
      expect(
        after.errors.length === 1 && after.errors[0] === ERROR_TEXT && after.domErrors.length === 1,
        `error rows ${JSON.stringify(after.errors)}, on screen ${JSON.stringify(after.domErrors)}`,
      );
      expect(
        after.asst.length === 1 && after.asst[0] === 'Once upon a time there was',
        `the reply so far is ${JSON.stringify(after.asst)}`,
      );
      expect(!after.running && !after.clock, `the turn still counts as running (turnOpen ${after.running}, clock ${after.clock})`);
      expect(
        after.sendShown && !after.stopShown && !after.sendDisabled,
        `Stop ${after.stopShown} Send ${after.sendShown} disabled ${after.sendDisabled}`,
      );
      expect(after.state === 'idle' && after.word === 'idle', `the status line reads ${after.state} / ${JSON.stringify(after.word)}`);

      // The same frame again (a replay that overlaps the live stream) adds no
      // second row.
      await page.evaluate((f) => renderFrame(f), TURN_ERROR);
      await settlePage(page);
      const again = await turnState(page);
      expect(again.errors.length === 1 && again.processing === 0, `a repeat of the frame left ${again.errors.length} error rows`);
      return `reply kept, 1 error row (${JSON.stringify(ERROR_TEXT)}), thinking row 1 -> 0, Stop -> Send, status run -> idle, repeat frame adds none`;
    },
  });
  PAGE_SCENARIOS.push({
    name: 'P211 a prompt this window sent that ends in turn_error frees Send and the status line, shows one error row, and the refused request that follows adds no second row',
    noConsoleErrors: true,
    // The request is held for 1.5 s and then answered 500, as a daemon that
    // failed the turn answers it. The frame arrives while Send is still held.
    stub: { promptDelayMs: 1_500, promptStatus: 500 },
    run: async ({ page, viewer }) => {
      await watch(page, viewer.sessionId);
      await page.waitForSelector('#composer', { state: 'visible' });
      await page.evaluate(() => {
        (document.getElementById('prompt') as HTMLTextAreaElement).value = 'tell me a story';
        (document.getElementById('send') as HTMLButtonElement).click();
      });
      await page.waitForFunction(() => abandonPendingSend !== null);
      const held = await turnState(page);
      expect(
        held.running && held.stopShown && held.processing === 1,
        `the sent turn is not running when the failure arrives: ${JSON.stringify(held)}`,
      );

      // The daemon echoes the prompt, streams a little, then fails the turn.
      await page.evaluate((f) => {
        renderFrame({
          type: 'session_update',
          data: { update: { sessionUpdate: 'user_message_chunk', content: { text: 'tell me a story' } } },
        });
        renderFrame({
          type: 'session_update',
          data: { update: { sessionUpdate: 'agent_message_chunk', content: { text: 'It began' } } },
        });
        renderFrame(f);
      }, { ...TURN_ERROR, originatorClientId: 'this-window' });
      await page.waitForFunction(() => abandonPendingSend === null, null, { timeout: 5_000 });
      await settlePage(page);
      const freed = await turnState(page);
      expect(
        freed.sendShown && !freed.sendDisabled && !freed.stopShown,
        `Send is still held after the failure: Stop ${freed.stopShown} Send ${freed.sendShown} disabled ${freed.sendDisabled}`,
      );
      expect(freed.processing === 0 && !freed.running && !freed.clock, `thinking ${freed.processing}, running ${freed.running}, clock ${freed.clock}`);
      expect(freed.state === 'idle', `the status line reads ${freed.state}`);
      expect(
        freed.errors.length === 1 && freed.errors[0] === ERROR_TEXT && freed.asst.join() === 'It began',
        `rows after the failure: errors ${JSON.stringify(freed.errors)}, reply ${JSON.stringify(freed.asst)}`,
      );

      // Let the held request come back refused, then repeat the frame: the
      // failure was drawn once and stays drawn once.
      await page.waitForTimeout(2_000);
      await page.evaluate((f) => renderFrame(f), TURN_ERROR);
      await settlePage(page);
      const end = await turnState(page);
      expect(end.errors.length === 1 && end.domErrors.length === 1, `after the request settled: ${JSON.stringify(end.errors)}`);
      expect(end.sendShown && !end.sendDisabled && end.state === 'idle', `Send/status after the request settled: ${JSON.stringify({ s: end.sendShown, d: end.sendDisabled, st: end.state })}`);
      return `own prompt held (Stop, 1 thinking row) -> turn_error -> Send free, status idle, 1 error row; refused request and repeat frame add none`;
    },
  });
}

/** Parses `rgb(r, g, b)` / `rgba(r, g, b, a)` into channels. */
function pgParseRgb(css: string): { r: number; g: number; b: number; a: number } | null {
  const m = /^rgba?\(([^)]+)\)$/.exec(css.trim());
  if (m === null) return null;
  const parts = m[1]!.split(/[,/\s]+/).filter((x) => x !== '').map(Number);
  if (parts.length < 3 || parts.some((n) => Number.isNaN(n))) return null;
  return { r: parts[0]!, g: parts[1]!, b: parts[2]!, a: parts.length > 3 ? parts[3]! : 1 };
}

/** WCAG contrast ratio between two opaque colours. */
function pgContrast(
  ink: { r: number; g: number; b: number; a: number },
  back: { r: number; g: number; b: number; a: number },
): number {
  const lum = (c: { r: number; g: number; b: number }): number => {
    const ch = (v: number): number =>
      v / 255 <= 0.03928 ? v / 255 / 12.92 : ((v / 255 + 0.055) / 1.055) ** 2.4;
    return 0.2126 * ch(c.r) + 0.7152 * ch(c.g) + 0.0722 * ch(c.b);
  };
  const a = lum(ink);
  const b = lum(back);
  return (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05);
}
type PgRgba = { r: number; g: number; b: number; a: number };
/** WCAG relative luminance of a colour's channels, alpha ignored. */
function pgLuminance(c: PgRgba): number {
  const ch = (v: number): number =>
    v / 255 <= 0.03928 ? v / 255 / 12.92 : ((v / 255 + 0.055) / 1.055) ** 2.4;
  return 0.2126 * ch(c.r) + 0.7152 * ch(c.g) + 0.0722 * ch(c.b);
}
/** Source-over of one colour on another, non-premultiplied. */
function pgOver(top: PgRgba, bottom: PgRgba): PgRgba {
  const a = top.a + bottom.a * (1 - top.a);
  if (a === 0) return { r: 0, g: 0, b: 0, a: 0 };
  const mix = (t: number, u: number): number => (t * top.a + u * bottom.a * (1 - top.a)) / a;
  return { r: mix(top.r, bottom.r), g: mix(top.g, bottom.g), b: mix(top.b, bottom.b), a };
}
/**
 * #177. The pixel a text-bearing element paints and the pixel beside it,
 * composited the way the browser does: each element's ground goes under what
 * it holds, each opacity fades its whole layer, and the root lands on a white
 * canvas. Reading the first painted ground and the raw ink, as P126 did before,
 * takes a 0.6-opacity caption or a disabled button at full strength, and a
 * translucent help panel as if it were the band under it.
 */
function pgPainted(color: string, chain: [string, string][]): { ink: PgRgba; ground: PgRgba } {
  const clear: PgRgba = { r: 0, g: 0, b: 0, a: 0 };
  const paint = (withInk: boolean): PgRgba => {
    let layer = clear;
    chain.forEach(([bg, opacity], i) => {
      const ground = pgParseRgb(bg) ?? clear;
      layer = i === 0 ? ground : pgOver(layer, ground);
      if (i === 0 && withInk) layer = pgOver(pgParseRgb(color) ?? clear, layer);
      layer = { ...layer, a: layer.a * Number(opacity) };
    });
    return pgOver(layer, { r: 255, g: 255, b: 255, a: 1 });
  };
  return { ink: paint(true), ground: paint(false) };
}
/**
 * #177. The floor a row is held to, then the check. Text 14px and up is body
 * text here (16px controls and prose, the transcript's 15.2px bubbles) and
 * takes 4.5:1. Under 14px is the sheet's label tier: it draws its 9 to 12px
 * labels in #6e7681, 3.99:1 on its band, so 3:1 is the floor it holds there.
 * A disabled control takes 3:1 at any size: WCAG exempts inactive controls,
 * but this page dims them with opacity, and a dim one still has to read as a
 * control rather than as a blank.
 */
function pgShellCheck(
  row: { kind: string; color: string; size: number; disabled: boolean; chain: [string, string][] },
  at: string,
): number {
  expect(pgParseRgb(row.color) !== null, `${row.kind} at ${at} reports an unparsable colour ${row.color}`);
  const { ink, ground } = pgPainted(row.color, row.chain);
  const ratio = pgContrast(ink, ground);
  const floor = row.disabled || row.size < 14 ? 3 : 4.5;
  const hex = (c: PgRgba): string =>
    '#' + [c.r, c.g, c.b].map((v) => Math.round(v).toString(16).padStart(2, '0')).join('');
  expect(
    ratio >= floor,
    `${row.kind} at ${at} paints ${hex(ink)} on ${hex(ground)} (${row.color}, ${row.size}px${row.disabled ? ', disabled' : ''}) = ${ratio.toFixed(2)}:1, under its ${floor}:1 floor`,
  );
  return ratio;
}
async function runPageScenario(
  s: Exclude<PageScenario, { standalone: () => Promise<string> }>,
): Promise<string> {
  const viewer = await bootViewer({
    frames: s.frames ? s.frames() : READY,
    holdOpenMs: 600_000,
    promptStatus: s.stub?.promptStatus,
    promptDelayMs: s.stub?.promptDelayMs,
    transcriptPage: s.stub?.transcriptPage,
    // A card scenario needs both: the status body that keeps its request
    // listed as pending, and the status the vote is answered with.
    permissionStatus: s.stub?.permissionStatus,
    sessionStatus: s.stub?.sessionStatus,
    capabilitiesFeatures: s.stub?.capabilitiesFeatures,
    exportStatusCode: s.stub?.exportStatusCode,
    attachmentUploadStatus: s.stub?.attachmentUploadStatus,
    attachmentUploadErrorBody: s.stub?.attachmentUploadErrorBody,
    attachmentListResult: s.stub?.attachmentListResult,
    attachmentListStatus: s.stub?.attachmentListStatus,
    statsStatusCode: s.stub?.statsStatusCode,
    statsResult: s.stub?.statsResult,
    resourcesResult: s.stub?.resourcesResult,
    resourcesStatusCode: s.stub?.resourcesStatusCode,
    workspacePermissionsResult: s.stub?.workspacePermissionsResult,
    workspacePermissionsStatus: s.stub?.workspacePermissionsStatus,
    workspaceEnvResult: s.stub?.workspaceEnvResult,
    workspaceEnvStatus: s.stub?.workspaceEnvStatus,
    workspacePreflightResult: s.stub?.workspacePreflightResult,
    workspacePreflightStatus: s.stub?.workspacePreflightStatus,
    workspaceSkillsResult: s.stub?.workspaceSkillsResult,
    workspaceSkillsStatus: s.stub?.workspaceSkillsStatus,
    workspaceProvidersResult: s.stub?.workspaceProvidersResult,
    workspaceProvidersStatus: s.stub?.workspaceProvidersStatus,
    workspaceHooksResult: s.stub?.workspaceHooksResult,
    workspaceHooksStatus: s.stub?.workspaceHooksStatus,
    workspaceMemoryResult: s.stub?.workspaceMemoryResult,
    workspaceMemoryStatus: s.stub?.workspaceMemoryStatus,
    workspaceAgentsResult: s.stub?.workspaceAgentsResult,
    workspaceAgentsStatus: s.stub?.workspaceAgentsStatus,
    artifactListResult: s.stub?.artifactListResult,
    artifactListStatus: s.stub?.artifactListStatus,
    artifactContentStatus: s.stub?.artifactContentStatus,
    turnIndexPage: s.stub?.turnIndexPage,
    turnIndexStatusCode: s.stub?.turnIndexStatusCode,
    hostActions: s.stub?.hostActions,
    pool: s.stub?.pool,
  });
  const { page, url } = viewer;
  const consoleErrors: string[] = [];
  const pageErrors: string[] = [];
  page.on('pageerror', (e) => pageErrors.push(e.message));
  page.on('console', (m) => {
    if (m.type() !== 'error') return;
    const where = m.location().url;
    // Best-effort endpoints the page tolerates (permission overlays, the
    // clients manifest, lineage) answer 404 in the harness, and the browser
    // logs each as an error. Only a failed transcript asset counts.
    if (
      m.text().startsWith('Failed to load resource') &&
      !TRANSCRIPT_ASSET.test(where)
    ) {
      return;
    }
    consoleErrors.push(`${m.text()} @ ${where}`);
  });
  page.on('dialog', (d) => void d.dismiss());
  try {
    // #189 (h1): the phone is the primary set, so a scenario that sets no
    // size reads the page as a phone loads it. Set here, once, before the
    // load, rather than left to the browser's 1280x720, which since #188 is
    // the laptop layout and was what every unsized scenario used to read.
    await page.setViewportSize(PHONE);
    await page.addInitScript({ content: PAGE_HELPERS_JS });
    if (s.keyboard) await page.addInitScript({ content: KEYBOARD_JS });
    if (s.before) await s.before(page);
    await page.goto(`${url}/ui/`, { waitUntil: 'domcontentloaded' });
    await page.waitForFunction(() => typeof startWatch === 'function');
    if (s.waitView !== false) {
      await waitView(page);
      await page.waitForSelector('#transcript', { state: 'visible' });
    }
    const detail = await s.run({ viewer, page, consoleErrors });
    expect(
      pageErrors.length === 0,
      `uncaught page errors: ${pageErrors.join(' | ')}`,
    );
    if (s.noConsoleErrors) {
      expect(
        consoleErrors.length === 0,
        `console errors: ${consoleErrors.join(' | ')}`,
      );
    }
    return detail;
  } catch (err) {
    const msg = err instanceof Error ? err.message : String(err);
    const extra = pageErrors.length
      ? ` [page errors: ${pageErrors.join(' | ')}]`
      : '';
    throw new Error(msg.split('\n')[0] + extra);
  } finally {
    await viewer.close();
  }
}

// Every page scenario boots its own gateway, stub (with its own frames) and
// browser, so the section's shared viewer is unused. `ONLY=P4` runs that
// scenario only (see selected()).
//
// Because that boot takes an ephemeral port, a private temp dir and a private
// browser, two scenarios share nothing, so the serial loop was leaving 23 of
// the 24 cores idle. `JOBS` sets how many run at once. It is not unbounded:
// each worker holds a gateway, a stub daemon and a Chromium, and the view
// section's scenarios wait on wall-clock settles, so a pool wide enough to
// starve the CPU turns green scenarios red for reasons that have nothing to do
// with the page under test.
const JOBS = Math.max(1, Math.floor(Number(process.env['JOBS'] ?? 4)) || 1);

// The elapsed time rides on the detail line because the only way to tell a
// pool that is working from one that is queueing is to see which scenarios are
// the long poles, and nothing else in this file records a duration.
async function runOnePageScenario(s: PageScenario): Promise<Result> {
  const started = Date.now();
  const spent = () => ` (${((Date.now() - started) / 1000).toFixed(1)}s)`;
  try {
    const detail =
      'standalone' in s ? await s.standalone() : await runPageScenario(s);
    return { name: s.name, ok: true, detail: detail + spent() };
  } catch (err) {
    const msg = err instanceof Error ? err.message : String(err);
    return {
      name: s.name,
      ok: false,
      detail: msg.split('\n')[0]! + spent(),
    };
  }
}

async function runPageSection(): Promise<Result[]> {
  const queue = PAGE_SCENARIOS.filter((s) => selected(s.name));
  const results: Result[] = [];
  // Completion order rather than file order: a scenario that hangs for two
  // minutes must not hold up the line behind it, which is the whole point of
  // the pool. Every line names its own scenario, so the interleaving costs
  // nothing a grep cannot look past.
  let next = 0;
  const worker = async (): Promise<void> => {
    while (next < queue.length) {
      const s = queue[next++]!;
      const result = await runOnePageScenario(s);
      console.log(
        // The pre-commit dash guard enforces on added lines only, so the
        // literal in the view section's copy of this line stays as it is.
        `${result.ok ? 'PASS' : 'FAIL'} ${result.name} \u2014 ${result.detail}`,
      );
      results.push(result);
    }
  };
  await Promise.all(
    Array.from({ length: Math.min(JOBS, queue.length) }, () => worker()),
  );
  return results;
}

const SECTIONS: Record<string, (viewer: Viewer) => Promise<Result[]>> = {
  view: runViewSection,
  page: runPageSection,
};

async function main(): Promise<void> {
  const wanted = process.argv[2] ?? process.env['SECTION'] ?? 'all';
  const names = wanted === 'all' ? Object.keys(SECTIONS) : [wanted];
  for (const n of names) {
    if (!SECTIONS[n]) throw new Error(`unknown section ${n}`);
  }
  const results: Result[] = [];
  for (const n of names) {
    console.log(`== section ${n}`);
    const viewer = await bootViewer();
    try {
      results.push(...(await SECTIONS[n]!(viewer)));
    } finally {
      await viewer.close();
    }
  }
  const failed = results.filter((r) => !r.ok).length;
  console.log(`${results.length - failed} passed, ${failed} failed`);
  process.exit(failed ? 1 : 0);
}

main().catch((err) => {
  console.error(err);
  process.exit(1);
});
