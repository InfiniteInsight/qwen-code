        expect(value('dictation') === 'auto, auto-send off', `Dictation reads ${JSON.stringify(value('dictation'))}`);
        expect(value('diag') === 'ok', `Diagnostics reads ${JSON.stringify(value('diag'))} while the gateway answers`);
