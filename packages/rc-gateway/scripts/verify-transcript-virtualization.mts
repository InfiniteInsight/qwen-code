      await page.fill('#prompt', 'line\n'.repeat(3) + 'line');
      const four = await look();
      await page.fill('#prompt', 'line\n'.repeat(20) + 'line');
      const many = await look();
      await page.fill('#prompt', '');
      const back = await look();
      expect(
        four.fieldH > 44 && four.fieldH < 132 && many.fieldH === 132 && back.fieldH === 44,
        `the field did not grow and shrink with its text: 4 lines ${four.fieldH}px, 21 lines ${many.fieldH}px, empty ${back.fieldH}px`,
      );

      // A suggestion arrives: painted inside the field, behind the box, grey
      // italic, and only the first of the frame's three.
      await blur();
      await page.evaluate((sid) => {
        renderIdleGhost({ sessionId: sid, suggestions: ['first suggestion', 'second', 'third'] });
      }, viewer.sessionId);
      const withGhost = await look();
      expect(withGhost.ghostShown, 'the suggestion is not painted in the field');
      expect(withGhost.ghostText.startsWith('first suggestion'), `the ghost reads "${withGhost.ghostText}", so it is not the first suggestion`);
      expect(!withGhost.ghostText.includes('second'), 'the ghost carries more than one suggestion, which g1 forbids');
      expect(withGhost.ghostBehind, 'the ghost is not a layer behind the field, so it would sit on top of what is typed');
      expect(withGhost.ghostInside, 'the ghost is painted outside the field box rather than inside it');
      expect(
        withGhost.ghostItalic === 'italic' && withGhost.ghostColor === 'rgb(91, 100, 112)',
        `the ghost is ${withGhost.ghostColor} ${withGhost.ghostItalic}, not the grey italic the spec draws`,
      );
      expect(withGhost.useStyle === 'normal', `the use affordance is ${withGhost.useStyle}, so it does not read as an action`);

      // Any typed character removes it.
      await page.focus('#prompt');
      await page.keyboard.type('x');
      const typed = await look();
      expect(!typed.ghostShown, 'typing left the ghost painted under the text');

      // Emptying the box brings it back, and Tab accepts without sending.
      await page.evaluate(() => {
        const ta = document.getElementById('prompt') as HTMLTextAreaElement;
        ta.value = '';
        ta.dispatchEvent(new Event('input', { bubbles: true }));
      });
      const again = await look();
      expect(again.ghostShown, 'the suggestion did not return once the box was empty');
      const before = await page.evaluate(() => transcriptModel.items.length);
      await page.focus('#prompt');
      await page.keyboard.press('Tab');
      const accepted = await look();
      expect(!accepted.ghostShown, 'Tab did not take the suggestion, so the keyboard path is missing');
      const filled = await page.$eval('#prompt', (el) => (el as HTMLTextAreaElement).value);
      expect(filled === 'first suggestion', `Tab left "${filled}" in the box, so it did not fill the suggestion`);
      const after = await page.evaluate(() => transcriptModel.items.length);
      expect(after === before, `accepting a suggestion sent it: the model went from ${before} rows to ${after}`);

      return (
        lines.join('; ') +
        '; field grows 44 to 132; every verb id kept, Stop in the row; ghost paints behind the field, one of three; Tab fills without sending'
      );
    },
  });

  // #177. The dark shell restyled five surfaces, and two scenarios read them:
  // P126 for the ink on every band, P131 for the grounds themselves. Both open
  // each surface the same way, so the two readings are about the same page.
  // The occasional bands are forced on for the reading and put back after: the
  // load-earlier and jump pills only show with a long or scrolled transcript,
  // the crash banner only after a daemon crash, the help panels only when
  // asked for, and the capability-gated cards (permission rules, the workspace
  // panels) only when the daemon offers them. A band that is not on screen
  // measures nothing, so reading them as the stub leaves them would pass
  // without having looked. In-page code is a plain string throughout: the
  // transform rewrites a named arrow in a callback into a __name(...) call the
  // page does not define.
  // #184 (h1): the surfaces are the H1 shell's. The Chat screen is read with
  // its sheet and its tools open and a toast up, so every band it can show is
  // on screen; the ⋯ menu, the conversation list (a column at 1280, a screen
  // of its own at 390) and the More screen are read as surfaces of their own,
  // since each covers what is under it while it is open.
  // #187: the Operations, Settings and Diagnostics panes are gone; their
  // cards are on the panel screens More's rows open, and each of those
  // screens is read as a surface of its own, every card on it shown (the
  // capability-gated ones too), as the panes were.
  const PANEL_KEYS_ALL = [
    'rewind', 'fork', 'files', 'share', 'usage', 'queue', 'search',
    'perms', 'mcp', 'tools', 'trust', 'memory',
    'daemons', 'sessions', 'runs', 'bridges', 'diag',
    'notify', 'dictation', 'zone', 'devices', 'install',
  ] as const;
  type PanelSurface = `panel:${(typeof PANEL_KEYS_ALL)[number]}`;
  type ShellSurface =
    | 'chat'
    | 'menu'
    | 'list'
    | 'more'
    | 'picker'
    | 'archived'
    | PanelSurface;
  const PANEL_SURFACES = PANEL_KEYS_ALL.map((k) => `panel:${k}` as PanelSurface);
  const SHELL_SURFACES: ShellSurface[] = [
    'chat',
    'menu',
    'list',
    'more',
    'picker',
    'archived',
    ...PANEL_SURFACES,
  ];
  const panelOf = (s: ShellSurface): string | null =>
    s.startsWith('panel:') ? s.slice('panel:'.length) : null;
  const SHELL_ROOTS = {
    ...(Object.fromEntries(PANEL_SURFACES.map((s) => [s, ['#panel-screen']])) as Record<PanelSurface, string[]>),
    chat: [
      '#h1-bar',
      '#h1-statusline',
      '#h1-sheet',
      '#crash-banner',
      '#transcript-wrap',
      '#h1-tools',
      '#composer',
    ],
    menu: ['#h1-menu'],
    list: ['#list-screen'],
    more: ['#more-screen'],
    picker: ['#dir-picker'],
    archived: ['#archived-view'],
  } as Record<ShellSurface, string[]>;
  const openShellSurface = async (page: Page, s: ShellSurface): Promise<void> => {
    await openPanel(page, 'chat');
    if (s === 'chat') {
      await openSheet(page);
      await openTools(page);
      // The status toast is read with a line in it: it shows only while
      // fresh, and an empty one paints no ink to measure.
      await page.evaluate(String.raw`(() => {
        document.getElementById('load-earlier').hidden = false;
        document.getElementById('jump-bottom').hidden = false;
        showCrashBanner(false);
        const st = document.getElementById('status');
        st.dataset.shellRead = st.textContent;
        st.textContent = 'status line';
      })()`);
    } else if (s === 'menu') {
      await openMenu(page);
    } else if (s === 'list') {
      // #185: the List screen at every width, with its search field out so
      // the field is read too.
      await openList(page);
      if (!(await page.isVisible('#list-find'))) await page.click('#list-search');
    } else if (s === 'more') {
      await page.click('#h1-more');
    } else if (s === 'picker') {
      // #193: the folder screen is behind New conversation now; the folder
      // line opens the folder filter.
      await openList(page);
      await page.click('#list-new');
      await page.waitForFunction(`!document.getElementById('dir-picker').hidden`);
      await page.evaluate(`document.getElementById('help-dir-picker').hidden = false`);
    } else if (s === 'archived') {
      await openList(page);
      await page.click('#list-archived-open');
      await page.waitForFunction(`!document.getElementById('archived-view').hidden`);
      await page.evaluate(`document.getElementById('help-archived-view').hidden = false`);
    } else {
      const key = panelOf(s)!;
      await openPanel(page, key);
      await page.evaluate(String.raw`document.querySelectorAll('#panel-${key} .ops-card').forEach((d) => {
        if (d.hidden) {
          d.dataset.shellRead = 'hidden';
          d.hidden = false;
        }
      })`);
    }
  };
  const closeShellSurface = async (page: Page, s: ShellSurface): Promise<void> => {
    if (s === 'chat') {
      await page.evaluate(String.raw`(() => {
        document.getElementById('load-earlier').hidden = true;
        document.getElementById('jump-bottom').hidden = true;
        document.getElementById('crash-banner').hidden = true;
        const st = document.getElementById('status');
        st.textContent = st.dataset.shellRead || '';
        delete st.dataset.shellRead;
        st.classList.remove('fresh');
      })()`);
      await page.click('#h1-status');
      await page.click('#h1-plus');
    } else if (s === 'menu') {
      await page.keyboard.press('Escape');
    } else if (s === 'list') {
      await page.click('#list-search');
      await closeList(page);
    } else if (s === 'more') {
      await page.click('#more-back');
    } else if (s === 'picker' || s === 'archived') {
      const id = s === 'picker' ? 'dir-picker' : 'archived-view';
      await page.evaluate(`document.getElementById('help-${id}').hidden = true`);
      // Focus is inside the screen (opening it moves focus to its back
      // button, P128), so Escape shuts it the way a reader would.
      await page.keyboard.press('Escape');
      await page.waitForFunction(`document.getElementById('${id}').hidden`);
      await closeList(page);
    } else {
      await page.evaluate(String.raw`document.querySelectorAll('#panel-${panelOf(s)} .ops-card').forEach((d) => {
        if (d.dataset.shellRead === 'hidden') {
          d.hidden = true;
          delete d.dataset.shellRead;
        }
      })`);
      await openPanel(page, 'chat');
    }
  };
  // Every visible element under the roots that paints text of its own, with
  // what it takes to know what it paints: its ink, its size, whether it is a
  // disabled control, and the ground and opacity of every element from it to
  // the root. A form control's text is its value, or its placeholder while it
  // has none. The browser collects; Node does the arithmetic (pgPainted).
  // Rows carry no text, only tag, id and class: the folder panel lists the
  // host's $HOME, and a failure line must not print it.
  const SHELL_TEXT = String.raw`((roots) => {
    const out = [];
    const seen = new Set();
    const skip = ['checkbox', 'radio', 'file', 'hidden', 'range', 'color'];
    for (const sel of roots) {
      const root = document.querySelector(sel);
      if (!root || root.getClientRects().length === 0) continue;
      for (const e of [root, ...root.querySelectorAll('*')]) {
        if (seen.has(e)) continue;
        const tag = e.tagName.toLowerCase();
        if (tag === 'option' || tag === 'script' || tag === 'style') continue;
        const ctl = tag === 'select' || tag === 'textarea' || (tag === 'input' && !skip.includes(e.type));
        const own = Array.from(e.childNodes).some((x) => x.nodeType === 3 && (x.textContent || '').trim() !== '');
        const val = ctl && ((e.value || '') !== '' || (e.placeholder || '') !== '');
        if (!own && !val) continue;
        if (e.getClientRects().length === 0) continue;
        const cs = getComputedStyle(e);
        if (cs.visibility === 'hidden') continue;
        seen.add(e);
        const chain = [];
        for (let up = e; up; up = up.parentElement) {
          const s = getComputedStyle(up);
          chain.push([s.backgroundColor, s.opacity]);
        }
        const cls = typeof e.className === 'string' && e.className ? '.' + e.className.split(' ')[0] : '';
        out.push({
          root: sel,
          kind: tag + (e.id ? '#' + e.id : '') + cls,
          color: ctl && !own && (e.value || '') === '' ? getComputedStyle(e, '::placeholder').color : cs.color,
          size: parseFloat(cs.fontSize),
          disabled: !!e.closest(':disabled'),
          chain,
        });
      }
    }
    return out;
  })`;
  type ShellTextRow = {
    root: string;
    kind: string;
    color: string;
    size: number;
    disabled: boolean;
    chain: [string, string][];
  };
  const readShellText = (page: Page, roots: string[]) =>
    page.evaluate(`${SHELL_TEXT}(${JSON.stringify(roots)})`) as Promise<ShellTextRow[]>;

  PAGE_SCENARIOS.push({
    name: 'P126 every row that paints its own text is legible on the ground it sits on',
    // #121, g1 "Session and status regions". The shell leaves #transcript's
    // colour unnamed, which is only safe while every row kind names its own.
    // Measured per row instead of asserted in a comment, because the failure is
    // invisible in the source: #transcript sets background #111, so a row that
    // forgets to name a colour inherits the UA default black and computes
    // 1.11:1, which reads as an empty box rather than as a broken style.
    waitView: false,
    run: async ({ page, viewer }) => {
      await watch(page, viewer.sessionId);
      await page.waitForSelector('#composer', { state: 'visible' });
      await page.evaluate(() => {
        __pg.liveTurn('what is the plan', 'here is the plan', 'tc-1');
      });
      await settlePage(page);

      // The browser collects raw values and nothing else. Every arithmetic
      // happens here in Node, because a named helper declared inside evaluate
      // is rewritten into a __name(...) call that the page does not define.
      // #177: the transcript's rows are read by the same collector as every
      // band below, so a row and a band are held to one rule.
      const painted = await readShellText(page, ['#transcript']);
      // #184 (h1): the stack is the spec's chat screen: bar, status line,
      // sheet, transcript, to-do strip, tools, composer. The sheet, the strip
      // and the tools come and go, so all three are opened for the reading and
      // put back after; a hidden element reports a zero rect, which would sort
      // it to the top and read as a position it does not have.
      // #188: the stack is read at 390, the phone the spec draws. At 1280 the
      // sheet is the right-hand pane instead (read below), and the rest of the
      // stack keeps its order in the column.
      type Seen = {
        rows: number;
        strip: boolean;
        drawer: boolean;
        tabBar: boolean;
        stack: { k: string; top: number }[];
        sheet: number[];
        vw: number;
        vh: number;
      };
      const readStack = async (): Promise<Seen> => {
        await openSheet(page);
        await openTools(page);
        const got = (await page.evaluate(String.raw`(() => {
          const plan = document.getElementById('plan');
          const wasHidden = plan.hidden;
          plan.hidden = false;
          const ids = ['h1-bar', 'h1-statusline', 'h1-sheet', 'transcript', 'plan', 'h1-tools', 'composer'];
          const tops = ids.map((k) => ({
            k,
            top: Math.round(document.getElementById(k).getBoundingClientRect().top),
          }));
          plan.hidden = wasHidden;
          const sh = document.getElementById('h1-sheet').getBoundingClientRect();
          return {
            rows: transcriptModel.items.length,
            strip: document.getElementById('status-strip') !== null,
            drawer: document.getElementById('inspector') !== null,
            tabBar: document.getElementById('tab-bar') !== null,
            stack: tops,
            sheet: [sh.left, sh.top, sh.width, sh.height].map(Math.round),
            vw: innerWidth,
            vh: innerHeight,
          };
        })()`)) as Seen;
        await page.click('#h1-status');
        await page.click('#h1-plus');
        return got;
      };
      await page.setViewportSize({ width: 390, height: 844 });
      const seen = await readStack();
      await page.setViewportSize(LAPTOP);
      const wideSeen = await readStack();

      expect(
        seen.rows > 0,
        `the driven turn left ${seen.rows} rows in the model, so there is nothing to measure`,
      );
      expect(
        painted.length > 0,
        'no element in the transcript paints text of its own, so the guard measures nothing',
      );
      expect(
        !seen.strip && !seen.drawer && !seen.tabBar,
        `the retired slots returned (status-strip ${seen.strip}, inspector ${seen.drawer}, tab bar ${seen.tabBar})`,
      );

      // Sorted on the measured top, not on the order the ids were asked for.
      // Mapping over that list would echo the literal back and could never
      // fail, which is the exact shape of a guard that proves nothing.
      const order = [...seen.stack].sort((a, b) => a.top - b.top).map((t) => t.k);
      expect(
        order.join(' ') === 'h1-bar h1-statusline h1-sheet transcript plan h1-tools composer',
        `the column stack is ${seen.stack.map((t) => t.k + '@' + t.top).join(' ')} at 390, but the spec draws bar -> status line -> sheet -> transcript -> to-do strip -> tools -> composer`,
      );
      const wideOrder = [...wideSeen.stack]
        .filter((t) => t.k !== 'h1-sheet')
        .sort((a, b) => a.top - b.top)
        .map((t) => t.k);
      expect(
        wideOrder.join(' ') === 'h1-bar h1-statusline transcript plan h1-tools composer',
        `the column stack is ${wideSeen.stack.map((t) => t.k + '@' + t.top).join(' ')} at 1280, out of the phone's order`,
      );
      const [sx, sy, sw, sh] = wideSeen.sheet as [number, number, number, number];
      expect(
        sx === wideSeen.vw - RIGHT_PANE && sy === 0 && sw === RIGHT_PANE && sh === wideSeen.vh,
        `the sheet is not the ${RIGHT_PANE}px right-hand pane at 1280 (${sw}x${sh} at ${sx},${sy})`,
      );

      const worst = { kind: '', ratio: 99 };
      for (const row of painted) {
        const ratio = pgShellCheck(row, '390x844 transcript');
        if (ratio < worst.ratio) {
          worst.kind = row.kind;
          worst.ratio = ratio;
        }
      }

      // The composer has to clear the fold at every width, which #121 asks for
      // by name. #184: the band that once pushed it out of reach was the
      // drawer; its successor is the sheet, so the three states read are the
      // sheet shut, open as the page draws it, and open with every row filled
      // past what the page draws (a long model name, a deep folder), each
      // with the tools open as well. The frame gives the composer its place,
      // so all three have to land on the fold. #189: the phones first, 390
      // then 360, then the laptop at its short and its usual height.
      const fold: {
        w: number;
        shut: number;
        open: number;
        filled: number;
        viewH: number;
      }[] = [];
      for (const [w, h] of [
        [390, 844],
        [360, 780],
        [1280, 720],
        [1280, 810],
      ]) {
        await page.setViewportSize({ width: w, height: h });
        const bottom = () =>
          page.evaluate(`Math.round(document.getElementById('composer').getBoundingClientRect().bottom)`) as Promise<number>;
        const shut = await bottom();
        await openSheet(page);
        await openTools(page);
        const open = await bottom();
        await page.evaluate(String.raw`(() => {
          const foot = document.getElementById('session-footer');
          window.__p126Sheet = foot.innerHTML;
          const extra = document.createElement('div');
          extra.style.whiteSpace = 'pre-line';
          extra.textContent = 'qwen3-coder-480b-a35b-instruct-awq-int4-long-context-preview\n' +
            '/home/evan/projects/qwen-code-remote/packages/rc-gateway/a/very/deep/folder\n'.repeat(6);
          foot.appendChild(extra);
        })()`);
        const filled = await bottom();
        await page.evaluate(String.raw`document.getElementById('session-footer').innerHTML = window.__p126Sheet`);
        await page.click('#h1-status');
        await page.click('#h1-plus');
        fold.push({ w, shut, open, filled, viewH: h });
      }
      for (const f of fold) {
        for (const k of ['shut', 'open', 'filled'] as const) {
          expect(
            f[k] <= f.viewH + 1,
            `with the sheet ${k} the composer bottom is ${f[k]} at ${f.w}px, in a ${f.viewH}px viewport`,
          );
        }
      }

      // #177. The transcript was the only ground this read, and it was the one
      // ground that was already dark. Every band the shell pass restyled is
      // read here at both widths the sheet draws: the bar, the rail, the status
      // line, the crash banner, the transcript with both pills on it, the
      // drawer, the composer with its help open, the New conversation panel
      // open with its help, and every Operations, Settings and Diagnostics card
      // opened with its help. #187: those cards are read on the panel screens
      // More's rows open, each screen with its opening sentence. Last in the
      // scenario on purpose, because it opens screens and panels, and the fold
      // readings above are about the resting page. #189: read at both phones
      // and then the laptop; a band that wraps or truncates at 360 can paint
      // a different element than it does at 390.
      const bands: string[] = [];
      let bandRows = 0;
      for (const [w, h] of [
        [390, 844],
        [360, 780],
        [1280, 810],
      ] as const) {
        await page.setViewportSize({ width: w, height: h });
        for (const s of SHELL_SURFACES) {
          await openShellSurface(page, s);
          const rows = await readShellText(page, SHELL_ROOTS[s]);
          await closeShellSurface(page, s);
          const at = `${w}x${h} ${s}`;
          // Each root has to have been read, or a band that failed to open
          // would pass by contributing nothing.
          for (const root of SHELL_ROOTS[s]) {
            expect(
              rows.some((r) => r.root === root),
              `nothing under ${root} painted text at ${at}, so the band was not on screen to be read`,
            );
          }
          let low = { kind: '', ratio: 99 };
          for (const row of rows) {
            const ratio = pgShellCheck(row, at);
            if (ratio < low.ratio) low = { kind: row.kind, ratio };
          }
          bandRows += rows.length;
          bands.push(`${at} ${low.kind} ${low.ratio.toFixed(2)}`);
        }
      }

      return (
        painted.length +
        ' transcript elements and ' +
        bandRows +
        ' band elements all at their floor (4.5:1 for text 14px and up, 3:1 under it or disabled), transcript worst ' +
        worst.kind +
        ' at ' +
        worst.ratio.toFixed(2) +
        ':1, worst per band [' +
        bands.join('; ') +
        ']; the retired status strip, inspector and tab bar stayed retired; the stack is bar, status line, sheet, transcript, strip, tools, composer at 390, and the same without the sheet at 1280, where the sheet is the right-hand pane; composer clears the fold at 390x844, 360x780, 1280x720 and 1280x810 with the sheet shut, open and filled, tools open (' +
        fold.map((f) => f.w + 'x' + f.viewH + ': ' + f.shut + '/' + f.open + '/' + f.filled).join(', ') +
        ')'
      );
    },
  });

  // #178. The harness booted the gateway without naming a runtime root, so
  // runtimeBaseDir() fell back to the host's ~/.qwen and the rail listed this
  // machine's own conversations (16 rows on the box this was written on, real
  // session titles in the run output). An empty-rail assertion is not a guard,
  // because it also passes on a host that has nothing to list. So plant a
  // transcript inside the harness root and require the rail to list exactly that
  // row: were the root the host's again, the plant would land where the route no
  // longer looks and the rows on screen would be the machine's own, which fails
  // both halves at once.
  // #185 (h1): the rows are the List screen's, and the planted one has to be
  // on that screen when the title opens it, not only in the DOM.
  PAGE_SCENARIOS.push({
    name: 'P127 the list reads the harness chats dir and not the host directory',
    run: async ({ page }) => {
      // The chain that makes this observable without anything being driven:
      // GET /rc/fs with no path defaults to $HOME, the folder browser renders
      // that, and renderDirList asks for that folder's conversations.
      await page.waitForFunction(() => curDirPath !== null);
      const landed = await page.evaluate(() => curDirPath);
      expect(
        typeof landed === 'string' && landed.length > 0,
        `the load path landed on no folder (${JSON.stringify(landed)}), so there is no folder to list conversations for and nothing below proves anything`,
      );
      const dir = landed as string;

      // Load-bearing on its own, and it runs before any write. The plant has to
      // go where the route will actually look, so if the harness ever stops
      // isolating this refuses rather than leaving a throwaway conversation in a
      // real person's history.
      const root = harnessRuntimeRoot();
      const chatsDir = resolveChatsDir(dir);
      expect(
        chatsDir === root || chatsDir.startsWith(root + '/'),
        `the chats dir the route scans for ${JSON.stringify(dir)} is ${chatsDir}, outside the harness root ${root}, so the harness is reading the host again`,
      );
      // Its own assertion, because the one above cannot carry this. An inherited
      // QWEN_RUNTIME_DIR that names the real ~/.qwen satisfies the containment
      // check above, and mutation-tested that is exactly where the plant landed.
      // So keeping a throwaway transcript out of a live history is a separate
      // claim and it runs before any write.
      const realHome = join(homedir(), '.qwen');
      expect(
        chatsDir !== realHome && !chatsDir.startsWith(realHome + '/'),
        `the chats dir ${chatsDir} sits inside the real user home ${realHome}, so planting a transcript here would write into a live history`,
      );

      const rows = () =>
        page.evaluate(
          String.raw`Array.from(document.querySelectorAll('#past-list .srow .tt')).map((t) => t.textContent || '')`,
        ) as Promise<string[]>;

      const CANARY = 'aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee';
      const TITLE = 'planted by P127';
      const planted = join(chatsDir, `${CANARY}.jsonl`);
      // Wait for the chain's own signal that a list landed. Reading the box
      // before that measures an empty box rather than an empty scan, which is
      // how the count below was found passing while the host was being read.
      await page.waitForFunction(() => pastConvosCwd !== null);
      const before = await rows();
      try {
        expect(
          before.length === 0,
          `a default load listed ${before.length} conversations for ${JSON.stringify(dir)} (${JSON.stringify(before.slice(0, 3))}), so the list is reading somewhere other than the harness root`,
        );

        mkdirSync(chatsDir, { recursive: true });
        writeFileSync(
          planted,
          JSON.stringify({
            type: 'system',
            subtype: 'custom_title',
            systemPayload: { customTitle: TITLE, titleSource: 'manual' },
          }) + '\n',
        );

        // The page's own read, not a private path into the renderer.
        await page.evaluate(([cwd]) => {
          curDirPath = cwd;
          return refreshPastConversations(cwd);
        }, [dir]);
        const after = await rows();
        expect(
          after.length === 1 && after[0] === TITLE,
          `a transcript planted in the harness root did not reach the list on its own (${JSON.stringify(after)})`,
        );
        // On the List screen, where a reader finds it: the title opens it and
        // the planted row is painted at its own spot.
        await openList(page);
        const onScreen = (await page.evaluate(String.raw`(() => {
          const row = document.querySelector('#past-list .s[data-session="${CANARY}"]');
          if (!row || row.getClientRects().length === 0) return false;
          const b = row.getBoundingClientRect();
          const at = document.elementFromPoint(b.left + 40, b.top + b.height / 2);
          return !!at && row.contains(at);
        })()`)) as boolean;
        expect(onScreen, 'the planted row is not on the List screen the title opens');
        await closeList(page);
      } finally {
        // The root is shared for the whole process, so the plant must not
        // outlive the scenario or a later one lists a row it never asked for.
        rmSync(planted, { force: true });
      }

      return `a default load listed nothing for ${JSON.stringify(dir)} rather than the host's conversations, then listed exactly the transcript planted in ${chatsDir.replace(root, '<root>')}, on the List screen the title opens`;
    },
  });

  // #175 (a), then #185 (h1), then #193. The New conversation panel was a
  // closed <details> heading the Chat column, then a panel behind the rail's
  // +, then a screen behind the List screen's `change`. #193 puts it behind
  // the list's New conversation: where a new conversation runs is chosen
  // there, and the folder line became the list's folder filter. The claims
  // kept: it costs nothing at rest, it opens only from its one door (now New
  // conversation, and not the folder line), everything it held is drawn when
  // it is open, focus goes into it and comes back to the door, and it never
  // pushes the page sideways. Pressed with real input, pointer and keyboard,
  // because the claims are reach, not that a handler exists.
  // In-page code is a plain string throughout: the transform rewrites a
  // named arrow in a callback into a __name(...) call the page does not
  // define.
  type PickerReading = {
    hidden: boolean;
    h: number;
    inChat: boolean;
    expanded: string | null;
    controls: string | null;
    focusInPanel: boolean;
    focusOn: string;
    missing: string;
    backOnTop: boolean;
    docW: number;
    vw: number;
    vh: number;
    top: number;
    w: number;
    panelRight: number;
    folderLine: string;
    lineControls: string | null;
    title: string;
  };
  const readPicker = (page: Page) =>
    page.evaluate(String.raw`(() => {
      const p = document.getElementById('dir-picker');
      const door = document.getElementById('list-new');
      const on = (el) => !!el && el.getClientRects().length > 0;
      const a = document.activeElement;
      const r = p.getBoundingClientRect();
      // The way back names the screen's exit, so it has to be what is
      // painted at its own spot, not merely laid out under the list.
      const bb = document.getElementById('dir-back').getBoundingClientRect();
      const hit = bb.height > 0 ? document.elementFromPoint(bb.left + bb.width / 2, bb.top + bb.height / 2) : null;
      return {
        hidden: p.hidden,
        h: Math.round(r.height),
        inChat: document.getElementById('pane-chat').contains(p),
        expanded: door.getAttribute('aria-expanded'),
        controls: door.getAttribute('aria-controls'),
        focusInPanel: p.contains(a),
        focusOn: a === door ? 'new' : a && a.id ? a.id : a ? a.tagName.toLowerCase() : '',
        // Everything the panel held apart from its past list, which is the
        // List screen's rows now.
        missing: ['dir-current', 'dir-list', 'dir-use', 'new-session-cwd', 'new-session', 'dir-recent']
          .filter((id) => !on(document.getElementById(id)))
          .join(','),
        backOnTop: !!hit && document.getElementById('dir-back').contains(hit),
        docW: document.documentElement.scrollWidth,
        vw: innerWidth,
        vh: innerHeight,
        top: Math.round(r.top),
        w: Math.round(r.width),
        panelRight: Math.round(r.right),
        folderLine: (document.getElementById('list-cwd').textContent || '').trim(),
        lineControls: document.getElementById('list-folder').getAttribute('aria-controls'),
        title: (p.querySelector('.ttl') || { textContent: '' }).textContent.trim(),
      };
    })()`) as Promise<PickerReading>;

  PAGE_SCENARIOS.push({
    name: 'P128 the folder screen costs nothing at rest and opens only from the list’s New conversation, as a screen of its own at 390 and over the list in its pane at 1280',
    waitView: false,
    run: async ({ page }) => {
      // A fresh load with nothing watched: the state where a new conversation
      // is most wanted. The list is fed by the load's own browse (P28).
      await page.waitForFunction('pastConvosCwd !== null');

      const rest = await readPicker(page);
      expect(
        rest.hidden && rest.h === 0 && !rest.inChat,
        `the folder screen is drawn at rest or sits in the chat column (hidden ${rest.hidden}, ${rest.h}px, in the chat ${rest.inChat})`,
      );
      expect(
        rest.controls === 'dir-picker' && rest.expanded === 'false',
        `New conversation does not say what it opens or that it is shut (aria-controls ${rest.controls}, aria-expanded ${rest.expanded})`,
      );
      expect(
        rest.lineControls === 'list-folders',
        `the folder line still claims the folder screen (aria-controls ${rest.lineControls}) rather than the folder filter`,
      );

      const lines: string[] = [];
      for (const [w, h] of [
        [390, 844],
        [1280, 810],
      ] as const) {
        const at = `${w}x${h}`;
        await page.setViewportSize({ width: w, height: h });
        // Rows with long previews, drawn through the page's own renderer, so
        // the overflow check below has something wide to hold: a nowrap
        // preview's full length once became the list's min-content (#175).
        await page.evaluate(String.raw`renderPastConversations(
          [1, 2, 3].map((n) => ({
            sessionId: '0000000' + n + '-aaaa-bbbb-cccc-dddddddddddd',
            title: 'planted past row ' + n,
            updatedAt: new Date().toISOString(),
            preview: 'a long first prompt that does not wrap, ' + 'so its whole length is the line. '.repeat(12),
          })),
          pastConvosCwd,
          false,
        )`);
        await openList(page);

        // #193: the folder line is the folder filter now, so pressing it
        // opens its menu and not the folder screen.
        await page.click('#list-folder');
        const byLine = await readPicker(page);
        const filterUp = (await page.evaluate(
          `!!document.getElementById('list-folders') && !document.getElementById('list-folders').hidden`,
        )) as boolean;
        expect(
          byLine.hidden && filterUp,
          `the folder line opened the folder screen, or not the folder filter, at ${at} (folder screen hidden ${byLine.hidden}, filter up ${filterUp})`,
        );
        await page.keyboard.press('Escape');

        // Pointer: New conversation opens it over the list, the whole
        // screen, with everything it held drawn and focus on its way back.
        await page.click('#list-new');
        const opened = await readPicker(page);
        // #188: in the pane layout it opens over the list in the list's own
        // 280px pane, as it opens over the list on the phone.
        const wantW = w >= PANE_MIN ? LEFT_PANE : w;
        expect(
          !opened.hidden && opened.top === 0 && opened.w === wantW && opened.h === h,
          `New conversation did not open the folder screen as a screen of its own at ${at} (${opened.w}x${opened.h} at ${opened.top}, want ${wantW}x${h})`,
        );
        expect(opened.title === 'New conversation', `the folder screen is titled ${JSON.stringify(opened.title)} at ${at}, not New conversation`);
        expect(opened.expanded === 'true', `New conversation does not say the folder screen is open at ${at}`);
        expect(opened.missing === '', `the open folder screen is missing ${opened.missing} at ${at}`);
        expect(opened.focusInPanel && opened.focusOn === 'dir-back', `opening it left focus on ${opened.focusOn} at ${at}`);
        expect(opened.backOnTop, `the folder screen's back button is not on top at ${at}, so its way out is under the list`);
        expect(
          opened.docW <= opened.vw && opened.panelRight <= opened.vw,
          `the folder screen overflows at ${at}: document ${opened.docW}px, right edge ${opened.panelRight}`,
        );

        // Keyboard: Tab from the back button reaches the folder's create,
        // Escape shuts it back onto New conversation, Enter on that opens it
        // again, and the back button shuts it onto New conversation too.
        let reached = '';
        for (let i = 0; i < 8 && reached !== 'dir-use'; i++) {
          await page.keyboard.press('Tab');
          reached = (await readPicker(page)).focusOn;
        }
        expect(reached === 'dir-use', `Tab from the back button never reached the folder's create at ${at}, it stopped on ${reached}`);
        await page.keyboard.press('Escape');
        const shutByEscape = await readPicker(page);
        expect(
          shutByEscape.hidden && shutByEscape.focusOn === 'new' && shutByEscape.expanded === 'false',
          `Escape did not shut the folder screen back onto New conversation at ${at} (hidden ${shutByEscape.hidden}, focus on ${shutByEscape.focusOn})`,
        );
        await page.keyboard.press('Enter');
        const reopened = await readPicker(page);
        expect(!reopened.hidden && reopened.focusInPanel, `Enter on New conversation did not open the folder screen at ${at}`);
        await page.click('#dir-back');
        const backed = await readPicker(page);
        expect(backed.hidden && backed.focusOn === 'new', `the back button did not shut it onto New conversation at ${at} (focus on ${backed.focusOn})`);
        await closeList(page);
        lines.push(`${at}: ${opened.w}x${opened.h} ${w >= PANE_MIN ? 'over the list in its pane' : 'screen over the list'}, focus on its back, no overflow (${opened.docW}/${opened.vw})`);
      }

      // No folder: a first browse that failed is exactly when the typed path
      // is the way in, so the door has to survive it.
      await page.setViewportSize({ width: 390, height: 844 });
      await page.evaluate('renderPastConversations([], null, false)');
      await openList(page);
      await page.click('#list-new');
      const bare = await readPicker(page);
      expect(
        !bare.hidden && bare.missing === '' && bare.folderLine === 'no folder yet',
        `with no folder the list's New conversation did not open the folder screen, or the line did not say so (${JSON.stringify({ hidden: bare.hidden, missing: bare.missing, line: bare.folderLine })})`,
      );
      await page.click('#dir-back');
      await page.click('#list-back');

      return (
        'hidden at rest and out of the chat column; the folder line opens the folder filter, not this; New conversation opens it with focus on its back button, Tab reaches its create, Escape and back return to New conversation, Enter reopens it; ' +
        lines.join('; ') +
        '; New conversation survives a list with no folder'
      );
    },
  });

  PAGE_SCENARIOS.push({
    name: 'P129 the browse, recent, Start here, typed-path and past paths all work from behind the list’s New conversation',
    // #175 (a), then #185 (h1), the other half of P128. Moving the folder
    // browser behind `change` is only safe if every way in it held still
    // lands where it did: a recent folder browses, a folder row browses (and
    // the list under the screen follows the folder, which is what `change` is
    // for), a typed path and the folder's create both reach the one create
    // POST, a refusal keeps the screen, and a past row (a row of the list
    // now) resumes and shuts what was opened to get there. Driven with real
    // input on the screen `change` opened. The create POST is answered 403 by
    // a route, because what is asserted is the cwd the page sends.
    // #193: the screen is New conversation's now. A recent folder's name
    // still browses; its Start here, the typed path's Start here and the
    // browsed folder's create each POST their own folder; the folder browsed
    // to becomes the current one, which the list spans with the recent ones
    // rather than switching to it alone.
    // #178: the folders it walks are planted inside the harness root rather
    // than read off the host, so the run depends on nothing this machine's
    // $HOME holds and prints none of its paths.
    waitView: false,
    run: async ({ page, viewer }) => {
      await page.setViewportSize({ width: 390, height: 844 });
      await page.waitForFunction('curDirPath !== null && pastConvosCwd !== null');
      // Refused before any write if the root is the real ~/.qwen, the same
      // guard P127 keeps for its plant: an inherited QWEN_RUNTIME_DIR can name
      // it, and these folders do not belong in a live home.
      const root = harnessRuntimeRoot();
      const realHome = join(homedir(), '.qwen');
      expect(
        root !== realHome && !root.startsWith(realHome + '/'),
        `the harness root ${root} sits inside the real ${realHome}, so planting folders there would write into a live home`,
      );
      const top = join(root, 'p129-folders');
      const inner = join(top, 'inner');
      const shown = (p: string) => p.split(root).join('<root>');
      rmSync(top, { recursive: true, force: true });
      mkdirSync(inner, { recursive: true });
      try {
        await openList(page);
        await page.click('#list-new');

        // Recent: the planted folder, seeded through the page's own store and
        // renderer, then its name tapped.
        await page.evaluate(
          `localStorage.setItem('qwen-rc-workspaces', JSON.stringify([${JSON.stringify(top)}])); renderRecentWorkspaces();`,
        );
        await page.click('#dir-recent .rrow .go');
        await page.waitForFunction(`curDirPath === ${JSON.stringify(top)}`);

        // Browse: a real tap on the planted subfolder's row. The folder it
        // landed on is the current one, which the list spans beside the
        // recent folder.
        await page.click('#dir-list .token-row >> text="inner/"');
        await page.waitForFunction(`curDirPath === ${JSON.stringify(inner)}`);
        await page.waitForFunction(`pastConvosCwd === ${JSON.stringify(inner)}`, null, { timeout: 5_000 });
        const browsed = (await page.evaluate(String.raw`({
          current: document.getElementById('dir-current').textContent,
          spans: listFolders(),
        })`)) as { current: string; spans: string[] };
        expect(
          browsed.current === inner && JSON.stringify(browsed.spans) === JSON.stringify([inner, top]),
          `a folder row did not browse, or the list does not span the folder browsed to beside the recent one (${JSON.stringify({ current: shown(browsed.current), spans: browsed.spans.map(shown) })})`,
        );

        // Typed path and the folder's create: both funnel into the one POST.
        const isCreate = (u: URL) => u.pathname === '/session';
        await page.route(isCreate, async (route) => {
          if (route.request().method() !== 'POST') return route.continue();
          await route.fulfill({
            status: 403,
            contentType: 'application/json',
            body: JSON.stringify({ error: 'refused by the scenario' }),
          });
        });
        // #193: each press waits for its answer to be handled, because a
        // create in flight holds the next one off (startConversationIn).
        const createCwd = async (press: () => Promise<void>) => {
          const req = page.waitForRequest(
            (r) => new URL(r.url()).pathname === '/session' && r.method() === 'POST',
          );
          await press();
          const cwd = (JSON.parse((await req).postData() || '{}') as { cwd?: string }).cwd;
          await page.waitForFunction(`!document.getElementById('new-session').disabled`, null, { timeout: 5_000 });
          return cwd;
        };
        // #193: a recent folder's Start here sends that folder, whichever
        // one the browser is on (inner, here).
        const started = await createCwd(() => page.click(`#dir-recent .rrow[data-folder="${top}"] .start`));
        expect(
          started === top,
          `the recent folder's Start here sent cwd ${JSON.stringify(shown(started ?? ''))}, not that folder`,
        );
        const startLabel = (await page.evaluate(`document.getElementById('new-session').textContent.trim()`)) as string;
        expect(startLabel === 'Start here', `the typed path's button reads ${JSON.stringify(startLabel)}, not Start here`);
        // Start here dropped its folder into the field the typed path uses;
        // emptied, so typing the path is a change the field reports.
        await page.evaluate(`document.getElementById('new-session-cwd').value = ''`);
        await page.fill('#new-session-cwd', top);
        const typed = await createCwd(() => page.click('#new-session'));
        expect(
          typed === top,
          `the typed path sent cwd ${JSON.stringify(shown(typed ?? ''))}, not the path typed`,
        );
        // Typing and leaving the field browses there (its change handler), so
        // the folder's create now names whatever the browser landed on.
        await page.waitForFunction(`curDirPath === ${JSON.stringify(top)}`);
        const used = await createCwd(() => page.click('#dir-use'));
        expect(
          used === top,
          `the folder's create sent cwd ${JSON.stringify(shown(used ?? ''))}, not the folder on screen`,
        );
        // The request leaving is not the answer landing: wait for the page to
        // say the refusal before asking what it did with the screen.
        await page.waitForFunction(
          String.raw`/not authorized/.test(document.getElementById('status').textContent)`,
          null,
          { timeout: 5_000 },
        );
        const refused = (await page.evaluate(String.raw`({
          open: !document.getElementById('dir-picker').hidden,
          toast: (() => {
            const t = document.getElementById('status');
            if (t.getClientRects().length === 0) return false;
            const b = t.getBoundingClientRect();
            const at = document.elementFromPoint(b.left + b.width / 2, b.top + b.height / 2);
            return !!at && t.contains(at);
          })(),
        })`)) as { open: boolean; toast: boolean };
        expect(refused.open, 'a refused create shut the folder screen, so the reader loses the folder they picked');
        expect(refused.toast, 'the refusal is not on screen over the folder screen, so the reader is not told why');
        await page.unroute(isCreate);

        // Past: a row of the list for the stub's own conversation, tapped.
        // Nothing is watched yet, so arriving in it is a change of
        // conversation, and the screens opened to get there shut behind it.
        await page.click('#dir-back');
        await page.evaluate(
          `renderPastConversations([{ sessionId: ${JSON.stringify(viewer.sessionId)}, title: 'resume me from the list' }], curDirPath, false)`,
        );
        await page.click('#past-list .s >> text=resume me from the list');
        await page.waitForFunction(`watchedSessionId === ${JSON.stringify(viewer.sessionId)}`);
        const arrived = (await page.evaluate(String.raw`({
          list: document.getElementById('list-screen').hidden,
          folder: document.getElementById('dir-picker').hidden,
          expanded: document.getElementById('list-new').getAttribute('aria-expanded'),
        })`)) as { list: boolean; folder: boolean; expanded: string };
        expect(
          arrived.list && arrived.folder && arrived.expanded === 'false',
          `arriving in a conversation left the list or the folder screen open (${JSON.stringify(arrived)})`,
        );
      } finally {
        // The root is shared for the whole process, so the plant goes with
        // the scenario.
        rmSync(top, { recursive: true, force: true });
      }
      return `recent browsed to ${shown(top)}, its folder row to ${shown(inner)}, which the list then spans beside the recent one; the recent folder's Start here, the typed path's Start here and the folder's create each POST ${shown(top)}; a refusal keeps the screen and is said over it; a row of the list resumes and shuts both screens`;
    },
  });

  // #175 (b) and the fold. The audit measured the composer 258px under the
  // fold at 1280x810 and 498px under at 390x844 with a transcript long enough
  // to fill its box, which is the case P126's short transcript never reaches.
  // So this scenario carries fourteen turns and an in-progress tool row.
  // #184 (h1) rewrote what it holds: the composer is one row, and the
  // attachment controls moved behind its + with Dictate, as 44px pills in a
  // sideways scroller. The claims kept are the same three: the tools still do
  // what they did, the composer's bottom is on the fold (composerUnderFold 0)
  // with nothing overflowing sideways, and the newest row stays on screen
  // when something shrinks the transcript under a reader at the end. The
  // states read are the ones H1 can put on top of a full transcript: at rest,
  // the sheet open, the tools open, and both.
  const P130_MARKER = 'newest-row-marker';
  PAGE_SCENARIOS.push({
    name: 'P130 the composer is one row with Attach, Dictate, Files and Artifacts behind its +, and clears the fold with a full transcript in every state',
    frames: () => {
      const f = new Frames().ev('client_joined');
      for (let k = 0; k < 14; k++) {
        f.user(`question ${k}: why does the nightly build fail on the arm64 runner?`);
        f.asst(
          `answer ${k}: the arm64 job pins an image without the native toolchain, ` +
            'so the addon build fails there and not on x86.',
        );
        f.done();
      }
      f.upd({
        sessionUpdate: 'tool_call',
        toolCallId: 'tc-newest',
        title: `read_file ${P130_MARKER}`,
        status: 'in_progress',
      });
      return f.list;
    },
    run: async ({ page, viewer }) => {
      await watch(page, viewer.sessionId);
      await waitForFrame(page, 44, 30_000);
      await settlePage(page);
      // A frame or two after whatever resized the column, so a reading
      // taken straight after a change does not measure the layout before it.
      const relaid = async () => {
        await page.waitForTimeout(300);
        await page.evaluate(
          'new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(() => requestAnimationFrame(r))))',
        );
      };

      type ToolsReading = {
        open: boolean;
        bandH: number;
        scrollsX: boolean;
        overflowsPage: boolean;
        pills: { id: string; text: string; title: string; label: string; h: number; inTools: boolean }[];
      };
      const readTools = () =>
        page.evaluate(String.raw`(() => {
          const tools = document.getElementById('h1-tools');
          const r = tools.getBoundingClientRect();
          return {
            open: tools.getClientRects().length > 0,
            bandH: Math.round(r.height),
            scrollsX: getComputedStyle(tools).overflowX === 'auto',
            overflowsPage: document.documentElement.scrollWidth > window.innerWidth,
            pills: ['attach', 'dictate', 'stored-toggle', 'artifacts-toggle'].map((id) => {
              const b = document.getElementById(id);
              return {
                id,
                text: (b.innerText || '').replace(/\s+/g, ' ').trim(),
                title: b.getAttribute('title') || '',
                label: b.getAttribute('aria-label') || '',
                h: Math.round(b.getBoundingClientRect().height),
                inTools: tools.contains(b),
              };
            }),
          };
        })()`) as Promise<ToolsReading>;

      const WORDS: Record<string, string> = {
        attach: 'Attach file',
        dictate: 'Dictate',
        'stored-toggle': 'Files',
        'artifacts-toggle': 'Artifacts',
      };
      const shut = await readTools();
      expect(!shut.open && shut.bandH === 0, `the tools cost ${shut.bandH}px at rest`);
      const plusSays = await page.getAttribute('#h1-plus', 'aria-expanded');
      expect(plusSays === 'false', `the + does not say the tools are shut (aria-expanded ${plusSays})`);

      for (const [w, h] of [
        [390, 844],
        [360, 780],
        [1280, 810],
      ] as const) {
        await page.setViewportSize({ width: w, height: h });
        await openTools(page);
        const t = await readTools();
        const at = `${w}x${h}`;
        expect(
          t.open && t.bandH >= 52 && t.bandH <= 53,
          `the open tools are ${t.bandH}px at ${at}, not the 52px the spec draws (plus its 1px rule)`,
        );
        expect(t.scrollsX && !t.overflowsPage, `the tools do not scroll sideways inside themselves at ${at}`);
        for (const b of t.pills) {
          expect(b.inTools, `#${b.id} is not behind the composer's +`);
          // Files carries its count once the store has answered (P142).
          expect(b.text.includes(WORDS[b.id]!), `#${b.id} reads ${JSON.stringify(b.text)} at ${at}, not ${WORDS[b.id]}`);
          expect(b.h >= 44, `#${b.id} is ${b.h}px tall at ${at}, under the 44px floor`);
          if (b.id !== 'dictate') {
            expect(
              b.title.length > 10 && b.label === b.title,
              `#${b.id} does not carry its phrase in title and aria-label (title ${JSON.stringify(b.title)}, label ${JSON.stringify(b.label)})`,
            );
          }
        }
        expect(
          (await page.getAttribute('#h1-plus', 'aria-expanded')) === 'true',
          `the + does not say the tools are open at ${at}`,
        );
        // The tools still do what they did before the move.
        const chooser = page.waitForEvent('filechooser', { timeout: 5_000 });
        await page.click('#attach');
        await chooser;
        for (const [btn, box] of [
          ['stored-toggle', 'stored'],
          ['artifacts-toggle', 'artifacts'],
        ] as const) {
          await page.click('#' + btn);
          await page.waitForSelector('#' + box, { state: 'visible' });
          const expanded = await page.getAttribute('#' + btn, 'aria-expanded');
          expect(expanded === 'true', `#${btn} opened its list but reads aria-expanded ${expanded}`);
          await page.click('#' + btn);
          await page.waitForSelector('#' + box, { state: 'hidden' });
        }
        await page.click('#h1-plus');
        await relaid();
        const closed = await readTools();
        expect(!closed.open, `the + did not shut the tools at ${at}`);
      }

      type FoldReading = {
        vh: number;
        vw: number;
        docW: number;
        bottom: number;
        trH: number;
        scrolls: boolean;
        markerSeen: boolean;
      };
      const readFold = () =>
        page.evaluate(String.raw`(() => {
          const comp = document.getElementById('composer');
          const tr = document.getElementById('transcript');
          const t = tr.getBoundingClientRect();
          const row = Array.from(tr.querySelectorAll('.bubble')).find((b) =>
            (b.textContent || '').includes(${JSON.stringify(P130_MARKER)}),
          );
          const m = row ? row.getBoundingClientRect() : null;
          return {
            vh: window.innerHeight,
            vw: window.innerWidth,
            docW: document.documentElement.scrollWidth,
            bottom: Math.round(comp.getBoundingClientRect().bottom),
            trH: tr.clientHeight,
            scrolls: tr.scrollHeight > tr.clientHeight + 1,
            markerSeen: !!m && m.bottom <= t.bottom + 1 && m.top >= t.top - 1,
          };
        })()`) as Promise<FoldReading>;

      // #189: the phones first, 390 then 360, then the laptop at its short
      // and its usual height.
      const lines: string[] = [];
      for (const [w, h] of [
        [390, 844],
        [360, 780],
        [1280, 720],
        [1280, 810],
      ] as const) {
        await page.setViewportSize({ width: w, height: h });
        await relaid();
        const at = `${w}x${h}`;
        const states: [string, () => Promise<void>, () => Promise<void>][] = [
          ['at rest', async () => {}, async () => {}],
          ['sheet open', () => openSheet(page), () => page.click('#h1-status')],
          ['tools open', () => openTools(page), () => page.click('#h1-plus')],
          [
            'sheet and tools open',
            async () => {
              await openSheet(page);
              await openTools(page);
            },
            async () => {
              await page.click('#h1-status');
              await page.click('#h1-plus');
            },
          ],
        ];
        const bottoms: string[] = [];
        let restH = 0;
        for (const [label, open, close] of states) {
          await open();
          await relaid();
          const f = await readFold();
          await close();
          await relaid();
          // Each premise first, so a pass below cannot be vacuous.
          expect(f.scrolls, `the transcript holds less than its box at ${at} ${label}, so the fold is not being exercised`);
          expect(
            f.bottom <= f.vh,
            `composerUnderFold is ${f.bottom - f.vh} at ${at} ${label}: the composer bottom is ${f.bottom} in a ${f.vh}px viewport`,
          );
          expect(f.docW <= f.vw, `the page overflows sideways at ${at} ${label}: ${f.docW}px in a ${f.vw}px viewport`);
          expect(
            f.markerSeen,
            `the newest row is not on screen at ${at} ${label}, so what shrank the transcript left the reader short of it`,
          );
          if (label === 'at rest') restH = f.trH;
          bottoms.push(`${label} ${f.bottom}`);
        }
        if (w === 390) {
          expect(restH >= 600, `the transcript at rest is ${restH}px at 390x844, under the 600px h1 promises`);
        }
        lines.push(`${at}: transcript ${restH}px at rest, composer bottom ${bottoms.join(', ')}`);
      }

      return (
        'Attach, Dictate, Files, Artifacts as 44px pills in a 52px scroller behind the +, picker and both lists open; ' +
        lines.join('; ') +
        '; newest row on screen in every state, no sideways overflow'
      );
    },
  });

  // #177. "There's a mix of white and black elements and looks bad." Each band
  // the shell pass restyled is held to the ground the sheet draws it on, read
  // as computed rather than out of the CSS, because the failure this guards is
  // a band that loses its ground to a later rule or an inline style, and the
  // source would still read as styled. The grounds are the sheet's literal
  // values (g1-ops-console-drawer-1to1.html): body #0d1117 under the status
  // line (.status), #10151c under every band (.drawer, .composer, .rail) and
  // #161b22 under a control (.ic, .mic, select). Comparing against the
  // literals rather than the page's own variables is the point: a token
  // quietly changed to white would pass a check that read the token back.
  // Then the sweep the issue asks for: nothing bigger than 40x40 inside the
  // app is white, #f8f8f8, or any other light ground. And the two phone
  // reclaims, which are only safe if they hold: the title is gone below the
  // break and back above it, and export shares the drawer's first line at 390
  // without covering any of the band's text.
  PAGE_SCENARIOS.push({
    name: 'P131 every restyled band sits on the sheet shell, nothing large is light, no page title at any width, and export lives in the ⋯ menu',
    waitView: false,
    run: async ({ page, viewer }) => {
      await watch(page, viewer.sessionId);
      await page.waitForSelector('#composer', { state: 'visible' });
      await page.evaluate(String.raw`__pg.liveTurn('what is the plan', 'here is the plan', 'tc-1')`);
      await settlePage(page);
      // #184: the drawer band is the sheet now, filled by the same render.
      await page.waitForFunction(`document.getElementById('session-footer').style.display !== 'none'`);

      const G1 = {
        page: 'rgb(13, 17, 23)',
        band: 'rgb(16, 21, 28)',
        raise: 'rgb(22, 27, 34)',
        accent: 'rgb(31, 111, 235)',
      };
      // #184 (h1): the spec's grounds. The bar, the sheet, the tools and the
      // composer are bands; the status line sits on the page ground under the
      // bar; the pills, the toast and the ⋯ menu are raised controls; the More
      // screen is the page ground with band rows.
      // #187: a panel screen is drawn as More is, the page ground under a
      // band head, and each card on it is a band.
      const want = {
        ...(Object.fromEntries(
          PANEL_SURFACES.map((s) => [
            s,
            [
              ['#panel-screen', 'page'],
              ['#panel-screen .scr-head', 'band'],
              ['#panel-screen .panel:not([hidden]) .ops-card', 'band'],
            ],
          ]),
        ) as Record<PanelSurface, [string, keyof typeof G1][]>),
        chat: [
          ['#h1-bar', 'band'],
          ['#h1-statusline', 'page'],
          ['#h1-sheet', 'band'],
          ['#h1-tools', 'band'],
          ['#composer', 'band'],
          ['#load-earlier', 'raise'],
          ['#jump-bottom', 'raise'],
          ['#status', 'raise'],
        ],
        menu: [['#h1-menu', 'raise']],
        // #185: the List screen as drawn: the page ground, the bar and the
        // thumb zone on the band, the folder line on the page, the button on
        // the accent.
        list: [
          ['#list-screen', 'page'],
          ['#list-screen .scr-head', 'band'],
          ['#list-folder', 'page'],
          ['#list-foot', 'band'],
          ['#list-new', 'accent'],
        ],
        more: [
          ['#more-screen', 'page'],
          ['#more-screen .row', 'band'],
        ],
        picker: [
          ['#dir-picker', 'page'],
          ['#dir-picker .scr-head', 'band'],
        ],
        archived: [
          ['#archived-view', 'page'],
          ['#archived-view .scr-head', 'band'],
        ],
      } as Record<ShellSurface, [string, keyof typeof G1][]>;
      type Ground = { sel: string; n: number; off: string[] };
      type Big = { kind: string; bg: string };
      // #189: both phones, then the laptop.
      const lines: string[] = [];
      for (const [w, h] of [
        [390, 844],
        [360, 780],
        [1280, 810],
      ] as const) {
        await page.setViewportSize({ width: w, height: h });
        let cards = 0;
        for (const s of SHELL_SURFACES) {
          const at = `${w}x${h} ${s}`;
          await openShellSurface(page, s);
          const grounds = (await page.evaluate(String.raw`(${JSON.stringify(want[s])}).map(([sel, token]) => {
            const els = Array.from(document.querySelectorAll(sel)).filter((e) => e.getClientRects().length > 0);
            return {
              sel,
              n: els.length,
              off: els
                .map((e) => [e, getComputedStyle(e).backgroundColor])
                .filter(([, bg]) => bg !== ${JSON.stringify(G1)}[token])
                .map(([e, bg]) => (e.id || e.tagName.toLowerCase()) + ' ' + bg),
            };
          })`)) as Ground[];
          // Every opaque ground on a box bigger than 40x40. The arithmetic is
          // in Node, so this only collects.
          const big = (await page.evaluate(String.raw`Array.from(document.querySelectorAll('#app-body *'))
            .filter((e) => {
              const b = e.getBoundingClientRect();
              return b.width > 40 && b.height > 40 && getComputedStyle(e).backgroundColor !== 'rgba(0, 0, 0, 0)';
            })
            .map((e) => ({
              kind: e.tagName.toLowerCase() + (e.id ? '#' + e.id : '') + (typeof e.className === 'string' && e.className ? '.' + e.className.split(' ')[0] : ''),
              bg: getComputedStyle(e).backgroundColor,
            }))`)) as Big[];
          await closeShellSurface(page, s);
          for (const g of grounds) {
            expect(g.n > 0, `nothing matching ${g.sel} is on screen at ${at}, so its ground was never read`);
            expect(
              g.off.length === 0,
              `${g.sel} is not on the sheet's ground at ${at}: ${g.off.slice(0, 4).join(', ')}`,
            );
            if (g.sel.includes('ops-card')) cards += g.n;
          }
          // The two values the issue names, then anything else light: a ground
          // with a relative luminance over 0.4 is a light card on this page
          // whatever its hex (the old #fffbe6 card, a browser-default #efefef
          // button). The lightest ground this page means to draw is the Send
          // button's #238636, at 0.18.
          const light = big.filter((b) => {
            if (b.bg === 'rgb(255, 255, 255)' || b.bg === 'rgb(248, 248, 248)') return true;
            const c = pgParseRgb(b.bg);
            return c !== null && c.a >= 0.5 && pgLuminance(c) > 0.4;
          });
          expect(
            light.length === 0,
            `${light.length} boxes over 40x40 sit on a light ground at ${at}: ${light
              .slice(0, 5)
              .map((b) => b.kind + ' ' + b.bg)
              .join(', ')}`,
          );
        }

        // The reclaims, read on the resting Chat column: no page title row at
        // any width (the spec's bar has none), and export where the parity
        // table puts it, in the ⋯ menu, not a control of its own in a band.
        const rest = (await page.evaluate(String.raw`(() => {
          const ex = document.getElementById('footer-export');
          return {
            titleShown: !!document.querySelector('#app-body > h1'),
            exInMenu: document.getElementById('h1-menu').contains(ex),
            exShownAtRest: ex.getClientRects().length > 0,
            barH: Math.round(document.getElementById('h1-bar').getBoundingClientRect().height),
          };
        })()`)) as { titleShown: boolean; exInMenu: boolean; exShownAtRest: boolean; barH: number };
        expect(!rest.titleShown, `the page title is on the page at ${w}`);
        expect(rest.exInMenu && !rest.exShownAtRest, `export is not in the ⋯ menu, or is drawn at rest, at ${w} (${JSON.stringify(rest)})`);
        await openMenu(page);
        const exOpen = (await page.evaluate(
          `document.getElementById('footer-export').getClientRects().length > 0`,
        )) as boolean;
        await page.keyboard.press('Escape');
        expect(exOpen, `opening the ⋯ menu at ${w} did not show export`);
        lines.push(
          `${w}x${h}: bar, sheet, tools and composer on #10151c, status line on #0d1117, pills, toast and menu on #161b22, More on #0d1117 with #10151c rows, the List, folder and archived screens on #0d1117 with #10151c heads and New conversation on #1f6feb, ${PANEL_SURFACES.length} panel screens on #0d1117 with ${cards} cards on #10151c, no light box; no page title, export in the menu`,
        );
      }
      return lines.join('; ');
    },
  });

  // #180. Archive and delete lived only on the New conversation panel's past
  // rows, behind the rail's +, and nothing on the rail itself could rename,
  // file away or remove a conversation. Every rail row got a ⋯ menu, and #185
  // (h1) carries it onto the List screen's rows, where it is a 44px button
  // always drawn (the list is the phone's layout at every width, so there is
  // no hover to fade it in on). Driven with real input at both widths the
  // sheet draws, by pointer and by keyboard, because the claims are that it is
  // reachable and operable, not that a handler exists. The conversations are transcripts planted under
  // the harness root, in a folder of the scenario's own: P127 holds that the
  // folder the page lands on lists nothing, and the pool runs scenarios side
  // by side in one root. The daemon's half of archive is answered here (the
  // stub daemon has no archive), and it does what the daemon does to the
  // listing: the transcript leaves the folder's chats dir. Everything on the
  // page's side is real, including the refresh that redraws the list from
  // disk. Delete is only ever dismissed, so no delete request may leave.
  PAGE_SCENARIOS.push({
    name: 'P132 every list row has a menu that archives and deletes it, and renames it while it is open, by pointer and by keyboard, on the List screen at 1280 and 390',
    waitView: false,
    run: async ({ page, viewer }) => {
      await watch(page, viewer.sessionId);
      await page.waitForSelector('#composer', { state: 'visible' });
      await page.waitForFunction('curDirPath !== null && pastConvosCwd !== null');
      const root = harnessRuntimeRoot();
      const realHome = join(homedir(), '.qwen');
      expect(
        root !== realHome && !root.startsWith(realHome + '/'),
        `the harness root ${root} sits inside the real ${realHome}, so planting transcripts there would write into a live history`,
      );
      const folder = join(root, 'p132-folder');
      const chatsDir = resolveChatsDir(folder);
      expect(
        chatsDir === root || chatsDir.startsWith(root + '/'),
        `the chats dir for the planted folder is ${chatsDir}, outside the harness root ${root}`,
      );
      const HERE = viewer.sessionId;
      const ARC = ['aaaaaaaa-1320-4000-8000-000000000001', 'aaaaaaaa-1320-4000-8000-000000000002'];
      const DEL = 'dddddddd-1320-4000-8000-000000000003';
      const TITLE: Record<string, string> = {
        [HERE]: 'p132 the one on screen',
        [ARC[0]!]: 'p132 filed away at 1280',
        [ARC[1]!]: 'p132 filed away at 390',
        [DEL]: 'p132 asked before it goes',
      };
      const planted = Object.keys(TITLE).map((id) => join(chatsDir, `${id}.jsonl`));
      rmSync(folder, { recursive: true, force: true });
      mkdirSync(folder, { recursive: true });
      mkdirSync(chatsDir, { recursive: true });
      for (const [id, title] of Object.entries(TITLE)) {
        writeFileSync(
          join(chatsDir, `${id}.jsonl`),
          JSON.stringify({
            type: 'system',
            subtype: 'custom_title',
            systemPayload: { customTitle: title, titleSource: 'manual' },
          }) + '\n',
        );
      }
      try {
        // The daemon's live-state names the watched conversation as running,
        // which is what earns its row the fourth item.
        await page.route(/\/rc\/sessions\/live-state\?/, (route) =>
          route.fulfill({
            status: 200,
            contentType: 'application/json',
            body: JSON.stringify({
              v: 1,
              catalogVersion: { generation: 'g-1', revision: 1 },
              sessions: [
                {
                  sessionId: HERE,
                  clientCount: 1,
                  hasActivePrompt: false,
                  isWaitingForPermission: false,
                  isWaitingForUserQuestion: false,
                },
              ],
            }),
          }),
        );
        const archived: string[] = [];
        await page.route(/\/rc\/sessions\/archive$/, async (route) => {
          const ids =
            (JSON.parse(route.request().postData() ?? '{}') as { sessionIds?: string[] })
              .sessionIds ?? [];
          archived.push(...ids);
          for (const id of ids) rmSync(join(chatsDir, `${id}.jsonl`), { force: true });
          await route.fulfill({
            status: 200,
            contentType: 'application/json',
            body: JSON.stringify({ action: 'archive', requested: ids.length, archived: ids }),
          });
        });
        const sent: string[] = [];
        page.on('request', (r) => {
          const p = new URL(r.url()).pathname;
          if (p === '/rc/sessions/delete' || p.endsWith('/metadata')) sent.push(r.method() + ' ' + p);
        });
        // The harness dismisses every dialog; this only records what was asked.
        const asked: { type: string; message: string }[] = [];
        page.on('dialog', (d) => asked.push({ type: d.type(), message: d.message() }));

        await page.evaluate(
          `curDirPath = ${JSON.stringify(folder)}; refreshPastConversations(${JSON.stringify(folder)})`,
        );
        await page.waitForFunction(`document.querySelectorAll('#past-list .srow').length === 4`);

        type MenuReading = {
          open: boolean;
          items: string[];
          focus: string;
          label: string;
          bg: string;
          inView: boolean;
        };
        const readMenu = () =>
          page.evaluate(String.raw`(() => {
            const m = document.getElementById('list-menu');
            if (!m) return { open: false, items: [], focus: '', label: '', bg: '', inView: false };
            const r = m.getBoundingClientRect();
            const a = document.activeElement;
            return {
              open: !m.hidden && m.getClientRects().length > 0,
              items: Array.from(m.querySelectorAll('[role="menuitem"]')).map((b) => b.textContent),
              focus: m.contains(a) ? a.textContent : '',
              label: m.getAttribute('aria-label') || '',
              bg: getComputedStyle(m).backgroundColor,
              inView: r.left >= 0 && r.top >= 0 && r.right <= window.innerWidth && r.bottom <= window.innerHeight,
            };
          })()`) as Promise<MenuReading>;
        type MoreReading = {
          opacity: string;
          w: number;
          h: number;
          label: string;
          popup: string;
          expanded: string;
          focused: boolean;
        };
        const readMore = (id: string) =>
          page.evaluate(String.raw`(() => {
            const w = Array.from(document.querySelectorAll('#past-list .srow')).find((x) => x.dataset.session === ${JSON.stringify(id)});
            const b = w ? w.querySelector('.more') : null;
            if (!b) return null;
            const r = b.getBoundingClientRect();
            return {
              opacity: getComputedStyle(b).opacity,
              w: Math.round(r.width),
              h: Math.round(r.height),
              label: b.getAttribute('aria-label') || '',
              popup: b.getAttribute('aria-haspopup') || '',
              expanded: b.getAttribute('aria-expanded') || '',
              focused: document.activeElement === b,
            };
          })()`) as Promise<MoreReading | null>;
        const rowSel = (id: string) => `#past-list .srow[data-session="${id}"]`;
        // A past row offers what can act on a transcript; Rename only where the
        // daemon has the conversation open, since its route reaches nothing
        // else; End session only on the open row on screen.
        const PAST = 'Archive,Delete';
        const FOUR = 'Rename,Archive,Delete,End session';
        const lines: string[] = [];

        for (const [w, h, i] of [
          [1280, 810, 0],
          [390, 844, 1],
        ] as const) {
          const at = `${w}x${h}`;
          await page.setViewportSize({ width: w, height: h });
          await page.mouse.move(w - 2, h - 2);
          const phone = w < 860;
          // #185 (h1): the rows are the List screen's at every width, so the
          // list the bar's title opens is opened before its rows are read.
          await openList(page);

          // At rest: named for its row and announced as a menu button, and a
          // 44px cell always drawn, at both widths.
          const rest = await readMore(DEL);
          expect(rest !== null, `the row for a planted conversation has no actions button at ${at}`);
          expect(
            rest!.label === `Actions for ${TITLE[DEL]}` && rest!.popup === 'menu' && rest!.expanded === 'false',
            `the actions button does not name its row or say it opens a menu at ${at} (${JSON.stringify(rest)})`,
          );
          expect(
            rest!.opacity === '1' && rest!.w >= 44 && rest!.h >= 44,
            `the actions button is ${rest!.w}x${rest!.h} at opacity ${rest!.opacity} at ${at}, not an always-shown 44px cell`,
          );

          // Pointer: the menu opens on the row, on the shell, inside the
          // viewport, with focus on its first item, and Escape puts focus
          // back on the button.
          await page.click(`${rowSel(DEL)} > .more`);
          const byClick = await readMenu();
          expect(byClick.open, `clicking the actions button opened no menu at ${at}`);
          expect(
            byClick.items.join(',') === PAST,
            `a past row's menu reads ${JSON.stringify(byClick.items)} at ${at}, not ${PAST}`,
          );
          expect(
            !byClick.items.includes('Rename'),
            `a past row offers Rename at ${at}, which the daemon can only refuse for a conversation it does not have open`,
          );
          expect(byClick.label === `Actions for ${TITLE[DEL]}`, `the menu is labelled ${JSON.stringify(byClick.label)}`);
          expect(byClick.focus === 'Archive', `opening the menu left focus on ${JSON.stringify(byClick.focus)}, not its first item`);
          expect((await readMore(DEL))!.expanded === 'true', `the button does not say its menu is open at ${at}`);
          expect(byClick.bg === 'rgb(22, 27, 34)', `the menu is ${byClick.bg}, not the sheet's control ground`);
          expect(byClick.inView, `the menu hangs outside the viewport at ${at}`);
          for (const row of await readShellText(page, ['#list-menu'])) pgShellCheck(row, `${at} row menu`);
          await page.keyboard.press('Escape');
          const shut = await readMenu();
          const back = await readMore(DEL);
          expect(
            !shut.open && back!.focused && back!.expanded === 'false',
            `Escape left the menu open (${shut.open}) or focus off its button (${back!.focused}) at ${at}`,
          );

          // Keyboard: Tab from the row reaches its button, Enter (1280) or
          // Space (390) opens it, the arrows wrap, Home and End jump. The row
          // on screen is live, so it carries End session as a fourth item.
          await page.focus(`${rowSel(HERE)} > .s`);
          await page.keyboard.press('Tab');
          const tabbed = await readMore(HERE);
          expect(tabbed!.focused, `Tab from the row on screen did not reach its actions button at ${at}`);
          await page.keyboard.press(phone ? 'Space' : 'Enter');
          const byKey = await readMenu();
          expect(byKey.open, `${phone ? 'Space' : 'Enter'} on the actions button opened no menu at ${at}`);
          expect(
            byKey.items.join(',') === FOUR,
            `the live row on screen offers ${JSON.stringify(byKey.items)} at ${at}, not ${FOUR}`,
          );
          const walk: string[] = [byKey.focus];
          // Both ends wrap: up from the first item and down from the last.
          for (const key of ['ArrowDown', 'ArrowUp', 'ArrowUp', 'Home', 'End', 'ArrowDown']) {
            await page.keyboard.press(key);
            walk.push((await readMenu()).focus);
          }
          expect(
            walk.join(',') === 'Rename,Archive,Rename,End session,Rename,End session,Rename',
            `the menu keys walked ${JSON.stringify(walk)} at ${at}`,
          );
          await page.keyboard.press('Escape');
          expect((await readMore(HERE))!.focused, `Escape did not return focus to the live row's button at ${at}`);

          // Delete asks first, naming the conversation, and a dismissed ask
          // sends nothing and keeps the row. Rename, on the open row, asks for
          // the new name the same way, and a dismissed one sends nothing either.
          const before = asked.length;
          await page.click(`${rowSel(DEL)} > .more`);
          await page.click('#list-menu [role="menuitem"]:text-is("Delete")');
          await page.click(`${rowSel(HERE)} > .more`);
          await page.click('#list-menu [role="menuitem"]:text-is("Rename")');
          await page.waitForTimeout(300);
          const asks = asked.slice(before);
          expect(
            asks.length === 2 &&
              asks[0]!.type === 'confirm' &&
              asks[0]!.message.includes(TITLE[DEL]!) &&
              asks[1]!.type === 'prompt' &&
              asks[1]!.message.includes(TITLE[HERE]!),
            `Delete and Rename did not each ask, naming the conversation, at ${at} (${JSON.stringify(asks)})`,
          );
          expect(sent.length === 0, `a dismissed ask still sent ${JSON.stringify(sent)} at ${at}`);
          expect((await readMore(DEL)) !== null, `dismissing Delete still took the row off the list at ${at}`);

          // Archive, from the keyboard on the phone and the pointer on the
          // desktop: the request names the row, and the row leaves the list
          // through the page's own refresh. On a past row Archive is the first
          // item, so the keyboard path is open and activate.
          const target = ARC[i]!;
          if (phone) {
            await page.focus(`${rowSel(target)} > .s`);
            await page.keyboard.press('Tab');
            await page.keyboard.press('Space');
            await page.keyboard.press('Enter');
          } else {
            await page.click(`${rowSel(target)} > .more`);
            await page.click('#list-menu [role="menuitem"]:text-is("Archive")');
          }
          await page
            .waitForFunction(`!document.querySelector('${rowSel(target)}')`, null, { timeout: 5_000 })
            .catch(() => undefined);
          expect(archived.includes(target), `Archive at ${at} sent nothing for the row (${JSON.stringify(archived)})`);
          const left = (await page.evaluate(
            String.raw`Array.from(document.querySelectorAll('#past-list .srow')).map((x) => x.dataset.session)`,
          )) as string[];
          expect(!left.includes(target), `the archived row is still on the list at ${at}`);
          expect(
            left.includes(HERE) && left.includes(DEL),
            `archiving one row took others with it at ${at} (${JSON.stringify(left)})`,
          );
          lines.push(
            `${at}: on the List screen the title opens, 44px button always shown, click and ${phone ? 'Space' : 'Enter'} open it, a past row offers ${PAST} with no Rename, the open row ${FOUR}, Escape returns focus, Delete and Rename ask and send nothing when dismissed, Archive by ${phone ? 'keyboard' : 'pointer'} took the row off`,
          );
        }
        return lines.join('; ');
      } finally {
        for (const p of planted) rmSync(p, { force: true });
        rmSync(folder, { recursive: true, force: true });
      }
    },
  });
}

// #182. On a phone the browser evicts a background tab within minutes, so a
// return to the app is a cold load. These hold that what the reader set on the
// page survives one, and that the page can be installed.
{
  // Reloads the page and waits for it to be back on a conversation with the
  // replay drawn, which is read as the model holding as many rows as it did
  // before. Not waitForFrame: the restore sets lastSeenEventId to the saved
  // cursor before the replay starts, so the last id is "seen" at once.
  const reloadAndRestore = async (page: Page, rows: number): Promise<void> => {
    await page.reload({ waitUntil: 'domcontentloaded' });
    await page.waitForFunction(`typeof startWatch === 'function'`);
    await page.waitForFunction(`watchedSessionId !== null`);
    await page.waitForFunction(`transcriptModel.items.length >= ${rows}`, null, {
      timeout: 30_000,
    });
  };
  const rowCount = (page: Page) =>
    page.evaluate(`transcriptModel.items.length`) as Promise<number>;

  // The idle switch is held by the gateway, which the harness boots with no
  // idle runtime, so it reports the switch unavailable. A route plays the
  // gateway instead, and forgets the switch across the reload the way a
  // gateway restart does: that is the case the page's saved state is for.
  let p133IdleOn = false;
  PAGE_SCENARIOS.push({
    name: 'P133 every setting the page keeps comes back after a reload, and the daemon’s own state still wins where it has one',
    frames: () =>
      new Frames()
        .ev('client_joined')
        .user('p133 question')
        .thought('p133 thinking about it. ')
        .upd({
          sessionUpdate: 'tool_call',
          toolCallId: 'tc-p133',
          title: 'read_file',
          status: 'completed',
          rawInput: { path: '/p133/file.ts' },
        })
        .asst('p133 answer')
        .done().list,
    before: async (page) => {
      await page.route('**/session/*/idle-suggest-toggle', async (route) => {
        const req = route.request();
        if (req.method() === 'POST') {
          const body = req.postDataJSON() as { enabled?: unknown } | null;
          p133IdleOn = body?.enabled === true;
        }
        await route.fulfill({
          status: 200,
          contentType: 'application/json',
          body: JSON.stringify({
            sessionId: 'p133',
            available: true,
            enabled: p133IdleOn,
            globalEnabled: true,
            maxSuggestionsPerHour: 6,
            remainingThisHour: 6,
          }),
        });
      });
    },
    run: async ({ page, viewer }) => {
      await watch(page, viewer.sessionId);
      await waitForFrame(page, 6, 30_000);
      await page.waitForSelector('#composer', { state: 'visible' });
      await page.waitForFunction('curDirPath !== null && pastConvosCwd !== null');

      // The folder, planted under the harness root for the reason P129 gives.
      const root = harnessRuntimeRoot();
      const realHome = join(homedir(), '.qwen');
      expect(
        root !== realHome && !root.startsWith(realHome + '/'),
        `the harness root ${root} sits inside the real ${realHome}, so planting a folder there would write into a live home`,
      );
      const folder = join(root, 'p133-folder');
      mkdirSync(folder, { recursive: true });
      try {
        await page.evaluate(`browseTo(${JSON.stringify(folder)})`);
        await page.waitForFunction(`pastConvosCwd === ${JSON.stringify(folder)}`);

        // Each control changed the way the reader changes it: a real event on
        // the real element, so the page's own listener is what saves it.
        // #185: the filter is the List screen's search field, #past-filter.
        await page.evaluate(String.raw`(() => {
          const flt = document.getElementById('past-filter');
          flt.value = 'P133 Filter';
          flt.dispatchEvent(new Event('input', { bubbles: true }));
          const lang = document.getElementById('dictate-lang');
          lang.value = 'fr-FR';
          lang.dispatchEvent(new Event('change', { bubbles: true }));
          const auto = document.getElementById('dictate-autosend');
          auto.checked = true;
          auto.dispatchEvent(new Event('change', { bubbles: true }));
        })()`);

        // #184 (h1): the mode is a segmented control in the sheet the status
        // line opens; a tap on a segment drives the same select and handler.
        await openSheet(page);
        await page.waitForSelector('#footer-mode-persist');
        await page.check('#footer-mode-persist');
        await page.click('#session-footer .seg button[data-mode="yolo"]');
        await page.waitForFunction(
          `(JSON.parse(localStorage.getItem('qwen-rc:ui:approval-mode') || '{}'))[watchedSessionId] === 'yolo'`,
        );

        await page.waitForFunction(
          `!document.getElementById('idle-suggest-toggle').disabled`,
        );
        await page.evaluate(String.raw`(() => {
          const cb = document.getElementById('idle-suggest-toggle');
          cb.checked = true;
          cb.dispatchEvent(new Event('change'));
        })()`);
        await page.waitForFunction(
          `(JSON.parse(localStorage.getItem('qwen-rc:ui:idle-suggest') || '{}'))[watchedSessionId] === true`,
        );

        // A thought and a tool row opened by tapping them.
        await page.click('#transcript .thought-head');
        await page.click('#transcript .tool-head');
        const opened = (await page.evaluate(
          `transcriptModel.items.filter((i) => i.kind === 'thought' || i.kind === 'tool').map((i) => i.kind + ':' + !!i.expanded)`,
        )) as string[];
        expect(
          opened.includes('thought:true') && opened.includes('tool:true'),
          `tapping did not open the rows before the reload (${JSON.stringify(opened)})`,
        );

        // A panel screen opened, last. #184 retired the pins with the tab
        // bar, and #187 the panes, so the open panel screen is what comes back.
        await openPanel(page, 'usage');

        // The gateway forgets the idle switch, as a restart would.
        p133IdleOn = false;
        await reloadAndRestore(page, await rowCount(page));
        await page.waitForSelector('#footer-mode', { state: 'attached' });
        await page.waitForFunction(
          `!document.getElementById('idle-suggest-toggle').disabled`,
        );
        await page.waitForFunction(`curDirPath === ${JSON.stringify(folder)}`);
        await frames3(page);

        const got = (await page.evaluate(String.raw`(() => {
          const v = (id) => document.getElementById(id);
          const shown = document.querySelector('#panel-body > .panel:not([hidden])');
          return {
            tab: shown && v('panel-screen').getClientRects().length > 0 ? shown.dataset.panel : null,
            settingsShown: v('panel-usage').getClientRects().length > 0,
            paneHead: v('panel-back').getClientRects().length > 0 && v('panel-title').textContent === 'Usage and cost',
            moreUnder: !v('more-screen').hidden,
            lang: v('dictate-lang').value,
            autosend: v('dictate-autosend').checked,
            mode: v('footer-mode').value,
            persist: v('footer-mode-persist').checked,
            modeNote: v('footer-mode-note').textContent,
            idleChecked: v('idle-suggest-toggle').checked,
            idleStatus: v('idle-suggest-status').textContent,
            folder: curDirPath,
            railInput: document.getElementById('past-filter').value,
            railFilter: pastFilter,
            // Kept text has to be on show, or it hides rows for a reason the
            // reader cannot see.
            fieldShown: !document.getElementById('list-find').hidden,
            rows: transcriptModel.items
              .filter((i) => i.kind === 'thought' || i.kind === 'tool')
              .map((i) => i.kind + ':' + !!i.expanded),
          };
        })()`)) as Record<string, unknown>;

        const fails: string[] = [];
        const want = (ok: boolean, what: string) => {
          if (!ok) fails.push(what);
        };
        want(
          got['tab'] === 'usage' && got['settingsShown'] === true && got['paneHead'] === true && got['moreUnder'] === true,
          `panel screen ${got['tab']}, shown ${got['settingsShown']}, titled with a way back ${got['paneHead']}, over More ${got['moreUnder']}`,
        );
        want(got['lang'] === 'fr-FR', `dictation language ${got['lang']}`);
        want(got['autosend'] === true, 'auto-send unticked');
        // The daemon still reports default, and the select shows what the
        // session is in; the reader's last choice is named beside it.
        want(got['mode'] === 'default', `the mode select shows ${got['mode']}, not the daemon's default`);
        want(got['persist'] === true, 'the persist box came back unticked');
        want(String(got['modeNote']).includes('YOLO'), `the sheet does not name the mode last set here (${JSON.stringify(got['modeNote'])})`);
        want(got['idleChecked'] === false, 'the idle box shows the saved state over the gateway’s');
        want(String(got['idleStatus']).includes('last set here: on'), `the idle line does not name the state last set here (${JSON.stringify(got['idleStatus'])})`);
        want(got['folder'] === folder, `the folder is ${got['folder']}`);
        want(
          got['railInput'] === 'P133 Filter' && got['railFilter'] === 'p133 filter' && got['fieldShown'] === true,
          `the list's search is ${JSON.stringify(got['railInput'])} / ${JSON.stringify(got['railFilter'])}, field shown ${got['fieldShown']}`,
        );
        const rows = got['rows'] as string[];
        want(rows.includes('thought:true') && rows.includes('tool:true'), `the opened rows came back closed (${JSON.stringify(rows)})`);
        expect(fails.length === 0, `not restored: ${fails.join('; ')}`);

        // And they are open on screen, not only in the model.
        await openPanel(page, 'chat');
        await settlePage(page);
        const drawn = (await page.evaluate(String.raw`(() => {
          const body = document.querySelector('#transcript .thought-body');
          return {
            thought: !!body && !body.hidden && body.getClientRects().length > 0,
            tool: !!document.querySelector('#transcript .tool-detail'),
          };
        })()`)) as { thought: boolean; tool: boolean };
        expect(drawn.thought && drawn.tool, `the restored rows are not drawn open (${JSON.stringify(drawn)})`);
        return 'the open panel screen (over More), dictation language and auto-send, persist box, folder, the list’s search text (its field on show) and two opened rows came back; the mode control and the idle box show the daemon and gateway state and name the one last set here';
      } finally {
        rmSync(folder, { recursive: true, force: true });
      }
    },
  });

  PAGE_SCENARIOS.push({
    name: 'P134 a draft survives a reload, stays with the conversation it was typed for, and goes when it is sent',
    run: async ({ page, viewer }) => {
      const A = viewer.sessionId;
      const B = '22222222-3333-4444-5555-666666666666';
      const draft = () => page.inputValue('#prompt');
      const stored = () =>
        page.evaluate(
          `JSON.parse(localStorage.getItem('qwen-rc:ui:drafts') || '{}')`,
        ) as Promise<Record<string, string>>;
      const switchTo = async (id: string) => {
        await page.evaluate(
          `lastSeenEventId = null; void startWatch(${JSON.stringify(id)});`,
        );
        await page.waitForFunction(`watchedSessionId === ${JSON.stringify(id)}`);
      };

      await watch(page, A);
      await waitForFrame(page, 1, 30_000);
      await page.waitForSelector('#composer', { state: 'visible' });
      // Typed, so the page sees the input events a reader's keys make.
      await page.click('#prompt');
      await page.keyboard.type('half a thought for A');
      await reloadAndRestore(page, 0);
      await page.waitForSelector('#composer', { state: 'visible' });
      const back = await draft();
      expect(back === 'half a thought for A', `the draft did not survive the reload (${JSON.stringify(back)})`);

      // Another conversation has its own composer, and coming back finds the
      // first one's text where it was left.
      await switchTo(B);
      const onB = await draft();
      expect(onB === '', `conversation B opened with A's draft in the composer (${JSON.stringify(onB)})`);
      await page.click('#prompt');
      await page.keyboard.type('a note for B');
      await switchTo(A);
      const onA = await draft();
      expect(onA === 'half a thought for A', `switching back to A did not bring its draft back (${JSON.stringify(onA)})`);

      // Sent: gone from the composer and from storage, so a reload brings
      // nothing back to send twice. B's draft is untouched.
      await page.click('#send');
      await page.waitForFunction(`document.getElementById('prompt').value === ''`);
      const after = await stored();
      expect(!(A in after), `A's draft is still stored after the send (${JSON.stringify(after)})`);
      expect(after[B] === 'a note for B', `B's draft was lost (${JSON.stringify(after)})`);
      await reloadAndRestore(page, 0);
      await page.waitForSelector('#composer', { state: 'visible' });
      const reloaded = await draft();
      expect(reloaded === '', `the sent text came back as a draft after a reload (${JSON.stringify(reloaded)})`);
      return 'a typed draft came back after a reload, B opened empty and kept its own, A got its own back, and a send cleared it so a reload brought nothing back';
    },
  });

  // The row at the transcript's top edge: its place in the model's list, its
  // offset from the edge, and enough of it to name in a failure.
  type P135Top = { index: number; y: number; kind: string; text: string } | null;
  const readTop = (page: Page) =>
    page.evaluate(String.raw`(() => {
      const s = document.getElementById('transcript');
      const edge = s.getBoundingClientRect().top;
      let best = null;
      s.querySelectorAll('.vrow').forEach((r) => {
        const b = r.getBoundingClientRect();
        if (b.height > 0 && b.bottom - edge > 1 && (!best || b.top - edge < best.y)) {
          best = { id: Number(r.getAttribute('data-id')), y: b.top - edge };
        }
      });
      if (!best) return null;
      const items = transcriptModel.items;
      const index = items.findIndex((i) => i.id === best.id);
      const it = items[index] || {};
      return { index, y: Math.round(best.y), kind: it.kind || '', text: String(it.text || it.label || '').slice(0, 48) };
    })()`) as Promise<P135Top>;
  const P135_TURNS = 80;
  PAGE_SCENARIOS.push({
    name: 'P135 a reader scrolled up in a long transcript lands on the same row after a reload, and one at the end stays at the end',
    frames: () => replayFrames(P135_TURNS, 2),
    run: async ({ page, viewer }) => {
      await page.setViewportSize({ width: 390, height: 844 });
      const last = P135_TURNS * 7;
      await watch(page, viewer.sessionId);
      await waitForFrame(page, last, 60_000);
      await settlePage(page, 300);

      const rows = await rowCount(page);
      await page.evaluate(
        `(() => { const s = document.getElementById('transcript'); s.scrollTop = Math.round(s.scrollHeight * 0.4); })()`,
      );
      await settlePage(page, 400);
      const before = await readTop(page);
      expect(before !== null && before.index > 0, `no row at the top edge after scrolling up (${JSON.stringify(before)})`);
      // The save waits for the scrolling to stop.
      await page.waitForFunction(
        `!!(JSON.parse(localStorage.getItem('qwen-rc:ui:place') || '{}'))[watchedSessionId]`,
        null,
        { timeout: 5_000 },
      );

      await reloadAndRestore(page, rows);
      // Put back once the replay goes quiet, then measured once it settles.
      await page
        .waitForFunction(`transcriptView !== null && !transcriptView.isNearBottom()`, null, {
          timeout: 10_000,
        })
        .catch(() => undefined);
      await settlePage(page, 400);
      const after = await readTop(page);
      expect(
        after !== null && before !== null && Math.abs(after.index - before!.index) <= 1,
        `the reload landed on row ${after?.index} (${JSON.stringify(after)}), not within one row of ${before?.index} (${JSON.stringify(before)})`,
      );

      // A reader following the end keeps no place, so a reload lands at the
      // end as every load did before.
      await page.evaluate(
        `(() => { const s = document.getElementById('transcript'); s.scrollTop = s.scrollHeight; })()`,
      );
      await settlePage(page, 400);
      await page.waitForFunction(
        `!(JSON.parse(localStorage.getItem('qwen-rc:ui:place') || '{}'))[watchedSessionId]`,
        null,
        { timeout: 5_000 },
      );
      await reloadAndRestore(page, rows);
      await settlePage(page, 400);
      const end = (await page.evaluate(`__pg.gap()`)) as number;
      expect(end <= 2, `a reader at the end came back ${end}px short of it`);
      return `row ${before!.index} (${before!.kind}, ${before!.y}px from the edge) came back as row ${after!.index} (${after!.y}px) at 390x844 over ${P135_TURNS} turns; at the end it stayed at the end`;
    },
  });

  PAGE_SCENARIOS.push({
    name: 'P136 the web app manifest is served with its own type, installs standalone, and the page links it',
    waitView: false,
    run: async ({ page, viewer }) => {
      const at = `${viewer.url}/ui/manifest.webmanifest`;
      const res = await fetch(at);
      const type = res.headers.get('content-type') ?? '';
      expect(res.status === 200, `GET /ui/manifest.webmanifest answered ${res.status}`);
      expect(type.startsWith('application/manifest+json'), `the manifest is served as ${JSON.stringify(type)}`);
      const m = (await res.json()) as {
        name?: string;
        short_name?: string;
        display?: string;
        start_url?: string;
        scope?: string;
        theme_color?: string;
        background_color?: string;
        icons?: { src?: string; sizes?: string; type?: string }[];
      };
      expect(m.display === 'standalone', `display is ${JSON.stringify(m.display)}`);
      expect(m.name === 'qwen-rc' && m.short_name === 'qwen-rc', `named ${JSON.stringify([m.name, m.short_name])}`);
      expect(m.start_url === '/ui/' && m.scope === '/ui/', `start_url ${m.start_url}, scope ${m.scope}`);
      expect(m.theme_color === '#0d1117' && m.background_color === '#0d1117', `colours ${m.theme_color} / ${m.background_color}`);
      const icon = (m.icons ?? []).find((i) => i.type === 'image/svg+xml' && i.sizes === 'any');
      expect(!!icon && !!icon.src, `no scalable icon in ${JSON.stringify(m.icons)}`);
      const iconRes = await fetch(new URL(icon!.src!, at));
      const iconType = iconRes.headers.get('content-type') ?? '';
      expect(iconRes.status === 200 && iconType.startsWith('image/svg+xml'), `the icon answered ${iconRes.status} as ${iconType}`);
      expect((await iconRes.text()).includes('<svg'), 'the icon is not an SVG document');

      const head = (await page.evaluate(String.raw`(() => {
        const meta = (n) => {
          const el = document.querySelector('meta[name="' + n + '"]');
          return el ? el.getAttribute('content') : null;
        };
        const link = document.querySelector('link[rel="manifest"]');
        const touch = document.querySelector('link[rel="apple-touch-icon"]');
        return {
          manifest: link ? link.href : null,
          touch: touch ? touch.href : null,
          theme: meta('theme-color'),
          viewport: meta('viewport'),
          capable: meta('apple-mobile-web-app-capable'),
          statusBar: meta('apple-mobile-web-app-status-bar-style'),
        };
      })()`)) as Record<string, string | null>;
      expect(head['manifest'] === at, `the page links ${head['manifest']}, not ${at}`);
      expect(head['theme'] === '#0d1117', `theme-color is ${head['theme']}`);
      expect(String(head['viewport']).includes('viewport-fit=cover'), `the viewport is ${head['viewport']}`);
      expect(head['capable'] === 'yes' && head['statusBar'] === 'black-translucent', `apple metas ${head['capable']} / ${head['statusBar']}`);
      // #184. iOS ignores an SVG home-screen icon, so the page links a PNG
      // rendered from it at the 180px iOS asks for. Read off the wire: the
      // type the gateway serves it with and the size in the PNG's own header.
      expect(head['touch'] === `${viewer.url}/ui/apple-touch-icon.png`, `the page links ${head['touch']} as its apple-touch-icon`);
      const png = await fetch(`${viewer.url}/ui/apple-touch-icon.png`);
      const pngType = png.headers.get('content-type') ?? '';
      const bytes = Buffer.from(await png.arrayBuffer());
      const sig = bytes.subarray(1, 4).toString('latin1');
      const pw = bytes.readUInt32BE(16);
      const ph = bytes.readUInt32BE(20);
      expect(
        png.status === 200 && pngType.startsWith('image/png') && sig === 'PNG' && pw === 180 && ph === 180,
        `the touch icon answered ${png.status} as ${pngType}, ${sig} ${pw}x${ph}`,
      );
      return `${type}, display standalone, start_url and scope /ui/, an SVG icon served as ${iconType}; the page links it with theme-color, viewport-fit=cover and the apple metas, and a 180x180 PNG apple-touch-icon served as ${pngType}`;
    },
  });

  PAGE_SCENARIOS.push({
    name: 'P137 with the keyboard up the composer sits above it at 390, and the layout comes back when it goes',
    frames: () => {
      const f = new Frames().ev('client_joined');
      for (let k = 0; k < 14; k++) {
        f.user(`question ${k}: why does the nightly build fail on the arm64 runner?`);
        f.asst(`answer ${k}: the arm64 job pins an image without the native toolchain.`);
        f.done();
      }
      return f.list;
    },
    keyboard: true,
    run: async ({ page, viewer }) => {
      await page.setViewportSize({ width: 390, height: 844 });
      await watch(page, viewer.sessionId);
      await waitForFrame(page, 43, 30_000);
      await page.waitForSelector('#composer', { state: 'visible' });
      await settlePage(page);
      const KEYS = 336; // an iPhone keyboard with its suggestion bar
      const read = () =>
        page.evaluate(String.raw`(() => ({
          open: document.documentElement.classList.contains('kb-open'),
          appH: document.documentElement.style.getPropertyValue('--app-h'),
          composerBottom: Math.round(document.getElementById('composer').getBoundingClientRect().bottom),
          sendBottom: Math.round(document.getElementById('send').getBoundingClientRect().bottom),
          // #184: the transcript's own height. #175's fitted cap (--tx-cap)
          // is gone, so the box is what has to come back.
          cap: document.getElementById('transcript').clientHeight + 'px',
          visible: window.visualViewport.offsetTop + window.visualViewport.height,
        }))()`) as Promise<{ open: boolean; appH: string; composerBottom: number; sendBottom: number; cap: string; visible: number }>;
      const rest = await read();
      expect(!rest.open && rest.composerBottom <= 844, `before the keyboard: ${JSON.stringify(rest)}`);

      await page.focus('#prompt');
      await page.evaluate(`window.__kb(${KEYS})`);
      await page.waitForTimeout(150);
      await frames3(page);
      const up = await read();
      expect(up.open && up.appH === `${844 - KEYS}px`, `the shell did not take the visible height (${JSON.stringify(up)})`);
      expect(
        up.composerBottom <= up.visible + 1 && up.sendBottom <= up.visible + 1,
        `the composer's bottom is at ${up.composerBottom}px and Send at ${up.sendBottom}px, under the keyboard's top edge at ${up.visible}px`,
      );

      await page.evaluate(`window.__kb(0)`);
      await page.waitForTimeout(150);
      await frames3(page);
      const down = await read();
      expect(!down.open && down.appH === '', `the keyboard went and the shell kept its height (${JSON.stringify(down)})`);
      expect(
        down.cap === rest.cap && Math.abs(down.composerBottom - rest.composerBottom) <= 1,
        `the layout did not come back: transcript ${rest.cap} -> ${down.cap}, composer ${rest.composerBottom} -> ${down.composerBottom}`,
      );
      return `keyboard ${KEYS}px: shell ${up.appH}, transcript ${rest.cap} -> ${up.cap}, composer bottom ${rest.composerBottom} -> ${up.composerBottom} (Send ${up.sendBottom}) under a ${up.visible}px visible height; back to ${down.cap} / ${down.composerBottom} when it went`;
    },
  });

  // ---- #184 (h1): the chat shell -----------------------------------------
  // Read at 390x844 first, the phone the spec draws, through the controls a
  // reader uses. In-page code is a plain string wherever it names a helper:
  // the transform rewrites a named arrow in a callback into a __name(...) call
  // the page does not define.

  PAGE_SCENARIOS.push({
    name: 'P138 the status line names the state, model (or no model), fill and mode, and opens the sheet in place, where the mode buttons drive the mode handler',
    // #184. The drawer band and the status strip became one 44px line and a
    // sheet under it. The line is only worth its row if it says what the
    // conversation is doing, and the sheet only if it pushes the transcript
    // down rather than covering it and its mode buttons reach the same POST
    // the drawer's select made, once per change and never for a press on the
    // mode already in force.
    waitView: false,
    run: async ({ page, viewer }) => {
      await page.setViewportSize({ width: 390, height: 844 });
      const posted: { mode?: string; persist?: boolean }[] = [];
      page.on('request', (r) => {
        if (r.method() === 'POST' && /\/session\/[^/]+\/approval-mode$/.test(new URL(r.url()).pathname)) {
          posted.push(JSON.parse(r.postData() || '{}') as { mode?: string });
        }
      });
      await watch(page, viewer.sessionId);
      await page.waitForSelector('#composer', { state: 'visible' });
      await page.waitForFunction(`document.getElementById('session-footer').style.display !== 'none'`);
      await page.waitForFunction(`document.getElementById('h1-tokens').textContent !== ''`);
      type Line = {
        h: number;
        state: string;
        word: string;
        model: string;
        tokens: string;
        mode: string;
        dot: string;
        expanded: string;
        sheet: { shown: boolean; top: number; h: number };
        lineBottom: number;
        trTop: number;
        composerBottom: number;
        rows: string[];
        modes: { id: string; pressed: string }[];
        bar: boolean;
        keep: boolean;
        sel: string;
        focusOnLine: boolean;
      };
      const read = () =>
        page.evaluate(String.raw`(() => {
          const b = document.getElementById('h1-status');
          const line = document.getElementById('h1-statusline').getBoundingClientRect();
          const sheet = document.getElementById('h1-sheet');
          const sr = sheet.getBoundingClientRect();
          const t = (id) => (document.getElementById(id).textContent || '').trim();
          const sel = document.getElementById('footer-mode');
          return {
            h: Math.round(line.height),
            state: b.dataset.state,
            word: t('h1-state'),
            model: t('h1-model'),
            tokens: t('h1-tokens'),
            mode: t('h1-mode'),
            dot: getComputedStyle(b.querySelector('.dot')).backgroundColor,
            expanded: b.getAttribute('aria-expanded'),
            sheet: { shown: sheet.getClientRects().length > 0, top: Math.round(sr.top), h: Math.round(sr.height) },
            lineBottom: Math.round(line.bottom),
            trTop: Math.round(document.getElementById('transcript').getBoundingClientRect().top),
            composerBottom: Math.round(document.getElementById('composer').getBoundingClientRect().bottom),
            rows: Array.from(document.querySelectorAll('#session-footer .sh-lbl')).map((l) => l.textContent),
            modes: Array.from(document.querySelectorAll('#session-footer .seg button')).map((x) => ({ id: x.dataset.mode, pressed: x.getAttribute('aria-pressed') })),
            bar: !!document.querySelector('#session-footer .ctx-bar > div'),
            keep: !!document.querySelector('#session-footer .keep #footer-mode-persist'),
            sel: sel ? sel.value : '',
            focusOnLine: document.activeElement === b,
          };
        })()`) as Promise<Line>;

      const rest = await read();
      expect(rest.h === 45, `the status line is ${rest.h}px with its rule, not the 44px row the spec draws`);
      expect(
        rest.state === 'idle' && rest.word === 'idle' && rest.dot === 'rgb(63, 185, 80)',
        `an idle conversation reads ${rest.state} ${JSON.stringify(rest.word)} with a ${rest.dot} dot, not idle in green`,
      );
      // #190: the model field is a name or the words `no model`, never the old
      // parenthetical that cut to `(model …` at 390 (P188 holds both states).
      expect(
        rest.model !== '' && !rest.model.startsWith('(') && rest.mode !== '',
        `the line does not name the model (${JSON.stringify(rest.model)}) and the mode (${JSON.stringify(rest.mode)})`,
      );
      expect(rest.tokens === '65.5k/262.1k', `the line's fill reads ${JSON.stringify(rest.tokens)}, not the daemon's 65.5k/262.1k`);
      expect(!rest.sheet.shown && rest.expanded === 'false', 'the sheet is open at rest');

      await page.click('#h1-status');
      const open = await read();
      expect(open.sheet.shown && open.expanded === 'true', 'tapping the status line did not open the sheet');
      expect(open.sheet.top === open.lineBottom, `the sheet does not open in place under the line (sheet top ${open.sheet.top}, line bottom ${open.lineBottom})`);
      expect(
        open.trTop === rest.trTop + open.sheet.h,
        `the sheet covers the transcript instead of pushing it down (transcript top ${rest.trTop} -> ${open.trTop}, sheet ${open.sheet.h}px)`,
      );
      expect(open.composerBottom <= 844, `with the sheet open the composer bottom is ${open.composerBottom} in an 844px viewport`);
      for (const want of ['Model', 'Mode', 'Context', 'Folder on host']) {
        expect(open.rows.includes(want), `the sheet has no ${want} row (${JSON.stringify(open.rows)})`);
      }
      expect(open.bar && open.keep, `the sheet is missing the context bar (${open.bar}) or the keep-this-mode box (${open.keep})`);
      expect(open.modes.length > 1, `the mode control has ${open.modes.length} buttons`);
      const pressed = open.modes.filter((m) => m.pressed === 'true');
      expect(pressed.length === 1 && pressed[0]!.id === open.sel, `the pressed mode ${JSON.stringify(pressed)} is not the select's ${open.sel}`);

      // A segment drives the mode handler: one POST naming it, and the control
      // follows the daemon's answer.
      const target = open.modes.find((m) => m.pressed !== 'true')!.id;
      await page.click(`#session-footer .seg button[data-mode="${target}"]`);
      await page.waitForFunction(
        `document.querySelector('#session-footer .seg button[data-mode="${target}"]').getAttribute('aria-pressed') === 'true'`,
      );
      const after = await read();
      expect(
        posted.length === 1 && posted[0]!.mode === target,
        `the segment posted ${JSON.stringify(posted)}, not one approval-mode for ${target}`,
      );
      expect(after.sel === target && after.mode !== rest.mode, `the select reads ${after.sel} and the line ${after.mode} after the change`);
      // The mode in force is not a change, so it sends nothing.
      await page.click(`#session-footer .seg button[data-mode="${target}"]`);
      await page.waitForTimeout(300);
      expect(posted.length === 1, `pressing the mode already in force posted again (${posted.length})`);

      // Shut by Escape from inside it, back onto the line, and by the line.
      await page.focus(`#session-footer .seg button[data-mode="${target}"]`);
      await page.keyboard.press('Escape');
      const esc = await read();
      expect(!esc.sheet.shown && esc.focusOnLine && esc.expanded === 'false', `Escape did not shut the sheet onto the status line (${JSON.stringify({ shown: esc.sheet.shown, focus: esc.focusOnLine })})`);
      await page.click('#h1-status');
      await page.click('#h1-status');
      const shut = await read();
      expect(!shut.sheet.shown && shut.trTop === rest.trTop, 'the second tap did not shut the sheet and give the transcript its room back');
      return `idle in green, ${rest.model} · ${rest.tokens} · ${rest.mode}; the sheet opens in place (${open.sheet.h}px, transcript pushed down), ${open.modes.length} mode buttons, ${target} posted once and followed; Escape and the line shut it`;
    },
  });

  PAGE_SCENARIOS.push({
    name: 'P188 a conversation whose daemon names no model reads no model, muted and whole, on the status line at 390 and 360 and in the sheet’s Model row, and a named model reads its name in both',
    // #190, from slice 1: the line read `(model unknown until switched)`,
    // which cut to `(model …` at 390 and read as a broken name. The harness
    // daemon's context carries its model in a shape the page does not read
    // as a current model id, so the line starts with none named, which is
    // the state the phone was in; a model_switched frame then names one.
    waitView: false,
    run: async ({ page, viewer }) => {
      await page.setViewportSize(PHONE);
      await watch(page, viewer.sessionId);
      await page.waitForSelector('#composer', { state: 'visible' });
      await page.waitForFunction(`document.getElementById('session-footer').style.display !== 'none'`);
      await page.waitForFunction(`document.getElementById('h1-tokens').textContent !== ''`);
      type Model = { text: string; muted: boolean; color: string; tokColor: string; cut: boolean; right: number; vw: number; row: string | null; rowMuted: boolean; rowColor: string; old: boolean };
      const read = () =>
        page.evaluate(String.raw`(() => {
          const m = document.getElementById('h1-model');
          const t = document.getElementById('h1-tokens');
          const row = Array.from(document.querySelectorAll('#session-footer .sh-row')).find((r) => {
            const l = r.querySelector('.sh-lbl');
            return !!l && l.textContent === 'Model';
          });
          const v = row ? row.querySelector('.sh-lbl + *') : null;
          const all = document.getElementById('h1-status').textContent + ' ' + document.getElementById('session-footer').textContent;
          return {
            text: m.textContent,
            muted: m.classList.contains('none'),
            color: getComputedStyle(m).color,
            tokColor: getComputedStyle(t).color,
            cut: m.scrollWidth > m.clientWidth,
            right: Math.round(m.getBoundingClientRect().right),
            vw: innerWidth,
            row: v ? v.textContent : null,
            rowMuted: !!v && v.classList.contains('none'),
            rowColor: v ? getComputedStyle(v).color : '',
            old: /until switched|\(model/.test(all),
          };
        })()`) as Promise<Model>;
      const lines: string[] = [];
      let none: Model | null = null;
      for (const size of [PHONE, { width: 360, height: 780 }]) {
        await page.setViewportSize(size);
        const r = await read();
        expect(!r.old, `the parenthetical is still on the line or in the sheet at ${size.width}`);
        expect(r.text === 'no model' && r.muted, `with no model named the line reads ${JSON.stringify(r.text)} (muted ${r.muted}) at ${size.width}, not no model, muted`);
        expect(!r.cut && r.right <= r.vw, `no model is cut at ${size.width} (cut ${r.cut}, right ${r.right} of ${r.vw})`);
        expect(r.color !== r.tokColor, `no model is drawn in the fill's ${r.color}, so it does not read as muted`);
        expect(r.row === 'no model' && r.rowMuted, `the sheet's Model row reads ${JSON.stringify(r.row)} (muted ${r.rowMuted}), not no model, muted`);
        lines.push(`${size.width}: "${r.text}" in ${r.color} (the fill ${r.tokColor}), whole, ending at ${r.right}px`);
        if (size.width === 390) await shot(page, 'p188-status-no-model-390');
        none = r;
      }
      await page.setViewportSize(PHONE);
      await page.evaluate(`renderFrame({ type: 'model_switched', data: { modelId: 'openai/qwen3-coder:30b' } })`);
      const named = await read();
      expect(
        named.text === 'qwen3-coder:30b' && !named.muted && named.color === named.tokColor,
        `a named model reads ${JSON.stringify(named.text)} (muted ${named.muted}, ${named.color}) on the line, not its name in the line's ink`,
      );
      expect(
        named.row === 'openai/qwen3-coder:30b' && !named.rowMuted && named.rowColor !== none!.rowColor,
        `the sheet's Model row reads ${JSON.stringify(named.row)} (muted ${named.rowMuted}) once a model is named`,
      );
      return `${lines.join('; ')}; the sheet's Model row no model in ${none!.rowColor}; after model_switched the line reads ${named.text} and the row ${named.row} in ${named.rowColor}`;
    },
  });

  PAGE_SCENARIOS.push({
    name: 'P139 the ⋯ menu holds the conversation actions, by pointer and by keyboard, offers Rename and End session only while it is open, and End session asks first',
    // #184. The verbs that sat in the composer row as symbols, the drawer's
    // export and the recap and side-question buttons are items in one menu.
    // Each item is the control that did the job before, so pressing it is the
    // old handler; the claims are that the menu is reachable and operable,
    // that it offers only what can act on what is on screen, and that ending
    // a session still asks first (the harness dismisses the ask).
    waitView: false,
    stub: { capabilitiesFeatures: ['session_recap', 'session_btw'] },
    run: async ({ page, viewer }) => {
      await page.setViewportSize({ width: 390, height: 844 });
      const HERE = viewer.sessionId;
      const TITLE = 'p139 the one on screen';
      const ended: string[] = [];
      page.on('request', (r) => {
        if (r.method() === 'POST' && new URL(r.url()).pathname.endsWith('/end')) ended.push(r.url());
      });
      const asked: { type: string; message: string }[] = [];
      page.on('dialog', (d) => asked.push({ type: d.type(), message: d.message() }));
      await watch(page, HERE);
      await page.waitForSelector('#composer', { state: 'visible' });
      await page.waitForFunction(
        `!document.getElementById('recap-toggle').hidden && !document.getElementById('btw-toggle').hidden && pastConvosCwd !== null`,
      );
      await page.waitForTimeout(300);
      const plant = (live: boolean) =>
        page.evaluate(
          `renderPastConversations([{ sessionId: ${JSON.stringify(HERE)}, title: ${JSON.stringify(TITLE)}, live: ${live} }], pastConvosCwd, false)`,
        );
      type MenuReading = { open: boolean; items: string[]; focus: string; expanded: string; bg: string; inView: boolean };
      const readMenu = () =>
        page.evaluate(String.raw`(() => {
          const m = document.getElementById('h1-menu');
          const r = m.getBoundingClientRect();
          const a = document.activeElement;
