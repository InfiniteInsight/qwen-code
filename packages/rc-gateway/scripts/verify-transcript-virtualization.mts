    expect(rows.length > 0, `${label}: the card paints no text`);
    let worst = Infinity;
    for (const row of rows) worst = Math.min(worst, pgShellCheck(row, label));
    return `${rows.length} text rows, worst ${worst.toFixed(2)}:1`;
  };
