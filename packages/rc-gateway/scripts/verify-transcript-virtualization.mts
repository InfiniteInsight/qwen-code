  view: VtView;
  loadCore(): Promise<string>;
  setup(virtual: boolean): void;
  addTurns(n: number, chars: number, seed: number): void;
  addMdTurns(n: number, seed: number): void;
  addLineTurns(n: number, lines: number): void;
