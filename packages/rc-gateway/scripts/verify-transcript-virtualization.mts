/**
 * #189 (h1). The sizes the page section reads at, in the spec's order: 390x844
 * is the primary set, then the keyboard open over it (KEYBOARD_OPEN, below),
 * then 360x780, the narrowest phone the spec draws (named in the size lists
 * of the scenarios that hold the fold, legibility, overflow and the card to
 * it), then 1280x810, the check that the laptop layout still derives from the
 * phone (#188). PHONE is what a scenario that sets no size runs at:
 * runPageScenario sets it before the page loads, so the load itself is a
 * phone's, and a scenario whose claim is about the laptop asks for LAPTOP by
 * name.
 */
const PHONE = { width: 390, height: 844 };
const LAPTOP = { width: 1280, height: 810 };

/**
 * #189 (h1). The keyboard-open state: a phone keyboard with its suggestion
 * bar over PHONE leaves a 390x480 visible viewport, and the composer and a
 * pinned card have to work inside it. No headless browser raises a keyboard,
 * so a scenario that sets `keyboard` gets KEYBOARD_JS installed before the
 * page's own script runs: a stand-in visualViewport (the property is
 * [Replaceable]) that reports the window less what the keys cover and fires
 * the resize the page listens for, the way P137 first faked it. The page's
 * own handler does the rest, so nothing here moves the layout itself.
 */
const KEYBOARD_OPEN = { width: 390, height: 480 };
/** What the keys cover of PHONE to leave KEYBOARD_OPEN visible: 364px. */
const KEYBOARD_KEYS = PHONE.height - KEYBOARD_OPEN.height;
const KEYBOARD_JS = String.raw`
(function () {
  var fake = new EventTarget();
  var covered = 0;
  Object.defineProperties(fake, {
    height: { get: function () { return window.innerHeight - covered; } },
    width: { get: function () { return window.innerWidth; } },
    offsetTop: { value: 0 },
    offsetLeft: { value: 0 },
    pageTop: { get: function () { return window.scrollY; } },
    pageLeft: { value: 0 },
    scale: { value: 1 },
  });
  window.__kb = function (px) {
    covered = px;
    fake.dispatchEvent(new Event('resize'));
  };
  try { window.visualViewport = fake; } catch (e) { /* defined below */ }
  if (window.visualViewport !== fake) {
    Object.defineProperty(window, 'visualViewport', { value: fake, configurable: true });
  }
})();
`;
/** Three frames, so whatever the last event queued has been laid out. */
async function frames3(page: Page): Promise<void> {
  await page.evaluate(
    'new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(() => requestAnimationFrame(r))))',
  );
}
/**
 * Raises the keyboard: focuses what a reader would have tapped to raise it
 * (the composer's field unless told otherwise), then has the keys cover
 * `keys` px of the window. Returns the visible height left.
 */
async function keyboardUp(
  page: Page,
  keys = KEYBOARD_KEYS,
  focus = '#prompt',
): Promise<number> {
  await page.focus(focus);
  await page.evaluate(`window.__kb(${keys})`);
  await page.waitForTimeout(150);
  await frames3(page);
  return (await page.evaluate(
    'window.visualViewport.offsetTop + window.visualViewport.height',
  )) as number;
}
/** Puts the keyboard away and lets the layout come back. */
async function keyboardDown(page: Page): Promise<void> {
  await page.evaluate('window.__kb(0)');
  await page.waitForTimeout(150);
  await frames3(page);
}

/**
 * #188 (h1). At 1100px and wider the page is the laptop layout derived from
 * the phone: the List screen is a 280px pane on the left that never shuts (so
 * its back button is not drawn), the chat column is capped at 80ch and centred
 * in what is left, and the sheet, More and a panel open as one 320px pane on
 * the right. LAPTOP is in it; PHONE, the default since #189, is not, so a
 * scenario that leaves the viewport alone reads the phone layout.
 */
const PANE_MIN = 1100;
const LEFT_PANE = 280;
const RIGHT_PANE = 320;
/** Back from the List screen where it has a way back; the pane has none. */
async function closeList(page: Page): Promise<void> {
  if (await page.isVisible('#list-back')) await page.click('#list-back');
}

/**
 * #190. With SHOTS naming a directory, a scenario saves the state it has just
 * checked there as `<name>.png`, so a reviewer can look at what was asserted;
 * unset, nothing is written and the run is unchanged.
 */
async function shot(page: Page, name: string): Promise<void> {
  const dir = process.env['SHOTS'];
  if (!dir) return;
  mkdirSync(dir, { recursive: true });
  await page.screenshot({ path: join(dir, `${name}.png`) });
}

/**
 * #185. Serves `rows.list` as the conversations of `cwd` and moves the page's
 * list there through its own refresh. Rows drawn by calling
 * renderPastConversations do not last: the load's own browse can land after
 * them, and a watch, a resume or an Unwatch refreshes the list from the
 * gateway (#35), which reads the harness folder's empty listing. Served, every
 * one of those reads the same rows back. Change `rows.list` and call
 * `refreshPastConversations` to move them.
 */
async function serveList(
  page: Page,
  cwd: string,
  rows: { list: Record<string, unknown>[] },
): Promise<void> {
  await page.waitForFunction('curDirPath !== null && pastConvosCwd !== null');
  await page.route(
    (u) =>
      u.pathname === '/rc/sessions' &&
      u.searchParams.get('cwd') === cwd &&
      !u.searchParams.has('archiveState'),
    (route) =>
      route.fulfill({
        status: 200,
        contentType: 'application/json',
        body: JSON.stringify({ sessions: rows.list, truncated: false }),
      }),
  );
  await page.evaluate(
    `curDirPath = ${JSON.stringify(cwd)}; refreshPastConversations(${JSON.stringify(cwd)})`,
  );
  await page.waitForFunction(
    `pastConvosCwd === ${JSON.stringify(cwd)} && pastConvos.length >= ${rows.list.length}`,
  );
}

/** Polls until the page has seen frame `lastId`; returns the elapsed ms. */
async function waitForFrame(
  page: Page,
  lastId: number,
  timeoutMs: number,
): Promise<number> {
  const t0 = Date.now();
  for (;;) {
    const got = await page.evaluate(() => lastSeenEventId);
    if (got !== null && got >= lastId) return Date.now() - t0;
    if (Date.now() - t0 > timeoutMs) {
      throw new Error(
        `replay stalled at frame ${got} of ${lastId} after ${timeoutMs} ms`,
      );
    }
    await page.waitForTimeout(250);
  }
}

async function settlePage(page: Page, minMs = 200): Promise<void> {
  const ok = await page.evaluate((ms) => __pg.settle(ms), minMs);
  expect(ok, 'transcript did not settle within 5 s');
}

/**
 * A transcript script failed to load: #transcript shows a visible "reload"
 * note, and the page's other UI initialized (app shown after the auth check,
 * the pair button wired, a panel screen opens and closes (#187), frames are
 * handled without errors).
 */
async function checkTranscriptMissing(
  page: Page,
  viewer: Viewer,
): Promise<string> {
  const note = () =>
    page.evaluate(() => {
      const t = document.getElementById('transcript')!;
      return {
        text: t.textContent ?? '',
        shown: t.getClientRects().length > 0,
      };
    });
  try {
    await page.waitForFunction(
      () =>
        /reload/i.test(
          document.getElementById('transcript')!.textContent ?? '',
        ),
      null,
      { timeout: 10_000 },
    );
  } catch {
    throw new Error(
      `no failure note in #transcript: ${JSON.stringify((await note()).text)}`,
    );
  }
  await page.waitForFunction(
    () => !document.getElementById('app-body')!.hidden,
    null,
    { timeout: 10_000 },
  );
  const ui = await page.evaluate(() => ({
    pairWired:
      typeof (document.getElementById('pair') as HTMLButtonElement).onclick ===
      'function',
  }));
  expect(ui.pairWired, 'pair button not wired');
  await openPanel(page, 'diag');
  const diag = await page.evaluate(
    () => document.getElementById('panel-diag')!.getClientRects().length > 0,
  );
  expect(diag, 'the Diagnostics screen did not open');
  await openPanel(page, 'chat');
  await watch(page, viewer.sessionId);
  await waitForFrame(page, 5 * 7, 30_000);
  const n = await note();
  expect(n.shown, '#transcript not shown on the Chat tab');
  expect(/reload/i.test(n.text), 'failure note gone after the watch');
  return `note ${JSON.stringify(n.text)}; a panel screen and frames work`;
}

interface Growth {
  turns: number;
  finished: boolean;
  replayMs: number;
  transcriptNodes: number;
  totalNodes: number;
  perChunkMs: number;
  perChunkFrameMs: number;
  jsHeapMb: number;
  rendererRssMb: number;
}

async function measureGrowth(turns: number): Promise<Growth> {
  const { stdout } = await execFileAsync('npx', ['tsx', VIEWER_SCRIPT], {
    cwd: PKG_DIR,
    env: { ...process.env, TURNS: String(turns) },
    maxBuffer: 16 * 1024 * 1024,
    timeout: 900_000,
  });
  const at = stdout.indexOf('{');
  expect(at >= 0, `no JSON from ${VIEWER_SCRIPT} at ${turns} turns`);
  return JSON.parse(stdout.slice(at)) as Growth;
}

const P1_TURNS = 5000;

// The sample P32 sends: heading, emphasis, inline code, a list, a fenced block,
// raw HTML, a hostile link target, and one real link. The fence ticks are built
// rather than typed so this string stays free of backticks.
function mdFrames(): Frame[] {
  const tick = String.fromCharCode(96);
  const fence = tick.repeat(3);
  const f = new Frames();
  f.user('make **this** bold');
  f.asst(
    [
      '# Heading',
      '',
      'Body with **bold** and ' + tick + 'code' + tick + '.',
      '',
      '- one',
      '- two',
      '',
      fence + 'js',
      'const a = 1;',
      fence,
      '',
      '<img src=x onerror=alert(1)>',
      '',
      '[bad](javascript:alert(1)) [good](https://example.com/a)',
    ].join('\n'),
  );
  return f.done().list;
}

