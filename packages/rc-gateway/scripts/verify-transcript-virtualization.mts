      // settled that chat-side queueing is its own control and not an inverted
      // Send, so the composer legitimately carries a Queue button beside its
      // Send (it is hidden outside a turn, because a queue button in idle view
      // is a Send that does not send). The ruling this guards is narrower than
      // "no queue control in the composer" and it is about Send: adding a
      // mid-turn writer must not have turned Send into something else, since
      // two other scenarios press Send during a turn and assert it is disabled.
      expect(
        placed.chatSendLabel === 'Send',
        `the composer's Send button no longer reads Send (${JSON.stringify(placed.chatSendLabel)})`,
      );
      expect(
        placed.chatSendDisabled === false,
        `the composer's Send is disabled between turns (${JSON.stringify(placed.chatSendDisabled)})`,
      );
      expect(
        placed.outboxExists && placed.outboxHidden === true,
        `the #70 outbox control is no longer a separate button hidden outside a turn (${JSON.stringify(
          { exists: placed.outboxExists, hidden: placed.outboxHidden },
        )})`,
      );
      return `the write control sits under Operations; Send reads ${JSON.stringify(
        placed.chatSendLabel,
      )} enabled and the outbox is hidden=${placed.outboxHidden}`;
    },
  });

PAGE_SCENARIOS.push({
    name: 'P115 a window that joined another window says so, and a window on its own pointer does not',
    waitView: false,
    run: async ({ page, viewer }) => {
      // Window A takes the harness conversation and holds it. The frame is the
      // gate rather than watchedSessionId, for the reason P26 records: the id is
      // assigned before the replay clears the transcript, so only a frame proves
      // the hand-off finished and the watch was persisted.
      await watch(page, viewer.sessionId);
      await waitForFrame(page, 1, 30_000);

      const note = (p: Page) =>
        p.evaluate(() => {
          const box = document.getElementById('joined-note') as HTMLDivElement;
          const btn = document.getElementById(
            'joined-note-new',
          ) as HTMLButtonElement;
          return {
            id: watchedSessionId,
            hidden: box.hidden,
            shown: box.getClientRects().length > 0,
            text: document.getElementById('joined-note-text')!.textContent ?? '',
            hasBtn: !!btn,
          };
        });

      // Window B, same browser context: it shares A's localStorage and token and
      // gets no sessionStorage. That is the second-window case exactly, and B is
      // NOT told which conversation to open, because being told would be the
      // thing under test.
      const b = await page.context().newPage();
      try {
        // #189: a second phone, as runPageScenario sizes the first.
        await b.setViewportSize(PHONE);
        await b.addInitScript({ content: PAGE_HELPERS_JS });
        await b.goto(`${viewer.url}/ui/`, { waitUntil: 'domcontentloaded' });
        await b.waitForFunction(() => typeof startWatch === 'function');
        await b.waitForFunction(() => watchedSessionId !== null, null, {
          timeout: 20_000,
        });
        // The join note is asked for after the restore, so give the probe its
        // budget before reading. It is 250 ms and this waits for it to have
        // resolved, not for a fixed sleep.
        await b.waitForFunction(
          () => !document.getElementById('joined-note')!.hidden,
          null,
          { timeout: 5_000 },
        );
        const joined = await note(b);
        expect(
          joined.id === viewer.sessionId,
          `the second window did not come up on the shared conversation (got ${JSON.stringify(
            joined.id,
          )}, wanted ${viewer.sessionId})`,
        );
        expect(
          joined.shown,
          'the join note is not on screen for a window that joined a live sibling',
        );
        expect(
          /joined/i.test(joined.text),
          `the join note does not say the window joined (${JSON.stringify(
            joined.text,
          )})`,
        );
        expect(joined.hasBtn, 'the join note carries no way out');

        // The way out has to hand the folder to the SHIPPED create path, not a
        // second one. The create handler is intercepted so nothing is actually
        // created; what is asserted is that the note typed the folder the page
        // restored into the input New conversation reads.
        const handed = await b.evaluate(() => {
          const btn = document.getElementById('new-session') as HTMLButtonElement;
          const input = document.getElementById(
            'new-session-cwd',
          ) as HTMLInputElement;
          const prior = input.value;
          let clicked = false;
          const prev = btn.onclick;
          btn.onclick = () => {
            clicked = true;
          };
          (document.getElementById('joined-note-new') as HTMLButtonElement).click();
          const seen = input.value;
          btn.onclick = prev;
          input.value = prior;
          return { clicked, seen, want: watchedSessionCwd ?? '' };
        });
        expect(
          handed.clicked,
          'the join note does not run the shipped New conversation path',
        );
        expect(
          handed.seen === handed.want,
          `the join note handed the wrong folder to New conversation (${JSON.stringify(
            handed.seen,
          )}, wanted ${JSON.stringify(handed.want)})`,
        );

        // The control. B now holds its OWN per-window pointer, so a reload of B
        // is a window coming back to a conversation it chose, never a join. An
        // implementation that said "you joined" on every restore would pass
        // every assertion above and fail this one.
        await b.reload({ waitUntil: 'domcontentloaded' });
        await b.waitForFunction(() => typeof startWatch === 'function');
        await b.waitForFunction(() => watchedSessionId !== null, null, {
          timeout: 20_000,
        });
        await b.waitForTimeout(600);
        const back = await note(b);
        expect(
          back.hidden,
          `a window restored onto its own pointer was told it joined another window (${JSON.stringify(
            back.text,
          )})`,
        );
        expect(
          back.id === viewer.sessionId,
          `the reload lost B's conversation (${JSON.stringify(back.id)})`,
        );

        return `a fresh window on the shared record says it joined and hands the folder to New conversation; the same window on its own pointer says nothing`;
      } finally {
        await b.close();
      }
    },
  });

PAGE_SCENARIOS.push({
    // #67. A host terminal was requested on create and on nothing else, so the
    // laptop kept mirroring the conversation you happened to create while the
    // phone had moved on. This asserts the switch now asks, and it asserts the
    // half that is easy to get wrong: the same function is also the #39 resync
    // self-heal, reached from startWatch's finally with no user behind it, so a
    // request wired in unconditionally would open a tab on every recovery.
    name: 'P116 a conversation switch asks for a host terminal, and a resync recovery does not',
    run: async ({ page, viewer }) => {
      const OTHER = '33333333-4444-5555-6666-777777777777';
      const HELD = '44444444-5555-6666-7777-888888888888';
      const DIR = '/srv/work/proj';

      await watch(page, viewer.sessionId);
      await waitForFrame(page, 1, 30_000);

      // Recorded rather than merely fulfilled: the claim is that this tap put a
      // request on the wire carrying the conversation the tap selected, and only
      // the body can tell the two conversations apart.
      const asked: string[] = [];
      await page.route('**/rc/terminals', (route) => {
        const body = route.request().postData() ?? '{}';
        asked.push(String(JSON.parse(body).sessionId ?? ''));
        route.fulfill({
          status: 202,
          contentType: 'application/json',
          body: JSON.stringify({
            requestId: 'r1',
            launcherState: 'live',
            launcherSeenMsAgo: 400,
          }),
        });
      });
      const answers = (id: string) =>
        JSON.stringify({ sessionId: id, lastEventId: 0 });
      for (const id of [OTHER, HELD]) {
        await page.route(`**/session/${id}/resume`, (route) =>
          route.fulfill({
            status: 200,
            contentType: 'application/json',
            body: answers(id),
          }),
        );
      }

      // The list is drawn through the same entry point a real load uses, so the
      // List screen's rows are populated the way they are on the page rather
      // than by hand.
      await page.evaluate(
        ([here, other, dir]) => {
          renderPastConversations(
            [
              { sessionId: here, title: 'here' },
              { sessionId: other, title: 'there' },
            ],
            dir,
            false,
          );
        },
        [viewer.sessionId, OTHER, DIR],
      );
      const listed = await page.evaluate(
        (id) => !!document.querySelector(`#past-list .s[data-session="${id}"]`),
        OTHER,
      );
      expect(listed, `the list has no row for ${OTHER}, so the tap below could not have switched to it`);

      const responded = page.waitForResponse(
        (r) => r.url().includes('/rc/terminals'),
        { timeout: 15_000 },
      );
      // Driven through the control, not by calling the hand-off: the bug was a
      // missing call on a path, so the assertion has to travel that path.
      await page.evaluate((id) => {
        const row = document.querySelector(
          `#past-list .s[data-session="${id}"]`,
        ) as HTMLButtonElement;
        row.click();
      }, OTHER);
      await responded;
      expect(
        asked.length === 1 && asked[0] === OTHER,
        `switching to ${OTHER} asked the host for ${JSON.stringify(asked)}`,
      );

      // The other half, and the one that makes the flag load-bearing. This is
      // the exact call the resync self-heal makes, positional and unflagged,
      // reached when a watch tears down with a resync pending. An
      // implementation that asked on every hand-off would satisfy the
      // assertion above and fail here.
      asked.length = 0;
      await page.evaluate(
        ([id, dir]) => {
          void resumeConversation(id, dir, 'held');
        },
        [HELD, DIR],
      );
      await page.waitForTimeout(1_500);
      expect(
        asked.length === 0,
        `the unflagged hand-off asked the host for a terminal (${JSON.stringify(
          asked,
        )}), which is a tab opening on every resync recovery`,
      );

      // And the flag still works when the hand-off is reached directly, so the
      // guard is the option rather than the rail's own wiring.
      asked.length = 0;
      const again = page.waitForResponse(
        (r) => r.url().includes('/rc/terminals'),
        { timeout: 15_000 },
      );
      await page.evaluate(
        ([id, dir]) => {
          void resumeConversation(id, dir, 'held', { hostTerminal: true });
        },
        [HELD, DIR],
      );
      await again;
      expect(
        asked.length === 1 && asked[0] === HELD,
        `the flagged hand-off asked the host for ${JSON.stringify(asked)}`,
      );

      return `a list row tap asks for the conversation it selected; the unflagged hand-off the resync self-heal uses asks for nothing; the flagged one asks`;
    },
  });

  // #133. The side question is a new composer control, and the two ways it can
  // be wrong are the two ways this page has already been filed for: a strip
  // that carries layout height nobody asked for (it pushed the composer under
  // the fold on a phone, #65), and an answer painted for the wrong
  // conversation. P62 and P63 established both assertions for the recap
  // control; this drives the same shapes through the new one.
  const BTW_ANSWER =
    'it skipped a row because the offset was computed before the filter';
  const BTW_QUESTION = 'why did the last run skip a row';

  PAGE_SCENARIOS.push({
    name: 'P117 the side question asks the watched conversation and bounds its answer',
    waitView: false,
    stub: { capabilitiesFeatures: ['session_btw'] },
    run: async ({ page, viewer }) => {
      const A = viewer.sessionId;
      const asked: { path: string; question: string }[] = [];
      await page.route(/\/session\/[^/]+\/btw$/, async (route) => {
        const path = new URL(route.request().url()).pathname;
        let question = '';
        try {
          const parsed = JSON.parse(route.request().postData() ?? '{}') as {
            question?: unknown;
          };
          question = String(parsed.question ?? '');
        } catch {
          question = '';
        }
        asked.push({ path, question });
        await route.fulfill({
          status: 200,
          contentType: 'application/json',
          body: JSON.stringify({ sessionId: A, answer: BTW_ANSWER }),
        });
      });

      await watch(page, A);
      await page.waitForSelector('#composer', { state: 'visible' });
      // Markup from boot, hidden until the daemon's own feature list says
      // asking would work, so becoming un-hidden is the gate firing. #184:
      // the control is an item in the ⋯ menu, so it is on screen only while
      // the menu is open; the gate is read off its attribute.
      await page.waitForFunction(`!document.getElementById('btw-toggle').hidden`);

      // No inner helper here on purpose: a function declared inside the
      // callback gets an esbuild keepNames wrapper that does not exist in the
      // browser, and the whole evaluate dies with "__name is not defined".
      const before = await page.evaluate(() => {
        const panel = document.getElementById('btw-panel');
        const box = document.getElementById('btw');
        return {
          panel: panel
            ? { hidden: panel.hidden, height: panel.offsetHeight }
            : null,
          box: box ? { hidden: box.hidden, height: box.offsetHeight } : null,
        };
      });
      expect(
        before.panel !== null && before.box !== null,
        'the side-question control is missing from the page',
      );
      expect(
        before.panel?.hidden === true && before.panel?.height === 0,
        `the side-question panel already costs layout height before anyone asked (${JSON.stringify(before.panel)})`,
      );
      expect(
        before.box?.hidden === true && before.box?.height === 0,
        `the answer box already costs layout height before anyone asked (${JSON.stringify(before.box)})`,
      );

      await openMenu(page);
      await page.click('#btw-toggle');
      await page.waitForSelector('#btw-question', { state: 'visible' });
      await page.fill('#btw-question', BTW_QUESTION);
      await page.click('#btw-ask');

      const shown = await page.waitForFunction(
        (needle) => {
          const el = document.getElementById('btw');
          const t = el ? (el.textContent ?? '') : '';
          return t.includes(needle) ? t : null;
        },
        BTW_ANSWER,
        { timeout: 15_000 },
      );
      const onScreen = (await shown.jsonValue()) as string;

      expect(
        asked.length === 1,
        `one press sent ${asked.length} questions; a side question costs a model call, so a double-send is a double spend`,
      );
      expect(
        asked[0]?.path === `/session/${A}/btw`,
        `the page asked ${JSON.stringify(asked[0]?.path)} while watching ${JSON.stringify(A)}`,
      );
      // The operator's own words, unchanged. A control that rewrote the
      // question would make the answer impossible to re-ask.
      expect(
        asked[0]?.question === BTW_QUESTION,
        `the daemon received ${JSON.stringify(asked[0]?.question)} rather than the typed question`,
      );

      const height = await page.evaluate(
        () => document.getElementById('btw')?.offsetHeight ?? -1,
      );
      expect(
        height > 0 && height <= 160,
        `the open answer box is not bounded (${height} px)`,
      );
      return `the question is asked of the watched conversation and reads ${JSON.stringify(onScreen)} in a ${height}px box`;
    },
  });

  PAGE_SCENARIOS.push({
    name: 'P118 a daemon that cannot answer side questions is offered no control that could only fail',
    waitView: false,
    run: async ({ page, viewer }) => {
      let asked = 0;
      await page.route(/\/session\/[^/]+\/btw$/, async (route) => {
        asked += 1;
        await route.fulfill({
          status: 404,
          contentType: 'application/json',
          body: JSON.stringify({ error: 'Not Found' }),
        });
      });

      await watch(page, viewer.sessionId);
      await page.waitForSelector('#composer', { state: 'visible' });
      // The harness advertises no daemon features here, which is the state of a
      // daemon from before this route existed.
      const offered = await page.evaluate(() => {
        const b = document.getElementById('btw-toggle');
        return b ? { present: true, hidden: b.hidden } : { present: false };
      });
      expect(
        offered.present === true && offered.hidden === true,
        `the page showed a side-question control to a daemon that has no btw route (${JSON.stringify(offered)})`,
      );
      expect(
        asked === 0,
        'a control that is not on screen still asked the daemon a side question',
      );
      return `with no session_btw tag the control stays hidden (${JSON.stringify(offered)}) and nothing was asked`;
    },
  });

  // #134. A checkout handover is the one conversation control that changes
  // WHICH conversation owns the work, so the two things that would be wrong
  // are specific: a control that fires on a single tap (the move cannot be
  // undone from a phone), and a screen that keeps showing a conversation which
  // no longer has the checkout. P117/P118 established the layout-height and
  // capability-gate assertions for the side-question control; these drive the
  // same shapes through this one, plus the two-press gate that #125 established
  // as the house pattern for a destructive control, because this verifier
  // dismisses every dialog unconditionally and a confirm() gate could never be
  // driven here.
  const WT_REPLACEMENT = 'aaaaaaaa-1111-2222-3333-444444444444';

  PAGE_SCENARIOS.push({
    name: 'P119 a checkout handover warns on the first press and moves the screen on the second',
    waitView: false,
    stub: { capabilitiesFeatures: ['session_worktree_reset_v1'] },
    run: async ({ page, viewer }) => {
      const A = viewer.sessionId;
      const sent: string[] = [];
      await page.route(/\/session\/[^/]+\/worktree-reset$/, async (route) => {
        sent.push(new URL(route.request().url()).pathname);
        await route.fulfill({
          status: 200,
          contentType: 'application/json',
          body: JSON.stringify({
            sessionId: WT_REPLACEMENT,
            supersededSessionId: A,
