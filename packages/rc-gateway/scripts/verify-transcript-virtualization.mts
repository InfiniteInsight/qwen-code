  | { name: string; standalone: () => Promise<string> };

const VIEWER_SCRIPT = 'scripts/measure-viewer-growth.mts';
const TRANSCRIPT_ASSET =
  /\/ui\/(transcript-model\.js|transcript-view\.js|vendor\/virtual-core\.js|vendor\/markdown-it\.js)$/;
