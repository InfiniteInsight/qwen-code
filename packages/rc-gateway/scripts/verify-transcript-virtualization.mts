  const streamsOf = (page: Page, id: string): string[] => {
    const seen: string[] = [];
    page.on('request', (r) => {
      if (new URL(r.url()).pathname === `/session/${id}/events`) seen.push(r.url());
    });
    return seen;
  };
  const json = (route: Route, body: unknown, status = 200): Promise<void> =>
