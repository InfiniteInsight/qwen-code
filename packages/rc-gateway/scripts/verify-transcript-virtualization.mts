    expect(
      paned.join(',') === [0, 0, LEFT_PANE, LAPTOP.height].join(','),
      `at ${LAPTOP.width}x${LAPTOP.height} Archived did not open over the list in its ${LEFT_PANE}px pane (${paned.join(',')})`,
    );
    await page.click('#archived-back');
