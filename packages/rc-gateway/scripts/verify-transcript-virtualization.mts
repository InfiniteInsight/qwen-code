          // after so the next width starts the same.
          await page.click(`#list-folders [role="menuitemradio"][data-folder="${t.b.folder}"]`);
          const picked = await fit(`${w}x${h} one folder`);
          expect(picked.line !== null, `the folder line did not name the folder picked at ${w}x${h}`);
          // Only the picked folder's two rows are under it.
          check(picked, wantW, 2);
          await page.click('#list-folder');
          await page.click(`#list-folders [role="menuitemradio"][data-folder=""]`);
          lines.push(`${w}x${h}: list ${wantW}px, 4 rows of 64px with folder, host and second line inside, long paths cut from the start with the last folder showing, the folder line the same with one folder picked, the menu ${menuBox.left}-${menuBox.right}`);
          await closeList(page);
        }
        return lines.join('; ');
      } finally {
        t.cleanup();
        const root = harnessRuntimeRoot();
        rmSync(join(root, LONG_A), { recursive: true, force: true });
        rmSync(join(root, LONG_B), { recursive: true, force: true });
      }
    },
  });

  PAGE_SCENARIOS.push({
    name: 'P186 a refresh reads at most six folders, all at once, each with its live snapshot (spawn=0 for all but the current one), and the filter, the search, the folder menu and opening the list read nothing',
    waitView: false,
    run: async ({ page }) => {
      await page.waitForFunction('curDirPath !== null && pastConvosCwd !== null');
      // The 30 s poll is the refresh the list always had, and it would read
      // too; held off so what is counted below is one refresh and then the
      // views' own reads.
      await page.evaluate('clearInterval(pastConvosPollId); pastConvosPollId = null;');
      const current = (await page.evaluate('curDirPath')) as string;
      // Seven stored recent folders: more than the page ever stores (five),
      // so the cap at six reads is the page's and not the store's.
      const recent = Array.from({ length: 7 }, (_, i) => `/home/evan/p186-${i}`);
      const reads: { cwd: string; at: number }[] = [];
      // #190: every folder's snapshot is read now, the current one by the
      // read that may start its daemon and the others with spawn=0.
      const live: { cwd: string; spawn: string | null; at: number }[] = [];
      const archived: string[] = [];
      page.on('request', (r) => {
        const u = new URL(r.url());
        if (u.pathname === '/rc/sessions') {
          if (u.searchParams.has('archiveState')) archived.push(u.searchParams.get('cwd') ?? '');
          else reads.push({ cwd: u.searchParams.get('cwd') ?? '', at: Date.now() });
        }
        if (u.pathname === '/rc/sessions/live-state') live.push({ cwd: u.searchParams.get('workspace') ?? '', spawn: u.searchParams.get('spawn'), at: Date.now() });
      });
      let firstAnswer = Infinity;
      await page.route(
        (u) => u.pathname === '/rc/sessions' && (u.searchParams.get('cwd') ?? '').startsWith('/home/evan/p186-'),
        async (route) => {
          const cwd = new URL(route.request().url()).searchParams.get('cwd')!;
          // Held, so a page reading one folder after another would show it
          // as requests spread over several holds.
          await new Promise((r) => setTimeout(r, 400));
          firstAnswer = Math.min(firstAnswer, Date.now());
          const n = cwd.slice(-1);
          await route.fulfill({
            status: 200,
            contentType: 'application/json',
            body: JSON.stringify({
              sessions: route.request().url().includes('archiveState')
                ? []
                : [{ sessionId: `a1860000-0000-4000-8000-00000000000${n}`, title: `p186 in ${n}`, updatedAt: new Date(Date.now() - Number(n) * 60_000).toISOString() }],
              truncated: false,
            }),
          });
        },
      );
      await page.evaluate(`localStorage.setItem('qwen-rc-workspaces', ${JSON.stringify(JSON.stringify(recent))})`);
      reads.length = 0;
      live.length = 0;
      await page.evaluate('refreshPastConversations(curDirPath)');
      const one = reads.slice();
      const wantRead = [current, ...recent.slice(0, 5)];
      expect(
        one.length === 6 && JSON.stringify(one.map((r) => r.cwd).sort()) === JSON.stringify(wantRead.slice().sort()),
        `one refresh read ${one.length} folders (${JSON.stringify(one.map((r) => r.cwd))}), not the current one and the first five recent`,
      );
      expect(
        Math.max(...one.map((r) => r.at)) < firstAnswer,
        `the folders were read one after another rather than all at once (last read sent ${Math.max(...one.map((r) => r.at)) - firstAnswer}ms after the first answer)`,
      );
      const liveRead = (c: string) => live.filter((l) => l.cwd === c);
      expect(
        live.length === 6 && wantRead.every((c) => liveRead(c).length === 1),
        `the live snapshot was read ${live.length} times (${JSON.stringify(live.map((l) => [l.cwd, l.spawn]))}), not once for each of the six folders`,
      );
      expect(
        liveRead(current)[0]!.spawn === null && wantRead.filter((c) => c !== current).every((c) => liveRead(c)[0]!.spawn === '0'),
        `the snapshots were not the spawning read for the current folder and spawn=0 for the rest (${JSON.stringify(live.map((l) => [l.cwd, l.spawn]))})`,
      );
      expect(
        Math.max(...live.map((l) => l.at)) < firstAnswer,
        'the live snapshots were read one after another rather than beside the listings',
      );
      const rows = (await page.evaluate('pastConvos.length')) as number;
      expect(rows === 5, `the five read recent folders' rows are not all listed (${rows})`);
      // A gateway that does not say it honours spawn=0 would start a daemon
      // for each folder asked about (the page is served from disk and can be
      // newer than the process), so without the word only the current
      // folder's snapshot is read, as before #190.
      await page.evaluate('caps.remoteControl.liveStateNoSpawn = undefined');
      live.length = 0;
      await page.evaluate('refreshPastConversations(curDirPath)');
      const unsaid = live.map((l) => [l.cwd, l.spawn]);
      await page.evaluate('caps.remoteControl.liveStateNoSpawn = true');
      expect(
        JSON.stringify(unsaid) === JSON.stringify([[current, null]]),
        `with the gateway silent on spawn=0 the snapshots read were ${JSON.stringify(unsaid)}, not the current folder's alone`,
      );

      // The views read from what is kept: opening the list, the folder menu,
      // a pick and All again, a search and putting it away, shutting and
      // opening again. Archived (n) is read when the list opens, across the
      // six folders at most.
      reads.length = 0;
      archived.length = 0;
      await page.setViewportSize(PHONE);
      await openList(page);
      await page.click('#list-folder');
      await page.click(`#list-folders [role="menuitemradio"][data-folder="${recent[2]}"]`);
      const picked = (await page.evaluate(`document.querySelectorAll('#past-list .srow').length`)) as number;
      await page.click('#list-folder');
      await page.click('#list-folders [role="menuitemradio"][data-folder=""]');
      await page.click('#list-search');
      await page.keyboard.type('p186');
      await page.keyboard.press('Escape');
      await closeList(page);
      await openList(page);
      await page.waitForTimeout(600);
      expect(picked === 1, `picking a folder showed ${picked} rows, not its one`);
      expect(reads.length === 0, `the views read ${reads.length} folders (${JSON.stringify(reads.map((r) => r.cwd))}) rather than drawing from what was read`);
      // Archived (n) reads the filed half when the list opens and when the
      // view changes, over the same six folders and never the ones past
      // the cap.
      const outside = archived.filter((c) => !wantRead.includes(c));
      expect(
        archived.length > 0 && outside.length === 0,
        `Archived (n) read ${archived.length} archived listings, ${outside.length} of them outside the six folders (${JSON.stringify(outside)})`,
      );
      await closeList(page);
      return `one refresh read the current folder and the first five of seven stored recent ones, ${one.length} reads all sent before the first answer, each beside its live snapshot (the current folder's the spawning read, the five others spawn=0), and the current folder's alone when the gateway does not say it honours spawn=0; the five recent folders' rows listed; opening the list, the folder menu, a pick and back, a search and two opens read no folder listing (Archived (n) read ${archived.length} archived listings, all within the six folders)`;
    },
  });

  // #190 (from #193): a row in a folder other than the current one had no
  // live dot and no Rename, because the only live read started a daemon for
  // a folder without one. The other folders now read with spawn=0, which a
  // daemon the gateway already runs answers and a folder with none answers
  // empty. Run on a real daemon pool (bootViewer's `pool`), each spawned
  // daemon naming its folder's first planted conversation as open, so what is
  // counted is the pool's own: what it holds and what it has spawned.
  const P189_OPEN = (base: string) => ({
    sessionId: `${base}-4000-8000-000000000001`,
    clientCount: 1,
    hasActivePrompt: false,
    isWaitingForPermission: false,
    isWaitingForUserQuestion: false,
    updatedAt: new Date().toISOString(),
  });
  PAGE_SCENARIOS.push({
    name: 'P189 a row in another folder carries the live dot and Rename while a daemon the gateway already runs has it open, a folder with no daemon shows none and gets no daemon, and the pool holds the same daemons after the refresh as before it',
    waitView: false,
    stub: {
      pool: {
        liveState: (cwd: string) => ({
          v: 1,
          catalogVersion: { generation: 'g-p189', revision: 1 },
          sessions: cwd.endsWith('/p189-alpha')
            ? [P189_OPEN('a1890000-000a')]
            : cwd.endsWith('/p189-beta')
              ? [P189_OPEN('a1890000-000b')]
              : [],
        }),
      },
    },
    run: async ({ page, viewer }) => {
      const pool = viewer.pool!;
      // Alpha is browsed to (the current folder), beta and gamma are recent.
      // Beta will have a daemon running before the refresh that is counted,
      // gamma never does.
      const a = plantFolder('p189-alpha', ['p189 alpha open', 'p189 alpha past'], 'a1890000-000a');
      const b = plantFolder('p189-beta', ['p189 beta open', 'p189 beta past'], 'a1890000-000b');
      const c = plantFolder('p189-gamma', ['p189 gamma past'], 'a1890000-000c');
      try {
        await page.waitForFunction('curDirPath !== null && pastConvosCwd !== null');
        // Held off, as in P186, so the refresh counted below is the only one.
        await page.evaluate('clearInterval(pastConvosPollId); pastConvosPollId = null;');
        await spanFolders(page, a.folder, [b.folder, c.folder], 5);
        // A daemon for beta, started the way the current folder's read starts
        // one, as working in that folder would have.
        const seeded = (await page.evaluate(
          `fetch('/rc/sessions/live-state?workspace=' + encodeURIComponent(${JSON.stringify(b.folder)}), { headers: { Authorization: 'Bearer ' + token() } }).then((r) => r.status)`,
        )) as number;
        const before = { held: pool.workspaces().slice().sort(), spawned: pool.spawned.slice() };
        expect(
          seeded === 200 && before.held.includes(a.folder) && before.held.includes(b.folder) && !before.held.includes(c.folder),
          `the pool does not hold alpha and beta and not gamma before the refresh (seed ${seeded}, ${JSON.stringify(before.held)})`,
        );

        const live: { cwd: string; spawn: string | null }[] = [];
        page.on('request', (r) => {
          const u = new URL(r.url());
          if (u.pathname === '/rc/sessions/live-state') live.push({ cwd: u.searchParams.get('workspace') ?? '', spawn: u.searchParams.get('spawn') });
        });
        await page.evaluate('refreshPastConversations(curDirPath)');
        await page.waitForFunction(`pastConvos.some((s) => s.sessionId === ${JSON.stringify(b.ids[0])} && s.live)`, null, { timeout: 10_000 });
        const after = { held: pool.workspaces().slice().sort(), spawned: pool.spawned.slice() };
        expect(
          JSON.stringify(after) === JSON.stringify(before),
          `the refresh changed the pool (${JSON.stringify(before)} -> ${JSON.stringify(after)})`,
        );
        const reads = (f: string) => live.filter((l) => l.cwd === f).map((l) => l.spawn);
        expect(
          JSON.stringify(reads(a.folder)) === '[null]' && JSON.stringify(reads(b.folder)) === '["0"]' && JSON.stringify(reads(c.folder)) === '["0"]',
          `the refresh's live reads were ${JSON.stringify(live)}, not one each, the spawning one for alpha alone`,
        );

        await page.setViewportSize(PHONE);
        await openList(page);
        type Row = { id: string; title: string; dot: boolean; label: string | null; dir: string | null };
        const rows = (await page.evaluate(String.raw`Array.from(document.querySelectorAll('#past-list .srow')).map((w) => {
          const d = w.querySelector('.s .dot');
          const dir = w.querySelector('.s .dir');
          return { id: w.dataset.session, title: (w.querySelector('.tt') || {}).textContent, dot: !!d, label: d ? d.getAttribute('aria-label') : null, dir: dir ? dir.title : null };
        })`)) as Row[];
        const dotted = rows.filter((r) => r.dot).map((r) => r.id).sort();
        expect(
          rows.length === 5 && JSON.stringify(dotted) === JSON.stringify([a.ids[0], b.ids[0]].sort()),
          `the dots sit on ${JSON.stringify(rows.filter((r) => r.dot).map((r) => r.title))} of ${rows.length} rows, not on alpha's open one and beta's open one alone`,
        );
        expect(
          rows.filter((r) => r.dot).every((r) => r.label === 'open') && rows.find((r) => r.id === b.ids[0])!.dir === b.folder,
          `a dot is not named open, or beta's open row is not in beta (${JSON.stringify(rows)})`,
        );
        await shot(page, 'p189-list-dots-two-folders-390');

        const menuOf = async (id: string): Promise<string[]> => {
          await page.click(`#past-list .srow[data-session="${id}"] > .more`);
          const items = (await page.evaluate(
            String.raw`Array.from(document.querySelectorAll('#list-menu [role="menuitem"]')).map((b) => b.textContent)`,
          )) as string[];
          await page.keyboard.press('Escape');
          return items;
        };
        const openMenu = await menuOf(b.ids[0]!);
        const pastMenu = await menuOf(b.ids[1]!);
        const coldMenu = await menuOf(c.ids[0]!);
        expect(openMenu.includes('Rename'), `beta's open row offers no Rename (${JSON.stringify(openMenu)})`);
        expect(!pastMenu.includes('Rename') && !coldMenu.includes('Rename'), `a row no daemon has open offers Rename (${JSON.stringify({ pastMenu, coldMenu })})`);
        await closeList(page);
        return `the pool held ${JSON.stringify(before.held.map((f) => f.split('/').pop()))} before and after the refresh with ${after.spawned.length} spawns either side, gamma never; the refresh read alpha's snapshot by the spawning read and beta's and gamma's with spawn=0; dots on alpha's and beta's open rows only, beta's open row offering ${JSON.stringify(openMenu)}, its past row and gamma's row no Rename`;
      } finally {
        a.cleanup();
        b.cleanup();
        c.cleanup();
      }
    },
  });
}

// #186 (h1). The permission and question cards, pinned between the transcript
// and the composer: the full command in a box that scrolls, Allow and Deny in
// the thumb zone, every option the daemon offers on a button, the vote bodies
// the strip card sent, Always allow writing its overlay before it votes, the
// question card paging, the status line's amber word and the field's
// placeholder, a request raised in the background on screen as soon as the
// return's first read lands, a push deep link landing on the card, and a
// mangled link no longer showing the pairing gate. Read at 390x844 first, then
// 360x780 and 1280x810. In-page code is a plain string throughout: the
// transform rewrites a named arrow in a callback into a __name(...) call the
// page does not define.
{
  // A 2 KB command whose last words are a marker, so a preview, an ellipsis
  // or a dropped tail all show as the marker missing.
  const BIG_CMD = (() => {
    const unit =
      'gh api repos/InfiniteInsight/qwen-code/actions/caches --paginate --jq ".actions_caches[] | select(.key | startswith(\\"node-alpine\\")) | .id" | xargs -n1 -I{} gh api -X DELETE repos/InfiniteInsight/qwen-code/actions/caches/{} && ';
    let s = '';
    while (s.length < 2048) s += unit;
    return s + 'echo END-OF-COMMAND';
  })();
  const DESC = 'Deletes every alpine Actions cache in the repo.';
  // The option list the qwen daemon sends for a shell call
  // (acp-integration/session/permissionUtils.ts toPermissionOptions 'exec').
  type Opt = { optionId: string; name: string; kind: string };
  const EXEC_OPTIONS: Opt[] = [
    { optionId: 'proceed_always_project', name: 'Always Allow in project: gh api', kind: 'allow_always' },
    { optionId: 'proceed_always_user', name: 'Always Allow for user: gh api', kind: 'allow_always' },
    { optionId: 'proceed_once', name: 'Allow', kind: 'allow_once' },
    { optionId: 'cancel', name: 'Reject', kind: 'reject_once' },
  ];
  const QUESTION_OPTIONS: Opt[] = [
    { optionId: 'proceed_once', name: 'Submit', kind: 'allow_once' },
    { optionId: 'cancel', name: 'Cancel', kind: 'reject_once' },
  ];
  const permFrame = (requestId: string, command: string, kind = 'execute', options = EXEC_OPTIONS) => ({
    requestId,
    toolCall: {
      toolCallId: 'tc-' + requestId,
      title: command.slice(0, 60),
      kind,
      rawInput: { command, description: DESC },
    },
    options,
  });
  const permPending = (requestId: string, command: string, kind = 'execute', options = EXEC_OPTIONS) => ({
    requestId,
    kind: 'permission',
    createdAt: '2026-10-28T09:00:00.000Z',
    action: { type: kind, title: command.slice(0, 60), input: { command, description: DESC } },
    options: options.map((o) => ({ optionId: o.optionId, label: o.name, kind: o.kind })),
  });
  const QUESTIONS = [
    {
      header: 'Caches',
      question: 'Which caches should go?',
      multiSelect: false,
      options: [
        { label: 'Only the nine alpine layer caches', description: '1.2 GB' },
        { label: 'Everything, the npm caches rebuild in a minute', description: '1.9 GB' },
        { label: 'Nothing, leave them to expire', description: 'Keeps the stale layers until GitHub evicts them after a week' },
      ],
    },
    {
      header: 'Branch',
      question: 'Which branch should the cleanup run on?',
      multiSelect: false,
      options: [
        { label: 'main', description: 'default' },
        { label: 'release/0.9', description: '' },
      ],
    },
  ];
  const questionFrame = (requestId: string) => ({
    requestId,
    toolCall: { toolCallId: 'tc-' + requestId, title: 'ask_user_question', kind: 'other', rawInput: { questions: QUESTIONS } },
    options: QUESTION_OPTIONS,
  });
  const questionPending = (requestId: string) => ({
    requestId,
    kind: 'user_question',
    createdAt: '2026-10-28T09:00:00.000Z',
    questions: QUESTIONS,
    options: QUESTION_OPTIONS.map((o) => ({ optionId: o.optionId, label: o.name, kind: o.kind })),
  });
  const statusBody = (pending: unknown[]) => ({
    workspaceCwd: '/proj',
    clientCount: 1,
    hasActivePrompt: true,
    pendingInteractions: pending,
  });
  // The daemon's own status read, answering what is still pending as the
  // scenario votes: a request leaves the list once its vote lands, the way
  // the daemon drops it, so the page's 5s poll neither retires a card early
  // nor draws an answered one again.
  const serveStatus = async (page: Page, pending: Map<string, unknown>): Promise<void> => {
    await page.route(/\/session\/[^/]+\/status$/, (route) =>
      route.fulfill({
        status: 200,
        contentType: 'application/json',
        body: JSON.stringify(statusBody([...pending.values()])),
      }),
    );
  };
  // Every vote the page sends, as the bytes it put on the wire.
  const recordVotes = (page: Page): Array<{ requestId: string; body: string; at: number }> => {
    const votes: Array<{ requestId: string; body: string; at: number }> = [];
    page.on('request', (r) => {
      const m = /\/permission\/([^/?]+)$/.exec(new URL(r.url()).pathname);
      if (!m || r.method() !== 'POST') return;
      votes.push({ requestId: decodeURIComponent(m[1]!), body: r.postData() ?? '', at: Date.now() });
    });
    return votes;
  };
  // The gateway's record of its policy decision for a request, which is
  // where the card's why line reads it from (the frame carries none). The
  // harness gateway evaluates nothing, so the route plays the record.
  const serveDecision = async (page: Page, rows: Array<{ requestId: string; decisionSource: string; ruleId?: string }>): Promise<void> => {
    await page.route(/\/rc\/audit\?/, (route) => {
      if (new URL(route.request().url()).searchParams.get('action') !== 'policy_decision') return route.continue();
      return route.fulfill({
        status: 200,
        contentType: 'application/json',
        body: JSON.stringify(
          rows.map((r, i) => ({
            ts: 1_800_000_000_000 - i,
            action: 'policy_decision',
            detail: { requestId: r.requestId, action: 'prompt', tool: 'execute', voted: false, decisionSource: r.decisionSource, reason: r.decisionSource === 'default' ? 'default' : 'rule-prompt', ...(r.ruleId ? { ruleId: r.ruleId } : {}) },
          })),
        ),
      });
    });
  };
  const pinnedId = (page: Page) =>
    page.evaluate(`(() => { const c = document.querySelector('#cards .pcard:not([hidden]):not(.retiring)'); return c ? c.dataset.requestId : null; })()`) as Promise<string | null>;
  const waitPinned = (page: Page, requestId: string, timeout = 15_000) =>
    page.waitForFunction(
      `(() => { const c = document.querySelector('#cards .pcard:not([hidden]):not(.retiring)'); return !!c && c.dataset.requestId === ${JSON.stringify(requestId)}; })()`,
      null,
      { timeout },
    );
  // The card behind an answered one pins as soon as the answer lands, not
  // when the answered card's 6s confirmation ends: under half of that.
  const NEXT_PIN_MS = 2_500;
  const waitVote = async (votes: Array<{ requestId: string }>, requestId: string, page: Page) => {
    for (let i = 0; i < 100 && !votes.some((v) => v.requestId === requestId); i++) await page.waitForTimeout(50);
    expect(votes.some((v) => v.requestId === requestId), `no vote went out for ${requestId}`);
  };
  // Where the pinned card and its controls are, in viewport pixels.
  const READ_CARD = String.raw`(() => {
    const r = (el) => {
      if (!el || el.getClientRects().length === 0) return null;
      const b = el.getBoundingClientRect();
      return { top: b.top, bottom: b.bottom, left: b.left, right: b.right, h: b.height, w: b.width };
    };
    const card = document.querySelector('#cards .pcard:not([hidden]):not(.retiring)');
    const q = (s) => (card ? card.querySelector(s) : null);
    const vv = window.visualViewport;
    return {
      vw: innerWidth,
      vh: innerHeight,
      visible: vv ? vv.offsetTop + vv.height : innerHeight,
      card: r(card),
      allow: r(q('.pc-allow')),
      deny: r(q('.pc-deny')),
      answer: r(q('.pc-answer')),
      cancel: r(q('.pc-cancel')),
      composer: r(document.getElementById('composer')),
      wrap: r(document.getElementById('transcript-wrap')),
      plan: r(document.getElementById('plan')),
      scrollY: window.scrollY,
    };
  })()`;
  type Box = { top: number; bottom: number; left: number; right: number; h: number; w: number } | null;
  type CardRead = {
    vw: number; vh: number; visible: number; card: Box; allow: Box; deny: Box; answer: Box; cancel: Box;
    composer: Box; wrap: Box; plan: Box; scrollY: number;
  };
  const readCard = (page: Page) => page.evaluate(READ_CARD) as Promise<CardRead>;
  // The thumb zone at a size: the button's centre, where a thumb lands, inside
  // the bottom 120px, its bottom edge in it too, and nothing but the card's
  // own padding between the row and the composer under it.
  const inThumbZone = (c: CardRead, a: Box, b: Box, label: string): string => {
    expect(!!a && !!b && !!c.composer, `${label}: the card's buttons are not on screen (${JSON.stringify(c)})`);
    for (const [name, x] of [['first', a!], ['second', b!]] as const) {
      const mid = (x.top + x.bottom) / 2;
      expect(x.h >= 48, `${label}: the ${name} button is ${x.h}px tall, under 48`);
      expect(c.vh - mid <= 120 && c.vh - x.bottom <= 120, `${label}: the ${name} button's centre is ${Math.round(c.vh - mid)}px and its bottom ${Math.round(c.vh - x.bottom)}px from the bottom, outside the 120px thumb zone`);
