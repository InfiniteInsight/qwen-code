        `with the keyboard up (and the sheet and tools open) the composer bottom is ${kb.bottom} and Send ${kb.sendBottom}, under the keyboard's top edge at ${kb.visible}`,
      );
      await page.evaluate(`window.__kb(0)`);
      await page.click('#h1-status');
      await page.click('#h1-plus');
      return `transcript ${rest.trH}px at rest with the strip folded; composer bottom ${rest.bottom} at rest, ${sheet.bottom} sheet open, ${tools.bottom} tools open, ${both.bottom} both, ${kb.bottom} with a ${KEYS}px keyboard over a ${kb.visible}px visible height (transcript ${kb.trH}px there)`;
    },
  });

  PAGE_SCENARIOS.push({
    name: 'P146 a queued message is the outbox bubble, queued · sends after this turn, with send now handing it to the running turn and drop discarding it',
    // #70's queue, drawn as the spec's outbox bubble. Send now has to mean
    // something while Send is held for the turn, so it hands the text to the
    // turn that is running through the mid-turn route Operations already
    // uses; it leaves the queue only when the daemon says it holds it.
    stub: { promptDelayMs: 12_000 },
    run: async ({ page, viewer }) => {
      await page.setViewportSize({ width: 390, height: 844 });
      const handed: string[] = [];
      await page.route(/\/session\/[^/]+\/mid-turn-message$/, async (route) => {
        handed.push((JSON.parse(route.request().postData() || '{}') as { message?: string }).message ?? '');
        await route.fulfill({ status: 200, contentType: 'application/json', body: JSON.stringify({ accepted: true, messageId: 'p146-1' }) });
      });
      await watch(page, viewer.sessionId);
      await page.waitForSelector('#composer', { state: 'visible' });
      await page.fill('#prompt', 'the turn is running');
      await page.click('#send');
      await page.fill('#prompt', 'queued while busy');
      await page.click('#queue');
      type Bubble = { shown: boolean; text: string; note: string; style: string; right: number; composerRight: number; buttons: string[] };
      const read = () =>
        page.evaluate(String.raw`(() => {
          const q = document.getElementById('queued');
          const t = document.getElementById('queued-text');
          return {
            shown: q.getClientRects().length > 0,
            text: t.textContent,
            note: document.getElementById('queued-note').textContent,
            style: getComputedStyle(t).borderTopStyle,
            right: Math.round(t.getBoundingClientRect().right),
            composerRight: Math.round(document.getElementById('composer').getBoundingClientRect().right),
            buttons: Array.from(q.querySelectorAll('button')).filter((b) => b.getClientRects().length > 0).map((b) => b.textContent),
          };
        })()`) as Promise<Bubble>;
      const q = await read();
      expect(q.shown && q.text === 'queued while busy', `the queued message is not shown waiting (${JSON.stringify(q)})`);
      expect(q.note === 'queued · sends after this turn', `the bubble says ${JSON.stringify(q.note)}`);
      expect(q.style === 'dashed' && q.composerRight - q.right <= 12, `the bubble is not the dashed outbox at the right (${q.style}, right ${q.right} of ${q.composerRight})`);
      expect(q.buttons.join(',') === 'send now,drop', `the bubble offers ${JSON.stringify(q.buttons)}`);

      await page.click('#queued-now');
      await page.waitForFunction(`document.getElementById('queued').hidden`);
      const left = (await page.evaluate('outbox.length')) as number;
      expect(handed.length === 1 && handed[0] === 'queued while busy' && left === 0, `send now handed ${JSON.stringify(handed)} and left ${left} queued`);

      await page.fill('#prompt', 'a second thought');
      await page.click('#queue');
      await page.click('#queued-discard');
      const dropped = (await page.evaluate(`({ hidden: document.getElementById('queued').hidden, n: outbox.length })`)) as { hidden: boolean; n: number };
      expect(dropped.hidden && dropped.n === 0 && handed.length === 1, `drop left ${JSON.stringify(dropped)} and handed ${handed.length}`);
      return `the dashed bubble reads ${JSON.stringify(q.note)} with send now and drop; send now handed it to the running turn and emptied the queue; drop discarded the next one`;
    },
  });

  PAGE_SCENARIOS.push({
    name: 'P147 a refused message says not sent under its bubble with a retry that sends the same text again, and never over a draft',
    // #62's marker, with the spec's retry beside it. Retry goes through Send
    // with the refused text, so it is one more ordinary send, and it refuses
    // to take a draft the reader has started, by the rule the queue's drain
    // keeps.
    stub: { promptStatus: 503 },
    run: async ({ page, viewer }) => {
      await page.setViewportSize({ width: 390, height: 844 });
      const prompts: string[] = [];
      page.on('request', (r) => {
        if (r.method() === 'POST' && new URL(r.url()).pathname.endsWith('/prompt')) {
          prompts.push((JSON.parse(r.postData() || '{}') as { prompt?: string }).prompt ?? '');
        }
      });
      await watch(page, viewer.sessionId);
      await page.waitForSelector('#composer', { state: 'visible' });
      await page.fill('#prompt', 'do the thing');
      await page.click('#send');
      await page.waitForFunction(`transcriptModel.items.some((i) => i.kind === 'user' && i.notSent)`);
      await settlePage(page);
      const marker = (await page.evaluate(String.raw`(() => {
        const row = Array.from(document.querySelectorAll('#transcript .bubble.user')).find((b) => b.querySelector('.not-sent:not([hidden])'));
        const retry = row ? row.querySelector('.retry') : null;
        if (retry) retry.setAttribute('data-p147', 'retry');
        return {
          note: row ? row.querySelector('.not-sent').textContent : '',
          retry: !!retry && retry.getClientRects().length > 0,
        };
      })()`)) as { note: string; retry: boolean };
      expect(marker.note.startsWith('not sent: ') && marker.retry, `the refused bubble reads ${JSON.stringify(marker)}`);

      // Over a draft, retry says why and sends nothing.
      await page.fill('#prompt', 'a draft');
      await page.click('[data-p147="retry"]');
      await page.waitForTimeout(200);
      const status = (await page.evaluate(`document.getElementById('status').textContent`)) as string;
      expect(prompts.length === 1 && /clear it to retry/.test(status), `retry over a draft sent ${prompts.length} or said ${JSON.stringify(status)}`);

      await page.fill('#prompt', '');
      await page.click('[data-p147="retry"]');
      for (let i = 0; i < 30 && prompts.length < 2; i++) await page.waitForTimeout(100);
      expect(prompts.length === 2 && prompts[1] === 'do the thing', `retry sent ${JSON.stringify(prompts)}`);
      return `the refused bubble reads ${JSON.stringify(marker.note)} with retry; over a draft it said ${JSON.stringify(status)}; with the composer empty it sent the same text again`;
    },
  });
}

// #185 (h1). The List screen: the title opens it at every width, a row resumes
// that conversation and comes back to the chat, its search filters the rows,
// Archived (n) opens the filed half with restore, New conversation here starts
// one in the folder it shows, the rows scroll under a thumb-zone button that
// does not move, ⌘K opens it with the search focused, and every row and its
// menu are reachable from the keyboard. #193 (P182 on): the rows span the
// current folder and the recent ones, each naming its folder, the folder line
// filters them, and New conversation opens the folder screen, where Start here
// starts one in the folder chosen. In-page code is a plain string throughout:
// the transform rewrites a named arrow in a callback into a __name(...) call
// the page does not define.
{
  // Plants `titles.length` transcripts in a folder of the scenario's own under
  // the harness root, the way P127 and P132 do, and refuses first if the root
  // is the real ~/.qwen. Returns the folder, its chats dir and the ids.
  const plantFolder = (name: string, titles: string[], idBase: string) => {
    const root = harnessRuntimeRoot();
    const realHome = join(homedir(), '.qwen');
    expect(
      root !== realHome && !root.startsWith(realHome + '/'),
      `the harness root ${root} sits inside the real ${realHome}, so planting transcripts there would write into a live history`,
    );
    const folder = join(root, name);
    const chatsDir = resolveChatsDir(folder);
    expect(
      chatsDir === root || chatsDir.startsWith(root + '/'),
      `the chats dir for the planted folder is ${chatsDir}, outside the harness root ${root}`,
    );
    rmSync(folder, { recursive: true, force: true });
    mkdirSync(folder, { recursive: true });
    mkdirSync(chatsDir, { recursive: true });
    const ids = titles.map((_, i) => `${idBase}-4000-8000-${String(i + 1).padStart(12, '0')}`);
    const write = (id: string, title: string) =>
      writeFileSync(
        join(chatsDir, `${id}.jsonl`),
        JSON.stringify({
          type: 'system',
          subtype: 'custom_title',
          systemPayload: { customTitle: title, titleSource: 'manual' },
        }) +
          '\n' +
          JSON.stringify({ type: 'user', message: { parts: [{ text: `the first prompt of ${title}` }] } }) +
          '\n',
      );
    titles.forEach((t, i) => write(ids[i]!, t));
    return {
      folder,
      chatsDir,
      ids,
      write,
      cleanup: () => {
        for (const id of ids) rmSync(join(chatsDir, `${id}.jsonl`), { force: true });
        rmSync(folder, { recursive: true, force: true });
      },
    };
  };
  const pointerOf = String.raw`((raw) => { try { return raw ? JSON.parse(raw).sessionId : null; } catch (e) { return 'unreadable'; } })`;

  PAGE_SCENARIOS.push({
    name: 'P148 the title opens the List screen (at 1280 the list pane’s search) and the way back returns to the same conversation, its window and shared pointers untouched, at 390 and 1280',
    waitView: false,
    frames: () => new Frames().ev('client_joined').user('p148 question').asst('p148 answer').done().list,
    run: async ({ page, viewer }) => {
      await watch(page, viewer.sessionId);
      await waitForFrame(page, 3, 30_000);
      await page.waitForFunction('transcriptModel.items.length >= 2');
      await page.waitForSelector('#composer', { state: 'visible' });
      await page.waitForFunction(`${pointerOf}(sessionStorage.getItem('qwen-rc:window-session')) === watchedSessionId`, null, { timeout: 10_000 });
      const sent: string[] = [];
      page.on('request', (r) => {
        const p = new URL(r.url()).pathname;
        if (r.method() === 'POST' && (/\/resume$/.test(p) || p === '/session')) sent.push(p);
      });
      type Reading = { id: string; win: string; shared: string; rows: number; list: boolean; shown: boolean; focus: string; expanded: string };
      const read = () =>
        page.evaluate(String.raw`(() => ({
          id: watchedSessionId,
          win: ${pointerOf}(sessionStorage.getItem('qwen-rc:window-session')),
          shared: ${pointerOf}(localStorage.getItem('qwen-rc:watched-session')),
          rows: transcriptModel.items.length,
          list: !document.getElementById('list-screen').hidden,
          shown: document.getElementById('list-screen').getClientRects().length > 0,
          focus: document.activeElement ? document.activeElement.id : '',
          expanded: document.getElementById('h1-title').getAttribute('aria-expanded'),
        }))()`) as Promise<Reading>;
      const lines: string[] = [];
      for (const [w, h] of [
        [390, 844],
        [1280, 810],
      ] as const) {
        const at = `${w}x${h}`;
        await page.setViewportSize({ width: w, height: h });
        const before = await read();
        await page.click('#h1-title');
        const opened = await read();
        // #188: in the pane layout the list is the pane beside the chat, so
        // the title puts the reader in its search and Escape (twice: the
        // search, then the list) is the way back to the title.
        const pane = w >= PANE_MIN;
        if (!pane) {
          expect(
            opened.list && opened.focus === 'list-back' && opened.expanded === 'true',
            `the title did not open the list with focus on its back at ${at} (${JSON.stringify(opened)})`,
          );
          await page.click('#list-back');
        } else {
          expect(
            opened.shown && opened.focus === 'past-filter',
            `the title did not put the reader in the list pane's search at ${at} (${JSON.stringify(opened)})`,
          );
          await page.keyboard.press('Escape');
          await page.keyboard.press('Escape');
        }
        const after = await read();
        expect(!after.list && after.focus === 'h1-title', `back did not return to the chat onto the title at ${at} (${JSON.stringify(after)})`);
        expect(
          after.id === before.id && after.win === before.win && after.shared === before.shared && after.id === viewer.sessionId,
          `going to the list and back moved the conversation or its pointers at ${at}: ${JSON.stringify(before)} -> ${JSON.stringify(after)}`,
        );
        expect(after.rows === before.rows, `the transcript lost rows on the way back at ${at} (${before.rows} -> ${after.rows})`);
        lines.push(`${at}: ${pane ? 'the pane’s search focused, Escape twice' : 'open with focus on back, back'} onto the title, same conversation, window and shared pointers on ${after.win.slice(0, 8)}, ${after.rows} rows kept`);
      }
      expect(sent.length === 0, `opening and leaving the list sent ${JSON.stringify(sent)}`);
      return lines.join('; ') + '; no resume or create sent';
    },
  });

  PAGE_SCENARIOS.push({
    name: 'P149 a tap on a row resumes that conversation in the row’s own folder, returns to the chat, and the list then marks it',
    // #193: the rows span folders, so the resume names the folder the row was
    // read from, here a recent folder that is not the current one, and the
    // blue rule follows the conversation into whichever folder it is in.
    waitView: false,
    run: async ({ page, viewer }) => {
      const here = viewer.sessionId;
      const OTHER = '33333333-4444-5555-6666-777777777777';
      const CWD = '/home/evan/p149';
      const ELSEWHERE = '/home/evan/p149-elsewhere';
      await watch(page, here);
      await waitForFrame(page, 1, 30_000);
      const resumed: Record<string, unknown>[] = [];
      await page.route(`**/session/${OTHER}/resume`, (route) => {
        resumed.push(JSON.parse(route.request().postData() || '{}') as Record<string, unknown>);
        return route.fulfill({
          status: 200,
          contentType: 'application/json',
          body: JSON.stringify({ sessionId: OTHER, lastEventId: 0 }),
        });
      });
      await page.route(
        (u) => u.pathname === '/rc/sessions' && u.searchParams.get('cwd') === ELSEWHERE && !u.searchParams.has('archiveState'),
        (route) =>
          route.fulfill({
            status: 200,
            contentType: 'application/json',
            body: JSON.stringify({ sessions: [{ sessionId: OTHER, title: 'p149 there' }], truncated: false }),
          }),
      );
      await page.evaluate(`localStorage.setItem('qwen-rc-workspaces', JSON.stringify([${JSON.stringify(ELSEWHERE)}]))`);
      await serveList(page, CWD, {
        list: [{ sessionId: here, title: 'p149 here' }],
      });
      await page.waitForFunction(`pastConvos.length === 2`);
      await page.setViewportSize({ width: 390, height: 844 });
      await openList(page);
      await page.click(`#past-list .s[data-session="${OTHER}"]`);
      await page.waitForFunction(`watchedSessionId === ${JSON.stringify(OTHER)}`, null, { timeout: 10_000 });
      await page.waitForFunction(`${pointerOf}(sessionStorage.getItem('qwen-rc:window-session')) === ${JSON.stringify(OTHER)}`, null, { timeout: 10_000 }).catch(() => undefined);
      const after = (await page.evaluate(String.raw`({
        list: !document.getElementById('list-screen').hidden,
        title: document.getElementById('h1-title-text').textContent,
        win: ${pointerOf}(sessionStorage.getItem('qwen-rc:window-session')),
        // #187 retired the tab panes and the .active class that marked the
        // one on show, so the chat is read as what is painted at the middle
        // of the transcript's box.
        chat: (() => {
          const r = document.getElementById('transcript-wrap').getBoundingClientRect();
          const e = document.elementFromPoint(r.left + r.width / 2, r.top + r.height / 2);
          return !!e && document.getElementById('pane-chat').contains(e);
        })(),
      })`)) as { list: boolean; title: string; win: string; chat: boolean };
      expect(
        resumed.length === 1 && resumed[0]!.cwd === ELSEWHERE,
        `the row asked for ${JSON.stringify(resumed)}, not one resume in its own folder ${ELSEWHERE} (the current one is ${CWD})`,
      );
      expect(!after.list && after.chat, `picking a row did not return to the chat (${JSON.stringify(after)})`);
      expect(after.title === 'p149 there', `the bar names ${JSON.stringify(after.title)}, not the conversation picked`);
      expect(after.win === OTHER, `this window's pointer is on ${JSON.stringify(after.win)}, not the conversation picked`);
      await openList(page);
      const marks = (await page.evaluate(String.raw`Array.from(document.querySelectorAll('#past-list .srow')).map((w) => ({
        id: w.dataset.session,
        on: w.classList.contains('on'),
        current: w.querySelector('.s').getAttribute('aria-current') === 'true',
        rule: getComputedStyle(w.querySelector('.s')).borderLeftColor,
      }))`)) as { id: string; on: boolean; current: boolean; rule: string }[];
      const there = marks.find((m) => m.id === OTHER);
      const left = marks.find((m) => m.id === here);
      expect(
        !!there && there.on && there.current && there.rule === 'rgb(88, 166, 255)',
        `the list does not mark the conversation picked with the blue rule (${JSON.stringify(there)})`,
      );
      expect(!!left && !left.on && !left.current, `the conversation left is still marked (${JSON.stringify(left)})`);
      await page.click('#list-back');
      return `one tap resumed ${OTHER.slice(0, 8)} with cwd ${ELSEWHERE}, its row's folder rather than the current ${CWD}; the chat came back naming it, this window's pointer followed, and the list marks it with the blue rule and not the one left`;
    },
  });

  PAGE_SCENARIOS.push({
    name: 'P150 the search button reveals a field that filters the rows of every folder shown by name, keeps what was typed for the view, and puts it all back when it is put away',
    // #193: the rows span folders, so the search is over all of them (two of
    // the three betas are in a recent folder, not the current one), and what
    // was typed is kept with the view it was typed in, '' for All folders,
    // rather than with the current folder.
    waitView: false,
    run: async ({ page }) => {
      const CWD = '/home/evan/p150';
      const OTHER_DIR = '/home/evan/p150-other';
      const rowsOf = (from: number, to: number) =>
        Array.from({ length: 30 }, (_, i) => ({
          sessionId: 'cccccccc-1500-4000-8000-' + String(i + 1).padStart(12, '0'),
          title: i < 27 ? 'alpha ' + (i + 1) : ['Beta one', 'beta two', 'BETA three'][i - 27],
        })).slice(from, to);
      await page.route(
        (u) => u.pathname === '/rc/sessions' && u.searchParams.get('cwd') === OTHER_DIR && !u.searchParams.has('archiveState'),
        (route) =>
          route.fulfill({
            status: 200,
            contentType: 'application/json',
            body: JSON.stringify({ sessions: rowsOf(28, 30), truncated: false }),
          }),
      );
      await page.evaluate(`localStorage.setItem('qwen-rc-workspaces', JSON.stringify([${JSON.stringify(OTHER_DIR)}]))`);
      await serveList(page, CWD, { list: rowsOf(0, 28) });
      await page.waitForFunction('pastConvos.length === 30');
      await page.setViewportSize({ width: 390, height: 844 });
      await openList(page);
      type Reading = { rows: string[]; dirs: string[]; pager: string; none: string; field: boolean; focus: boolean; expanded: string; saved: string | null; value: string };
      const read = () =>
        page.evaluate(String.raw`({
          rows: Array.from(document.querySelectorAll('#past-list .s .tt')).map((t) => t.textContent),
          dirs: Array.from(document.querySelectorAll('#past-list .s .dir')).map((d) => d.title),
          pager: (document.getElementById('past-pager').textContent || '').trim(),
          none: (document.querySelector('#past-list .none') || { textContent: '' }).textContent,
          field: document.getElementById('list-find').getClientRects().length > 0,
          focus: document.activeElement === document.getElementById('past-filter'),
          expanded: document.getElementById('list-search').getAttribute('aria-expanded'),
          saved: localStorage.getItem('qwen-rc:ui:rail-filter'),
          value: document.getElementById('past-filter').value,
        })`) as Promise<Reading>;
      const rest = await read();
      expect(!rest.field && rest.rows.length === 25 && /page 1 of 2/.test(rest.pager), `at rest the list is not 25 rows with a pager and no field (${JSON.stringify({ ...rest, rows: rest.rows.length })})`);
      await page.click('#list-search');
      const shown = await read();
      expect(shown.field && shown.focus && shown.expanded === 'true', `the search button did not reveal and focus the field (${JSON.stringify(shown)})`);
      await page.keyboard.type('beta');
      const beta = await read();
      expect(
        beta.rows.length === 3 && beta.rows.every((t) => /beta/i.test(t)) && beta.pager === '',
        `"beta" did not narrow the list to its three rows, case aside, on one page (${JSON.stringify(beta.rows)}, pager ${JSON.stringify(beta.pager)})`,
      );
      expect(
        beta.dirs.filter((d) => d === CWD).length === 1 && beta.dirs.filter((d) => d === OTHER_DIR).length === 2,
        `the search did not find its matches in both folders (${JSON.stringify(beta.dirs)})`,
      );
      expect(
        beta.saved === JSON.stringify({ cwd: '', text: 'beta' }),
        `what was typed is not kept with the All folders view (${beta.saved})`,
      );
      await page.fill('#past-filter', 'nothing is called this');
      const none = await read();
      expect(none.rows.length === 0 && /No conversations match "nothing is called this"/.test(none.none), `a search with no match does not say so (${JSON.stringify(none)})`);
      await page.keyboard.press('Escape');
      const away = await read();
      const focusOnButton = (await page.evaluate(`document.activeElement === document.getElementById('list-search')`)) as boolean;
      expect(
        !away.field && away.value === '' && away.rows.length === 25 && away.saved === null && focusOnButton,
        `Escape in the field did not put the search away, clear it and bring the rows back (${JSON.stringify({ ...away, rows: away.rows.length, focusOnButton })})`,
      );
      const stillOpen = (await page.evaluate(`!document.getElementById('list-screen').hidden`)) as boolean;
      expect(stillOpen, 'Escape in the search field shut the whole list rather than the search');
      await page.click('#list-back');
      return `the field is hidden at rest; the button reveals and focuses it; "beta" narrowed 30 rows in two folders to its 3 (1 in the current folder, 2 in the recent one) in any case on one page and was kept for the All folders view; no match says so; Escape cleared it, hid it and brought back 25 rows and the pager with the list still up`;
    },
  });

  PAGE_SCENARIOS.push({
    name: 'P151 Archived (n) opens the filed half of every folder the list spans as a screen of its own, and Restore puts a row back in its own folder',
    // #193: the filed half merges across the same folders as the rows (the
    // decision recorded on the issue), so it counts and lists both planted
    // folders' filed conversations, each row naming its folder, and Restore
    // names the folder of the row pressed, here the recent folder rather
    // than the current one.
    waitView: false,
    run: async ({ page }) => {
      await page.waitForFunction('curDirPath !== null && pastConvosCwd !== null');
      const plant = plantFolder('p151-folder', ['p151 still here', 'p151 filed here'], 'bbbbbbbb-1510');
      const other = plantFolder('p151-other', ['p151 put back'], 'bbbbbbbb-1511');
      const [STAYS, FILED] = plant.ids as [string, string];
      const [BACK] = other.ids as [string];
      // One filed in each folder: off its folder's chats dir, on that
      // folder's archived listing. The daemon's half of restore is played
      // here (the stub has no archive): it moves the transcript back, which
      // is what makes the row return through the page's own refresh.
      rmSync(join(plant.chatsDir, `${FILED}.jsonl`), { force: true });
      rmSync(join(other.chatsDir, `${BACK}.jsonl`), { force: true });
      const filed: Record<string, Record<string, unknown>[]> = {
        [plant.folder]: [{ sessionId: FILED, title: 'p151 filed here', updatedAt: new Date(Date.now() - 5 * 86400_000).toISOString(), archived: true }],
        [other.folder]: [{ sessionId: BACK, title: 'p151 put back', updatedAt: new Date(Date.now() - 3 * 86400_000).toISOString(), archived: true }],
      };
      const restored: Record<string, unknown>[] = [];
      try {
        await page.route(/archiveState=archived/, (route) => {
          const cwd = new URL(route.request().url()).searchParams.get('cwd') ?? '';
          return route.fulfill({
            status: 200,
            contentType: 'application/json',
            body: JSON.stringify({ sessions: filed[cwd] ?? [], truncated: false }),
          });
        });
        await page.route(/\/rc\/sessions\/unarchive$/, async (route) => {
          const body = JSON.parse(route.request().postData() || '{}') as { sessionIds?: string[] };
          restored.push(body as Record<string, unknown>);
          other.write(BACK, 'p151 put back');
          filed[other.folder] = [];
          await route.fulfill({
            status: 200,
            contentType: 'application/json',
            body: JSON.stringify({ action: 'unarchive', requested: 1, unarchived: body.sessionIds ?? [] }),
